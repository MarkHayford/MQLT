generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum ProductStatus {
  ON_SALE
  OFF_SALE
}

enum OrderStatus {
  UNPAID
  PAID
  UNRECEIVED
  UNUSED
  COMPLETED
  CANCELLED
  REFUNDED
}

enum BookingStatus {
  PENDING
  UNPAID
  BOOKED
  CANCELLED
  COMPLETED
}

model User {
  id                 String         @id @default(cuid())
  phone              String?        @unique
  openId             String?        @unique
  passwordHash       String?
  passwordPlain      String?
  nickname           String         @default("研学学员")
  avatarUrl          String?
  avatarTheme        Int            @default(0)
  gender             String?
  region             String?
  school             String?
  studyNo            String         @unique
  realName           String?
  realNameIdCard     String?
  realNameVerified   Boolean        @default(false)
  realNameVerifiedAt DateTime?
  status             UserStatus     @default(ACTIVE)
  isAdmin            Boolean        @default(false)
  adminRole          String         @default("NONE")
  adminPermissions   String[]       @default([])
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  travelers          Traveler[]
  addresses          Address[]
  invoiceTitles      InvoiceTitle[]
  invoiceRequests   InvoiceRequest[]
  bookings           StudyBooking[]
  routePointCheckIns StudyRoutePointCheckIn[]
  liveLocations      StudyLiveLocation[]
  receivedStudyPrizes StudyPrizeGrant[] @relation("StudyPrizeGrantRecipient")
  issuedStudyPrizes   StudyPrizeGrant[] @relation("StudyPrizeGrantIssuer")
  studyCertificates    StudyCertificate[]
  organizedStudyProjects StudyProjectOrganizer[]
  autoRoutePointRewardsIssued StudyRoutePointRewardIssue[] @relation("StudyRoutePointRewardIssueRecipient")
  autoRoutePointRewardsOperated StudyRoutePointRewardIssue[] @relation("StudyRoutePointRewardIssueOperator")
  cartItems          CartItem[]
  favorites          Favorite[]
  orders             Order[]
  feedbacks          Feedback[]
  managedStudyProjects StudyProjectAdmin[]
  knowledgeTaskCompletions StudyKnowledgeTaskCompletion[]
  enterpriseMemberships EnterpriseMember[]
  driverProfile        DriverProfile?
  driverJobs           DriverJob[]           @relation("DriverJobDriver")
  reviewedEnterprises  EnterpriseReview[]    @relation("EnterpriseReviewAuthor")
}


model Traveler {
  id        String   @id @default(cuid())
  userId    String
  name      String
  phone     String
  idCard    String
  isSelf    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([id, userId])
}

model Address {
  id        String   @id @default(cuid())
  userId    String
  receiver  String
  phone     String
  province  String
  city      String
  district  String
  detail    String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([id, userId])
}

model InvoiceTitle {
  id        String   @id @default(cuid())
  userId    String
  type      String
  name      String
  taxNo     String?
  email     String
  phone     String?
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([id, userId])
}

/// 电子普票开票申请（P0 人工开具）
/// 电子普票开票申请（issuer 分流 + P1 邮件占位 + P2 税控预留）
model InvoiceRequest {
  id             String               @id @default(cuid())
  userId         String
  status         String               @default("PENDING") // PENDING | ISSUED | REJECTED | CANCELLED
  titleType      String               // personal | company
  titleName      String
  taxNo          String?
  email          String
  phone          String?
  amount         Decimal              @db.Decimal(10, 2)
  pdfUrl         String?
  invoiceNo      String?
  rejectReason   String?
  adminRemark    String?
  issuedAt       DateTime?
  issuedById     String?
  /// PLATFORM=平台开具(租车) | ENTERPRISE=企业开具(文创/研学)
  issuerType     String               @default("ENTERPRISE")
  enterpriseId   String?
  enterpriseName String?              // snapshot at apply time
  emailSentAt    DateTime?
  emailStatus    String?              // skipped | pending | sent | failed
  /// P2 tax-control reserve
  taxProvider    String?              // manual | nuonuo | baiwang
  taxRemoteId    String?
  taxPayload     Json?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  items          InvoiceRequestItem[]

  @@index([userId, status])
  @@index([status, createdAt])
  @@index([issuerType, enterpriseId, status])
}


model InvoiceRequestItem {
  id         String         @id @default(cuid())
  requestId  String
  sourceType String         // MALL_ORDER | STUDY_BOOKING | RENTAL_ORDER
  sourceId   String
  sourceNo   String?
  title      String
  amount     Decimal        @db.Decimal(10, 2)
  request    InvoiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
  @@index([sourceType, sourceId])
}

model StudyProject {
  id            String         @id
  enterpriseId  String?
  title         String
  subtitle      String
  publisherDisplayName String? // platform override for 发布单位; falls back to title
  publisherAvatarUrl   String?
  category      String
  price         Decimal        @db.Decimal(10, 2)
  status        String
  liveStage     String         @default("not_started")
  liveStartedAt DateTime?
  departureStartedAt DateTime?
  studyStartedAt DateTime?
  liveEndedAt   DateTime?
  currentRoutePointId String?
  enrolled      Int            @default(0)
  maxCapacity   Int
  /// 学员端可预约：从今天(上海)起向前开放的自然日天数（含今天）。UI 预设 7/15 仅写入本字段。
  bookableDays  Int            @default(7)
  /// { "YYYY-MM-DD": { "paused": true, "capacity": 40, "note": "..." }, ... }
  dayOps        Json           @default("{}")
  tags          String[]
  gradientStart String
  gradientEnd   String
  mediaColors   String[]
  location      String?
  documents     Json           @default("[]")
  contactPhone  String?
  contactServiceTime String?
  contactWechat String?
  /// [{ id, userId?, name, phone, wechat, role, visibleToStudents, sort, capabilities? }]
  projectContacts Json @default("[]")
  openDate      String?
  startTime     DateTime?
  endTime       DateTime?
  departureMode String         @default("walk")
  departureTitle String?
  departureLatitude Decimal?   @db.Decimal(10, 6)
  departureLongitude Decimal?  @db.Decimal(10, 6)
  dropoffTitle  String?
  dropoffLatitude Decimal?     @db.Decimal(10, 6)
  dropoffLongitude Decimal?    @db.Decimal(10, 6)
  vehiclePlateNo String?
  driverName    String?
  driverPhone   String?
  /// 平台驳回说明（新建上架或修改审批）
  reviewNote    String?
  /// 企业已上架项目的待审修改稿；通过后写入正式字段
  pendingRevision Json?
  tourMall       Json           @default("{}")
  /// 分层人群点位模板 [{id,name,audience,description,zoneKey,pace,needCar,spotIds,enabled,sortOrder}]
  audienceTemplates Json        @default("[]")
  certTemplateId String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  notices       StudyNotice[]
  floatingNotices StudyFloatingNotice[]
  routePoints   StudyRoutePoint[]
  routePointCheckIns StudyRoutePointCheckIn[]
  liveLocations StudyLiveLocation[]
  bookings      StudyBooking[]
  organizers    StudyProjectOrganizer[]
  admins        StudyProjectAdmin[]
  enterprise    Enterprise?              @relation(fields: [enterpriseId], references: [id], onDelete: SetNull)
  prizeGrants   StudyPrizeGrant[]
  routePointRewardIssues StudyRoutePointRewardIssue[]
  knowledgeTaskCompletions StudyKnowledgeTaskCompletion[]
  certificates  StudyCertificate[]
  scheduleDays  StudyScheduleDay[]
  contentVersions StudyContentVersion[]
  scheduleLogs  StudyScheduleLog[]
  puzzle        PuzzleProject?
  resources     StudyProjectResource[]

  @@index([enterpriseId])
}

model StudyProjectResource {
  id           String       @id
  projectId    String
  type         String
  title        String       @default("")
  videoUrl     String?
  videoKey     String?
  gameUrl      String?
  gameKey      String?
  taskBody     String?
  questions    Json         @default("[]")
  originalName String?
  size         Int          @default(0)
  mime         String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  project      StudyProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, type, createdAt])
}

model StudyRoutePoint {
  id          String       @id @default(cuid())
  projectId   String
  title       String
  description String
  latitude    Decimal      @db.Decimal(10, 6)
  longitude   Decimal      @db.Decimal(10, 6)
  checkRadius Int          @default(120)
  checkInMode String       @default("location")
  autoGrantPrize Boolean   @default(false)
  autoPrizeProductId String?
  autoPrizeQuantity Int    @default(1)
  knowledgeEnabled Boolean @default(false)
  knowledgeVideoTitle String?
  knowledgeVideoUrl String?
  knowledgeQuestion String?
  knowledgeOptions String[] @default([])
  knowledgeAnswerIndex Int?
  knowledgeQuestions Json @default("[]")
  knowledgeItems Json @default("[]")
  knowledgeGrantPrize Boolean @default(false)
  knowledgePrizeProductId String?
  knowledgePrizeQuantity Int @default(1)
  sortOrder   Int          @default(0)
  enabled     Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  project     StudyProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  autoPrizeProduct Product? @relation("StudyRoutePointAutoPrizeProduct", fields: [autoPrizeProductId], references: [id], onDelete: SetNull)
  knowledgePrizeProduct Product? @relation("StudyRoutePointKnowledgePrizeProduct", fields: [knowledgePrizeProductId], references: [id], onDelete: SetNull)
  checkIns    StudyRoutePointCheckIn[]
  rewardIssues StudyRoutePointRewardIssue[]
  knowledgeTaskCompletions StudyKnowledgeTaskCompletion[]

  @@index([projectId, enabled, sortOrder])
  @@index([autoPrizeProductId])
  @@index([knowledgePrizeProductId])
}

model StudyRoutePointCheckIn {
  id           String          @id @default(cuid())
  bookingId    String
  userId       String
  projectId    String
  routePointId String
  latitude     Decimal?        @db.Decimal(10, 6)
  longitude    Decimal?        @db.Decimal(10, 6)
  accuracy     Decimal?        @db.Decimal(10, 2)
  checkedInAt  DateTime        @default(now())
  createdAt    DateTime        @default(now())
  booking      StudyBooking    @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  project      StudyProject    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  routePoint   StudyRoutePoint @relation(fields: [routePointId], references: [id], onDelete: Cascade)

  @@unique([bookingId, routePointId])
  @@index([projectId, userId])
  @@index([routePointId])
}

model StudyRoutePointRewardIssue {
  id           String          @id @default(cuid())
  bookingId    String
  userId       String
  projectId    String
  routePointId String
  rewardType   String
  productId    String?
  prizeGrantId String? @unique
  amount       Int            @default(0)
  quantity     Int            @default(0)
  operatorUserId String?
  createdAt    DateTime       @default(now())
  user         User            @relation("StudyRoutePointRewardIssueRecipient", fields: [userId], references: [id], onDelete: Cascade)
  operator     User?           @relation("StudyRoutePointRewardIssueOperator", fields: [operatorUserId], references: [id], onDelete: SetNull)
  project      StudyProject    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  booking      StudyBooking    @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  routePoint   StudyRoutePoint @relation(fields: [routePointId], references: [id], onDelete: Cascade)
  product      Product?        @relation("StudyRoutePointRewardIssueProduct", fields: [productId], references: [id], onDelete: SetNull)
  prizeGrant   StudyPrizeGrant? @relation(fields: [prizeGrantId], references: [id], onDelete: SetNull)

  @@unique([bookingId, routePointId, rewardType])
  @@index([projectId, userId])
  @@index([routePointId])
  @@index([productId])
  @@index([prizeGrantId])
  @@index([operatorUserId])
}

model StudyProjectOrganizer {
  id        String       @id @default(cuid())
  projectId String
  userId    String
  createdAt DateTime     @default(now())
  project   StudyProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
}

model StudyProjectAdmin {
  id        String       @id @default(cuid())
  projectId String
  userId    String
  createdAt DateTime     @default(now())
  project   StudyProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
}

model StudyNotice {
  id           String        @id @default(cuid())
  projectId    String?
  enterpriseId String?
  title        String
  content      String
  type         String
  category     String?       // platform-unified; set by ops on approve (aligned with CommunityPost.category)
  publisher    String?       // locked snapshot of 发布单位 display name
  publisherUnitType String?  // enterprise | project
  publisherUnitId   String?
  paragraphs   String[]
  status       String        @default("pending") // pending | published | rejected
  reviewNote   String?
  reviewedAt   DateTime?
  publishedAt  DateTime      @default(now())
  kind         String        @default("news") // news (enterprise 资讯) | dynamics (project 动态)
  project      StudyProject? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([enterpriseId])
  @@index([projectId])
  @@index([status, publishedAt])
  @@index([kind])
}

model StudyFloatingNotice {
  id            String        @id @default(cuid())
  projectId     String?
  title         String
  subtitle      String
  showSubtitle  Boolean       @default(true)
  tag           String        @default("研学进行中")
  content       String?
  imageUrl      String?
  actionText    String        @default("进入研学详情")
  actionType    String        @default("project")
  actionTarget  String?
  gradientStart String?
  gradientEnd   String?
  titleFontSize Int?
  titleColor    String?
  contentFontSize Int?
  contentColor  String?
  sortOrder     Int           @default(0)
  enabled       Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  project       StudyProject? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([enabled, sortOrder])
}

model StudyBooking {
  id         String        @id @default(cuid())
  userId     String
  projectId  String
  bookingGroupId String?
  bookerId   String?
  participantName String?
  participantPhone String?
  participantIdCard String?
  participantRole String   @default("BOOKER")
  participantIndex Int      @default(0)
  status     BookingStatus @default(BOOKED)
  amount     Decimal       @db.Decimal(10, 2)
  paidAt     DateTime?
  cancelledAt DateTime?
  completedAt DateTime?
  participantVerifiedAt DateTime?
  participantVerifyMessage String?
  checkedInAt DateTime?
  checkedInById String?
  userDeletedAt DateTime?
  /// 自由探索：用户预约行程与租车（JSON）
  tripPlan   Json          @default("{}")
  rentalOptionId String?
  rentalDriverId String?
  rentalFee  Decimal?      @db.Decimal(10, 2)
  rentalDriverName String?
  rentalDriverPhone String?
  rentalDriverWechat String?
  rentalVehicleName String?
  rentalPlateNo String?
  pickupAddress String?
  pickupLatitude Decimal?  @db.Decimal(10, 6)
  pickupLongitude Decimal? @db.Decimal(10, 6)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  project    StudyProject  @relation(fields: [projectId], references: [id])
  routePointCheckIns StudyRoutePointCheckIn[]
  liveLocations StudyLiveLocation[]
  prizeGrants StudyPrizeGrant[]
  routePointRewardIssues StudyRoutePointRewardIssue[]
  knowledgeTaskCompletions StudyKnowledgeTaskCompletion[]
  certificate StudyCertificate?

  @@index([bookingGroupId])
  @@index([bookerId])
}


model StudyCertificateTemplate {
  id          String   @id
  projectId   String
  name        String   @default("")
  title       String   @default("结业证书")
  bodyHtml    String   @default("")
  bgUrl       String?
  sealUrl     String?
  fieldsJson  Json     @default("[]")
  enabled     Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([projectId, sortOrder])
}

model StudyCertificate {
  id            String       @id @default(cuid())
  certificateNo String      @unique
  projectId     String
  bookingId     String      @unique
  userId        String
  holderName    String
  projectTitle  String
  summary       String
  templateId    String?
  bodyHtml      String?
  bgUrl         String?
  sealUrl       String?
  issuedAt      DateTime    @default(now())
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  project       StudyProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  booking       StudyBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([projectId, userId])
  @@index([userId, issuedAt])
}

model StudyKnowledgeTaskCompletion {
  id            String          @id @default(cuid())
  bookingId     String
  userId        String
  projectId     String
  routePointId  String
  answerIndex   Int
  answerIndexes Int[]           @default([])
  prizeGrantId  String?         @unique
  completedAt   DateTime        @default(now())
  createdAt     DateTime        @default(now())
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  project       StudyProject    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  booking       StudyBooking    @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  routePoint    StudyRoutePoint @relation(fields: [routePointId], references: [id], onDelete: Cascade)
  prizeGrant    StudyPrizeGrant? @relation(fields: [prizeGrantId], references: [id], onDelete: SetNull)

  @@unique([bookingId, routePointId])
  @@index([projectId, userId])
  @@index([routePointId])
  @@index([prizeGrantId])
}

model StudyLiveLocation {
  id        String       @id @default(cuid())
  projectId String
  userId    String
  bookingId String?
  latitude  Decimal      @db.Decimal(10, 6)
  longitude Decimal      @db.Decimal(10, 6)
  accuracy  Decimal?     @db.Decimal(10, 2)
  speed     Decimal?     @db.Decimal(10, 2)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  project   StudyProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  booking   StudyBooking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@unique([projectId, userId])
  @@index([projectId, updatedAt])
  @@index([bookingId])
}

model PuzzleProject {
  id          String        @id @default(cuid())
  projectId   String        @unique
  title       String
  subtitle    String
  gridCols    Int
  gridRows    Int
  sourceImageUrl String?
  sourceImageKey String?
  pieces      PuzzlePiece[]
  project     StudyProject  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model PuzzlePiece {
  id              String        @id @default(cuid())
  puzzleProjectId String
  pieceNo         Int
  name            String
  icon            String
  puzzleProject   PuzzleProject @relation(fields: [puzzleProjectId], references: [id], onDelete: Cascade)
}

model Product {
  id          String        @id
  sku         String        @unique
  name        String
  intro       String        @default("")
  description String        @default("")
  gallery     Json          @default("[]")
  detailBlocks Json         @default("[]")
  specs       Json          @default("[]")
  services    Json          @default("[]")
  category    String
  price       Decimal       @db.Decimal(10, 2)
  icon              String?
  imageUrl          String?
  imgStyle          String?
  status            ProductStatus @default(ON_SALE)
  stock             Int           @default(0)
  sales             Int           @default(0)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  comments          ProductComment[]
  cartItems         CartItem[]
  favorites         Favorite[]
  orderItems        OrderItem[]
  studyPrizeGrants  StudyPrizeGrant[]
  routePointAutoPrizes StudyRoutePoint[] @relation("StudyRoutePointAutoPrizeProduct")
  routePointKnowledgePrizes StudyRoutePoint[] @relation("StudyRoutePointKnowledgePrizeProduct")
  routePointRewardIssues StudyRoutePointRewardIssue[] @relation("StudyRoutePointRewardIssueProduct")
}

model StudyPrizeGrant {
  id          String       @id @default(cuid())
  projectId   String
  bookingId   String
  userId      String
  productId   String
  grantedById String
  quantity    Int          @default(1)
  note        String?
  grantedAt   DateTime     @default(now())
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  project     StudyProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  booking     StudyBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  user        User         @relation("StudyPrizeGrantRecipient", fields: [userId], references: [id], onDelete: Cascade)
  product     Product      @relation(fields: [productId], references: [id])
  grantedBy   User         @relation("StudyPrizeGrantIssuer", fields: [grantedById], references: [id], onDelete: Cascade)
  routePointRewardIssue StudyRoutePointRewardIssue?
  knowledgeTaskCompletion StudyKnowledgeTaskCompletion?

  @@index([projectId, userId])
  @@index([bookingId])
  @@index([productId])
  @@index([grantedById])
}

model CartItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  quantity  Int      @default(1)
  selected  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id])

  @@unique([userId, productId])
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id])

  @@unique([userId, productId])
}

model Order {
  id            String      @id @default(cuid())
  orderNo       String      @unique
  userId        String
  status        OrderStatus @default(UNPAID)
  amount        Decimal     @db.Decimal(10, 2)
  goodsAmount   Decimal?    @db.Decimal(10, 2)
  addressId     String?
  receiver      String?
  receiverPhone String?
  province      String?
  city            String?
  district        String?
  addressDetail   String?
  remark          String?
  adminRemark     String?
  shippingCompany String?
  trackingNo       String?
  shippedAt        DateTime?
  paidAt           DateTime?
  completedAt      DateTime?
  cancelledAt      DateTime?
  userDeletedAt    DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  items            OrderItem[]
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String
  quantity  Int
  price     Decimal @db.Decimal(10, 2)
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])
}

model Feedback {
  id           String   @id @default(cuid())
  userId       String?
  type         String
  content      String
  tags         String[]
  contactPhone String?
  contactEmail String?
  status       String   @default("submitted")
  reply        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}


// ========== 商管：入驻企业 / 雇佣司机 / 平台管理 ==========

model Enterprise {
  id              String   @id @default(cuid())
  name            String
  shortName       String?
  publisherDisplayName String? // platform override for 发布单位; falls back to shortName/name
  publisherAvatarUrl   String?
  licenseNo       String?
  contactName     String?
  contactPhone    String?
  contactWechat   String?
  address         String?
  latitude        Decimal? @db.Decimal(10, 6)
  longitude       Decimal? @db.Decimal(10, 6)
  logoUrl         String?
  intro           String?
  status          String   @default("ACTIVE") // ACTIVE | PENDING | SUSPENDED
  revenueTotal    Decimal  @default(0) @db.Decimal(12, 2)
  ratingAvg       Decimal  @default(5) @db.Decimal(3, 2)
  ratingCount     Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  members         EnterpriseMember[]
  projects        StudyProject[]
  activities      EnterpriseActivity[]
  reviews         EnterpriseReview[]
  drivers         DriverProfile[]
  jobs            DriverJob[]

  @@index([status])
  @@index([name])
}

model EnterpriseMember {
  id           String   @id @default(cuid())
  enterpriseId String
  userId       String
  role         String   @default("OWNER") // OWNER | MANAGER | STAFF
  title        String?
  status       String   @default("ACTIVE")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  enterprise   Enterprise @relation(fields: [enterpriseId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([enterpriseId, userId])
  @@index([userId])
  @@index([status])
}

/// 趣味活动 / 开放区域运营配置（企业侧）
model EnterpriseActivity {
  id            String   @id @default(cuid())
  enterpriseId  String
  projectId     String?
  zoneId        String?
  title         String
  summary       String   @default("")
  body          String   @default("")
  activityType  String   @default("FUN") // FUN | OPEN_HOURS | NOTICE
  enabled       Boolean  @default(true)
  openWeekdays  String   @default("1,2,3,4,5,6,7")
  openTimeStart String   @default("09:00")
  openTimeEnd   String   @default("17:00")
  capacity      Int      @default(0)
  sortOrder     Int      @default(0)
  coverIcon     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  enterprise    Enterprise @relation(fields: [enterpriseId], references: [id], onDelete: Cascade)

  @@index([enterpriseId, enabled, sortOrder])
  @@index([projectId])
  @@index([zoneId])
}

model EnterpriseReview {
  id           String   @id @default(cuid())
  enterpriseId String
  userId       String?
  projectId    String?
  bookingId    String?
  rating       Int      @default(5)
  content      String   @default("")
  tags         String[] @default([])
  authorName   String   @default("匿名学员")
  reply        String?
  repliedAt    DateTime?
  status       String   @default("PUBLISHED") // PUBLISHED | HIDDEN
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  enterprise   Enterprise @relation(fields: [enterpriseId], references: [id], onDelete: Cascade)
  user         User?      @relation("EnterpriseReviewAuthor", fields: [userId], references: [id], onDelete: SetNull)

  @@index([enterpriseId, status, createdAt])
  @@index([userId])
  @@index([projectId])
}

model DriverProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  enterpriseId    String?
  realName        String
  phone           String
  wechat          String?
  idCardMasked    String?
  vehicleType     String   @default("van7") // van7|mpv9|bus14|bus20
  vehicleName     String   @default("7座商务")
  plateNo         String
  seatCount       Int      @default(7)
  basePrice       Decimal  @default(0) @db.Decimal(10, 2)
  city            String   @default("")
  status          String   @default("OFFLINE") // OFFLINE | ONLINE | BUSY | LEAVE
  acceptOrders    Boolean  @default(true)
  ratingAvg       Decimal  @default(5) @db.Decimal(3, 2)
  ratingCount     Int      @default(0)
  completedJobs   Int      @default(0)
  todayIncome     Decimal  @default(0) @db.Decimal(10, 2)
  totalIncome     Decimal  @default(0) @db.Decimal(12, 2)
  availableBalance Decimal @default(0) @db.Decimal(12, 2)
  pendingAmount    Decimal @default(0) @db.Decimal(12, 2)
  withdrawnAmount  Decimal @default(0) @db.Decimal(12, 2)
  baseLatitude    Decimal? @db.Decimal(10, 6)
  baseLongitude   Decimal? @db.Decimal(10, 6)
  lastLatitude    Decimal? @db.Decimal(10, 6)
  lastLongitude   Decimal? @db.Decimal(10, 6)
  lastOnlineAt    DateTime?
  licenseNo       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  enterprise      Enterprise?  @relation(fields: [enterpriseId], references: [id], onDelete: SetNull)
  jobs            DriverJob[]

  @@index([status, acceptOrders])
  @@index([vehicleType, status])
  @@index([enterpriseId])
  @@index([phone])
  @@index([city, status])
}

model DriverJob {
  id               String   @id @default(cuid())
  jobNo            String   @unique
  driverId         String?
  driverUserId     String?
  enterpriseId     String?
  projectId        String?
  bookingId        String?
  bookerUserId     String?
  vehicleType      String   @default("van7")
  status           String   @default("OPEN") // OPEN | OFFERED | ACCEPTED | EN_ROUTE | ARRIVED | IN_TRIP | COMPLETED | CANCELLED
  price            Decimal  @default(0) @db.Decimal(10, 2)
  passengerCount   Int      @default(1)
  passengerName    String?
  passengerPhone   String?
  pickupAddress    String?
  pickupLatitude   Decimal? @db.Decimal(10, 6)
  pickupLongitude  Decimal? @db.Decimal(10, 6)
  dropoffAddress   String?
  dropoffLatitude  Decimal? @db.Decimal(10, 6)
  dropoffLongitude Decimal? @db.Decimal(10, 6)
  note             String?
  offeredAt        DateTime?
  acceptedAt       DateTime?
  startedAt        DateTime?
  completedAt      DateTime?
  cancelledAt      DateTime?
  cancelReason     String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  driver           DriverProfile? @relation(fields: [driverId], references: [id], onDelete: SetNull)
  driverUser       User?          @relation("DriverJobDriver", fields: [driverUserId], references: [id], onDelete: SetNull)
  enterprise       Enterprise?    @relation(fields: [enterpriseId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([driverId, status])
  @@index([driverUserId, status])
  @@index([enterpriseId])
  @@index([bookingId])
  @@index([projectId])
}


model RentalOrder {
  id               String    @id @default(cuid())
  orderNo          String    @unique
  userId           String
  projectId        String
  bookingId        String?
  travelDate       DateTime?
  dateFrom         DateTime?
  dateTo           DateTime?
  passengerCount   Int       @default(1)
  vehicleRange     String?
  pickupAddress    String?
  pickupLatitude   Decimal?  @db.Decimal(10, 6)
  pickupLongitude  Decimal?  @db.Decimal(10, 6)
  remark           String?
  status           String    @default("OPEN") // OPEN | NEGOTIATING | PRICE_CONFIRMED | PAID | EN_ROUTE | ARRIVED | IN_TRIP | COMPLETED | CANCELLED
  driverId         String?
  driverUserId     String?
  claimedAt        DateTime?
  refPrice         Decimal?  @db.Decimal(10, 2)
  offeredPrice     Decimal?  @db.Decimal(10, 2)
  agreedPrice      Decimal?  @db.Decimal(10, 2)
  priceConfirmedAt DateTime?
  paidAt           DateTime?
  startedAt        DateTime?
  completedAt      DateTime?
  walletCreditedAt DateTime? // Phase C: idempotent driver wallet credit on COMPLETED
  cancelledAt      DateTime?
  cancelReason     String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@index([driverId, status])
  @@index([projectId])
}


model RentalChatMessage {
  id         String   @id @default(cuid())
  orderId    String
  senderType String   // user | driver | system
  senderId   String?
  content    String
  createdAt  DateTime @default(now())

  @@index([orderId, createdAt])
}

model DriverWithdraw {
  id           String   @id @default(cuid())
  driverId     String
  userId       String?
  amount       Decimal  @db.Decimal(10, 2)
  status       String   @default("PENDING") // PENDING | APPROVED | PAID | REJECTED | CANCELLED
  channel      String   @default("WECHAT")
  accountName  String   @default("")
  bankName     String   @default("")
  bankAccount  String   @default("")
  remark       String   @default("")
  reviewNote   String   @default("")
  reviewedAt   DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([driverId, status])
  @@index([status, createdAt])
  @@index([userId])
}

/// 小程序平台配置（管理人员）
model PlatformSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json     @default("{}")
  label     String   @default("")
  groupName String   @default("general")
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([groupName])
}


model ProductComment {
  id        String   @id
  productId String
  userId    String?
  parentId  String?
  content   String
  rating    Int?
  official  Boolean  @default(false)
  status    String   @default("VISIBLE")
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  parent    ProductComment?  @relation("ProductCommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   ProductComment[] @relation("ProductCommentReplies")
  @@index([productId, createdAt])
  @@index([parentId])
  @@index([productId, rating])
}

model AdminOperationLog {
  id           String   @id
  actorId      String?
  actorName    String   @default("")
  actorPhone   String   @default("")
  module       String
  action       String
  targetType   String
  targetId     String
  targetLabel  String   @default("")
  summary      String
  detail       Json     @default("{}")
  ip           String?
  enterpriseId String?
  projectId    String?
  createdAt    DateTime @default(now())

  @@index([module, createdAt])
  @@index([targetType, targetId, createdAt])
  @@index([actorId, createdAt])
  @@index([enterpriseId, createdAt])
  @@index([projectId, createdAt])
  @@index([createdAt])
}

model StudyContentVersion {
  id           String   @id
  projectId    String
  routePointId String?
  name         String
  note         String   @default("")
  stepsJson    Json     @default("[]")
  resourceIds  Json     @default("[]")
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  project      StudyProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  @@index([projectId])
  @@index([routePointId])
}
model StudyScheduleDay {
  id        String   @id
  projectId String
  date      DateTime @db.Date
  open      Boolean  @default(true)
  capacity  Int?
  note      String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  project   StudyProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  spots     StudyScheduleSpot[]
  @@unique([projectId, date])
  @@index([projectId, date])
}
model StudyScheduleSpot {
  id               String   @id
  dayId            String
  routePointId     String
  enabled          Boolean  @default(true)
  contentVersionId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  day              StudyScheduleDay @relation(fields: [dayId], references: [id], onDelete: Cascade)
  @@unique([dayId, routePointId])
  @@index([dayId])
  @@index([contentVersionId])
}
model StudyScheduleLog {
  id        String   @id
  projectId String
  actorId   String?
  actorName String   @default("")
  action    String
  payload   Json     @default("{}")
  createdAt DateTime @default(now())
  project   StudyProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  @@index([projectId, createdAt])
}

