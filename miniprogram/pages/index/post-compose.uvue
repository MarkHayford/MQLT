	}
	.tool-scroll {
		width: 100%;
		height: 48px;
		flex-shrink: 0;
	}
	.tool-row {
		padding: 8px 12px;
		align-items: center;
		height: 48px;
	}
	.tool {
		width: 32px;
		height: 32px;
		border-radius: 10px;
		margin-right: 6px;
		align-items: center;
		justify-content: center;
		flex-shrink: 0;
		background-color: transparent;
	}
	.tool-wide {
		width: auto;
		padding: 0 8px;
	}
	.tool-on { background-color: #1A73E8; }
	.tool-b {
		font-size: 16px;
		font-weight: 800;
		color: #1A1A1A;
	}
	.tool-i {
		font-size: 16px;
		font-weight: 600;
		font-style: italic;
		color: #1A1A1A;
	}
	.tool-u {
		font-size: 16px;
		font-weight: 700;
		color: #1A1A1A;
		text-decoration: underline;
	}
	.tool-mark {
		font-size: 12px;
		font-weight: 800;
		color: #5C5346;
	}
	.tool-mark-on { color: #1A1A1A; }
	.tool-tint {
		width: 14px;
		height: 14px;
		border-radius: 7px;
		border-width: 1px;
		border-style: solid;
		border-color: #E5E7EB;
	}
	.tool-tint-ink { background-color: #1A73E8; }
	.tool-tint-paper { background-color: #FFFFFF; }
	.tool-split {
		width: 1px;
		height: 14px;
		background-color: #E5E7EB;
		margin: 0 6px 0 2px;
		flex-shrink: 0;
	}
	.panel {
		padding: 4px 14px 12px 14px;
		flex-wrap: wrap;
		align-items: center;
		flex-shrink: 0;
	}
	.size-chip {
		height: 30px;
		padding: 0 12px;
		border-radius: 8px;
		margin-right: 8px;
		margin-bottom: 4px;
		background-color: #F5F7FB;
		align-items: center;
		justify-content: center;
	}
	.size-chip-on { background-color: #1A73E8; }
	.size-chip-txt { font-weight: 700; color: #374151; }
	.size-chip-txt-on { color: #FFFFFF; }
	.swatch {
		width: 28px;
		height: 28px;
		border-radius: 14px;
