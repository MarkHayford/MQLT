<template>
	<view class="page uni-column">
		<view class="status-bar" :style="{ height: statusBarHeight + 'px' }"></view>
		<view class="nav uni-row">
			<view class="nav-back uni-row" @click="goBack">
				<image src="/static/auth-back.svg" class="nav-back-icon" mode="aspectFit"></image>
				<text class="nav-back-text">返回</text>
			</view>
			<text class="nav-title">动态详情</text>
			<view class="nav-space"></view>
		</view>

		<scroll-view class="body" scroll-y="true" :show-scrollbar="false">
			<view v-if="notice != null" class="sheet uni-column">
				<view class="gold-edge"></view>
				<text class="kicker">BULLETIN</text>
				<view class="meta uni-row">
					<view class="type-tag" :style="'background-color:' + tagColor">
						<text class="type-tag-txt">{{ notice.type }}</text>
					</view>
					<text class="time">{{ notice.time }}</text>
				</view>
				<text class="title">{{ notice.title }}</text>
				<view class="rule"></view>
				<view v-if="coverIsTpl" class="cover-hero">
					<note-text-cover :tpl="coverTplId" :title="notice.title" :hl="coverTplHl" size="hero"></note-text-cover>
				</view>
				<image v-for="(img, ii) in coverImages" :key="'nc-'+ii" :src="img" class="content-img" mode="widthFix"></image>
				<view v-if="contentIsHtml">
					<rich-text class="rich" :nodes="displayHtml"></rich-text>
				</view>
				<text v-else v-for="(para, pIdx) in plainParagraphs" :key="'p-'+pIdx" class="para">{{ para }}</text>
				<view v-for="(clip, vi) in playVideos" :key="'nv-'+vi" class="video-wrap">
					<video class="play-video" :src="clip.url" :poster="clip.thumb" controls object-fit="contain"></video>
				</view>
				<view v-for="(lk, li) in pageLinks" :key="'nl-'+li" class="link-card" @click="openLink(lk.url)">
					<text class="link-kicker">{{ lk.title }}</text>
					<text class="link-url">{{ lk.url }}</text>
					<text class="link-action">复制链接，去微信打开</text>
				</view>
			</view>

			<view
				v-if="notice != null && notice.projectId.length > 0"
				class="project-card uni-row"
				@click="goProject(notice.projectId)"
			>
				<view class="project-copy uni-column">
					<text class="project-kicker">STUDY PASS</text>
					<text class="project-label">关联研学项目</text>
					<text class="project-title">{{ notice.projectTitle }}</text>
				</view>
				<view class="project-go">
					<text class="project-go-txt">查看</text>
				</view>
			</view>

			<view v-if="notice != null" class="pub uni-row">
				<text class="pub-label">发布单位</text>
				<text class="pub-value">{{ notice.publisher }}</text>
			</view>

			<view v-if="notice == null" class="empty uni-column">
				<text class="empty-title">动态不存在或已下架</text>
			</view>
			<view class="safe"></view>
		</scroll-view>
	</view>
</template>

<script setup lang="uts">
	import { ref, computed } from 'vue'
	import { onLoad } from '@dcloudio/uni-app'
	import { getStatusBarHeight } from '../../utils/system-layout.uts'
	import { fetchStudyNoticeDetail, getNoticeTagColor, type StudyNoticeDetail } from './utils/study-notices.uts'
	import { coverTplHlOf, coverTplIdOf, isHttpCoverUrl } from '../../utils/community.uts'
	import { guessLinkTitle, isHtmlContent, parseBodyCover, parseBodyLinks, parseBodyVideos, stripBodyExtras, stripHtml, type BodyLink, type BodyVideo } from '../../utils/html-content.uts'

	const statusBarHeight = getStatusBarHeight()
	const notice = ref<StudyNoticeDetail | null>(null)

	const tagColor = computed((): string => {
		const n = notice.value
		if (n == null) return '#1A1A1A'
		return getNoticeTagColor(n.type)
	})

	const rawContent = computed((): string => {
		const n = notice.value
		if (n == null) return ''
		return n.content
	})

	const coverRaw = computed((): string => {
		return parseBodyCover(rawContent.value)
	})

	const coverIsTpl = computed((): boolean => {
		const c = coverRaw.value
		if (c.length === 0) return false
		return !isHttpCoverUrl(c)
	})

	const coverTplId = computed((): string => {
		return coverTplIdOf(coverRaw.value)
	})

	const coverTplHl = computed((): string => {
		return coverTplHlOf(coverRaw.value)
	})

	const coverImages = computed((): string[] => {
		const c = coverRaw.value
		if (c.length === 0 || !isHttpCoverUrl(c)) return []
		return [c]
	})

	const contentIsHtml = computed((): boolean => {
		return isHtmlContent(stripBodyExtras(rawContent.value))
	})

	const displayHtml = computed((): string => {
		return stripBodyExtras(rawContent.value)
	})

	const plainParagraphs = computed((): string[] => {
		const n = notice.value
		if (n == null) return []
		const out: string[] = []
		for (let i = 0; i < n.paragraphs.length; i++) {
			const p = stripHtml(n.paragraphs[i])
			if (p.length > 0 && p.indexOf('[[') < 0) out.push(p)
		}
		return out
	})

	const playVideos = computed((): BodyVideo[] => {
		return parseBodyVideos(rawContent.value)
	})

	const pageLinks = computed((): BodyLink[] => {
		return parseBodyLinks(rawContent.value)
	})

	const openLink = (url: string) => {
		uni.setClipboardData({
			data: url,
			success: () => {
				uni.showToast({ title: '链接已复制', icon: 'none' })
			}
		})
	}

	onLoad((options: OnLoadOptions) => {
		const idParam = options['id']
		const id = idParam != null ? idParam.toString() : ''
		if (id.length === 0) return
		fetchStudyNoticeDetail(id).then((detail) => {
			notice.value = detail
		}).catch((_err) => {
			notice.value = null
			uni.showToast({ title: '动态详情加载失败', icon: 'none' })
		})
	})

	const goBack = () => {
		uni.navigateBack()
	}

	const goProject = (projectId: string) => {
		uni.navigateTo({ url: '/pages/appointment/project-detail?id=' + projectId })
	}
</script>

<style>
	.page { border-width: 0; border-color: #FFFFFF; flex: 1; background-color: #F5F7FB; }
	.status-bar { border-width: 0; border-color: #FFFFFF; width: 100%; background-color: #FFFFFF; }
	.nav {
		border-width: 0;
		border-color: #FFFFFF;
		height: 44px;
		align-items: center;
		padding: 0 12px;
		background-color: #FFFFFF;
	}
	.nav-back { align-items: center; width: 88px; }
	.nav-back-icon { width: 18px; height: 18px; }
	.nav-back-text { font-size: 15px; color: #1A1A1A; margin-left: 2px; }
	.nav-title { flex: 1; text-align: center; font-size: 16px; font-weight: 800; color: #1A1A1A; }
	.nav-space { width: 88px; }
	.body { flex: 1; width: 100%; }
	.sheet {
		margin: 14px 16px 0 16px;
		padding: 18px 16px 16px 16px;
		border-radius: 16px;
		background-color: #FFFFFF;
		overflow: hidden;
		position: relative;
	}
	.gold-edge {
		border-width: 0;
		border-color: #FFFFFF;
		position: absolute;
		left: 0; right: 0; top: 0;
		height: 3px;
		background-color: #1A73E8;
	}
	.kicker {
		font-size: 10px;
		font-weight: 800;
		color: #1A73E8;
		letter-spacing: 1.4px;
		margin-bottom: 10px;
	}
	.meta { align-items: center; margin-bottom: 12px; }
	.type-tag { padding: 3px 8px; border-radius: 6px; }
	.type-tag-txt { font-size: 11px; font-weight: 800; color: #FFFFFF; }
	.time { flex: 1; text-align: right; font-size: 12px; color: #374151; }
	.title {
		font-size: 22px;
		font-weight: 800;
		color: #1A1A1A;
		line-height: 30px;
		margin-bottom: 12px;
	}
	.rule { height: 1px; background-color: #E5E7EB; margin-bottom: 14px; }
	.cover-hero { width: 100%; margin-bottom: 12px; }
	.content-img { width: 100%; margin-bottom: 10px;
		min-height: 1px;
	}
	.rich { font-size: 15px; color: #374151; line-height: 26px; }
	.video-wrap { width: 100%; margin: 10px 0; }
	.play-video { width: 100%; height: 200px; background-color: #1A73E8; }
	.link-card {
		margin: 10px 0;
		padding: 12px 14px;
		border-radius: 12px;
		background-color: #FFFFFF;
	}
	.link-kicker { font-size: 13px; font-weight: 800; color: #1A1A1A; }
	.link-url { font-size: 12px; color: #374151; margin-top: 4px; }
	.link-action { font-size: 11px; color: #1A73E8; margin-top: 6px; }
	.para {
		font-size: 15px;
		color: #374151;
		line-height: 26px;
		margin-bottom: 12px;
	}
	.project-card {
		margin: 12px 16px 0 16px;
		padding: 14px;
		border-radius: 16px;
		background-color: #1A73E8;
		align-items: center;
	}
	.project-copy { flex: 1; min-width: 0; }
	.project-kicker {
		font-size: 9px;
		font-weight: 800;
		color: #1A73E8;
		letter-spacing: 1.2px;
		margin-bottom: 4px;
	}
	.project-label { font-size: 12px; color: rgba(255,248,238,0.7); margin-bottom: 4px; }
	.project-title {
		font-size: 15px;
		font-weight: 800;
		color: #FFFFFF;
		lines: 2;
	}
	.project-go {
		height: 28px;
		padding: 0 12px;
		border-radius: 14px;
		background-color: #1A73E8;
		align-items: center;
		justify-content: center;
		margin-left: 10px;
		flex-shrink: 0;
	}
	.project-go-txt { font-size: 12px; font-weight: 800; color: #FFFFFF; }
	.pub {
		margin: 12px 16px 0 16px;
		padding: 12px 14px;
		border-radius: 12px;
		background-color: #FFFFFF;
		align-items: center;
		justify-content: space-between;
	}
	.pub-label { font-size: 13px; color: #374151; }
	.pub-value { font-size: 13px; font-weight: 700; color: #1A1A1A; flex: 1; text-align: right; margin-left: 12px; }
	.empty { padding-top: 80px; align-items: center; }
	.empty-title { font-size: 15px; color: #374151; }
	.safe { height: 32px; }
</style>
