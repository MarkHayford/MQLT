<template>
	<view class="page-wrapper uni-column">
		<!-- 1. 顶部固定区域 -->
		<view class="fixed-header">
			<view class="status-bar" :style="{ height: statusBarHeight + 'px' }"></view>
			<view class="nav-bar">
				<view class="nav-back" @click="goBack">
					<image src="/static/auth-back.svg" class="nav-back-icon" mode="aspectFit"></image>
					<text class="nav-back-text">返回</text>
				</view>
				<text class="nav-title">{{ pageTitle }}</text>
			</view>

			<!-- 搜索框 -->
			<view class="search-area">
				<view class="search-wrap uni-row">
					<image src="/static/func-search.svg" class="s-icon" mode="aspectFit"></image>
					<input class="s-input" type="text" placeholder="搜索动态标题或内容..." placeholder-style="color:#6B7280;" v-model="searchKeyword" />
				</view>
			</view>

			<!-- 筛选与排序栏 -->
			<view class="filter-sort-bar uni-row">
				<scroll-view class="type-scroll" scroll-x="true" :show-scrollbar="false">
					<view class="type-list uni-row">
						<view
							v-for="(type, index) in noticeTypes"
							:key="index"
							:class="['type-pill', activeType === index ? 'type-active' : '']"
							@click="activeType = index"
						>
							<text :class="['type-txt', activeType === index ? 'type-txt-active' : '']">{{ type }}</text>
						</view>
						<view style="width: 20px; flex-shrink: 0;"></view>
					</view>
				</scroll-view>
			</view>
			<view class="sort-bar uni-row">
				<view :class="['sort-cell', sortOrder === 'desc' ? 'sort-cell-on' : '']" @click="setSort('desc')">
					<text :class="['sort-cell-txt', sortOrder === 'desc' ? 'sort-cell-txt-on' : '']">最新优先</text>
				</view>
				<view :class="['sort-cell', 'sort-cell-last', sortOrder === 'asc' ? 'sort-cell-on' : '']" @click="setSort('asc')">
					<text :class="['sort-cell-txt', sortOrder === 'asc' ? 'sort-cell-txt-on' : '']">最早优先</text>
				</view>
			</view>
		</view>

		<!-- 2. 动态列表 -->
		<scroll-view class="main-list" :style="listStyle" scroll-y="true" :show-scrollbar="false" :bounces="true">
			<view class="list-padding">
				<view v-for="(item, index) in filteredNotices" :key="item.id" class="notice-card" @click="goDetail(item.id)">
					<view class="notice-card-header uni-row">
						<view class="type-tag" :style="{ backgroundColor: getNoticeTagColor(item.type) }">
							<text class="type-tag-txt">{{ item.type }}</text>
						</view>
						<text class="notice-time">{{ item.time }}</text>
					</view>
					<text class="notice-title">{{ item.title }}</text>
					<text class="notice-brief">{{ noticeBrief(item.content) }}</text>
					<view
						v-if="item.projectId.length > 0"
						class="notice-project-row uni-row"
						@click.stop="goProject(item.projectId)"
					>
						<text class="notice-project-tag">研学项目</text>
						<text class="notice-project-name">{{ item.projectTitle }}</text>
						<text class="notice-project-arrow">›</text>
					</view>
					<view class="notice-footer uni-row">
						<text class="read-more">阅读全文</text>
						<text class="arrow-right">›</text>
					</view>
				</view>

				<view v-if="filteredNotices.length === 0" class="empty-state uni-column">
					<image src="/static/icon-note.svg" class="empty-emoji" mode="aspectFit"></image>
					<text class="empty-txt">没有找到相关动态</text>
				</view>

				<view style="height: 40px;"></view>
			</view>
		</scroll-view>
	</view>
</template>

<script setup lang="uts">
	import { ref, computed } from 'vue'
	import { onLoad } from '@dcloudio/uni-app'
	import { getLayoutWindowInfo } from '../../utils/system-layout.uts'
	import { fetchStudyNotices, getNoticeTagColor, sortNoticesByTime, type StudyNotice } from './utils/study-notices.uts'
	import { stripBodyExtras, stripHtml } from '../../utils/html-content.uts'

	const noticeBrief = (content: string): string => {
		const plain = stripHtml(stripBodyExtras(content))
		if (plain.length <= 72) return plain
		return plain.substring(0, 72) + '…'
	}

	const layout = getLayoutWindowInfo()
	const statusBarHeight = layout.statusBarHeight
	const windowHeight = layout.windowHeight
	const navBarHeight = 44
	const searchAreaHeight = 60
	const filterAreaHeight = 90
	const headerHeight = statusBarHeight + navBarHeight + searchAreaHeight + filterAreaHeight
	const listStyle = 'top: ' + headerHeight + 'px; height: ' + (windowHeight - headerHeight) + 'px;'

	const searchKeyword = ref('')
	const activeType = ref(0)
	const noticeTypes = ['全部', '测试分类']
	const sortOrder = ref('desc') // desc: 最新, asc: 最早

	const filterProjectId = ref('')
	const pageTitle = ref('动态列表')
	const studyNotices = ref<StudyNotice[]>([])

	const filteredNotices = computed((): StudyNotice[] => {
		let list = studyNotices.value.filter(item => {
			if (filterProjectId.value.length > 0) {
				if (item.projectId !== filterProjectId.value) return false
			}
			// 1. 类型过滤
			const typeMatch = activeType.value === 0 || item.type === noticeTypes[activeType.value]
			// 2. 搜索过滤
			const searchMatch = searchKeyword.value.trim() === '' ||
							   item.title.toLowerCase().includes(searchKeyword.value.toLowerCase()) ||
							   item.content.toLowerCase().includes(searchKeyword.value.toLowerCase())
			return typeMatch && searchMatch
		})

		return sortNoticesByTime(list, sortOrder.value === 'desc')
	})

	onLoad((options: OnLoadOptions) => {
		const pid = options['projectId']
		if (pid != null && pid.toString().length > 0) {
			filterProjectId.value = pid.toString()
			pageTitle.value = '项目动态'
		}
		loadNotices()
	})

	const loadNotices = () => {
		fetchStudyNotices(filterProjectId.value).then((list) => {
			studyNotices.value = list
			if (filterProjectId.value.length > 0) {
				let title = '项目动态'
				for (let i = 0; i < list.length; i++) {
					const n = list[i]
					if (n.projectId === filterProjectId.value) {
						title = n.projectTitle + ' · 动态'
						break
					}
				}
				pageTitle.value = title
			}
		}).catch((_err) => {
			studyNotices.value = []
			uni.showToast({ title: '动态加载失败', icon: 'none' })
		})
	}

	const goBack = () => {
		uni.navigateBack()
	}

	const setSort = (order: string) => {
	sortOrder.value = order
}
const toggleSort = () => {
		sortOrder.value = sortOrder.value === 'desc' ? 'asc' : 'desc'
	}

	const goDetail = (id: string) => {
		uni.navigateTo({ url: '/pages/index/notice-detail?id=' + id })
	}

	const goProject = (projectId: string) => {
		uni.navigateTo({ url: '/pages/appointment/project-detail?id=' + projectId })
	}
</script>

