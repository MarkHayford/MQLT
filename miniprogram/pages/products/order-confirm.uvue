<template>
	<view class="page-container uni-column" :style="pageStyle">
		<view class="glass-nav" :style="{ paddingTop: statusBarHeight + 'px' }">
			<view class="nav-content uni-row">
				<view class="nav-back uni-row" @click="goBack">
					<image src="/static/auth-back.svg" class="back-icon" mode="aspectFit"></image>
					<text class="nav-back-text">返回</text>
				</view>
				<text class="nav-title">确认订单</text>
			</view>
		</view>

		<scroll-view class="main-scroll" :style="mainScrollStyle" scroll-y="true" :show-scrollbar="false" :bounces="true">
			<view class="address-card" @click="chooseAddress">
				<view v-if="selectedAddress != null" class="address-content uni-row">
					<view class="address-pin">
						<text class="address-pin-text">收</text>
					</view>
					<view class="address-info uni-column">
						<view class="receiver-row uni-row">
							<text class="receiver-name">{{ selectedAddress?.receiver }}</text>
							<text class="receiver-phone">{{ selectedAddress?.phone }}</text>
						</view>
						<text class="address-detail">{{ selectedAddress?.province }} {{ selectedAddress?.city }} {{ selectedAddress?.district }} {{ selectedAddress?.detail }}</text>
					</view>
					<text class="card-arrow">›</text>
				</view>
				<view v-else class="empty-address uni-row">
					<text class="empty-address-text">请选择收货地址</text>
					<text class="card-arrow">›</text>
				</view>
			</view>

			<view class="section-card">
				<view class="section-title-row uni-row">
					<text class="section-title">商品清单</text>
					<text class="section-sub">{{ orderItems.length }} 件商品</text>
				</view>
				<view class="order-item uni-row" v-for="(item, index) in orderItems" :key="item.productId">
					<image :src="resolveMallProductImageUrl(item.imageUrl)" class="product-cover" mode="aspectFill"></image>
					<view class="product-info uni-column">
						<text class="product-name">{{ item.name }}</text>
						<text class="product-spec">规格：默认</text>
						<view class="product-price-row uni-row">
							<text class="product-price">¥{{ item.price }}</text>
						</view>
					</view>
					<view class="quantity-control uni-row" v-if="source === 'direct'">
						<view class="qty-btn" @click="changeDirectQuantity(-1)">
							<text class="qty-btn-text">-</text>
						</view>
						<text class="qty-value">{{ item.quantity }}</text>
						<view class="qty-btn" @click="changeDirectQuantity(1)">
							<text class="qty-btn-text">+</text>
						</view>
					</view>
					<text v-else class="quantity-text">×{{ item.quantity }}</text>
				</view>
			</view>

			<view class="section-card">
				<view class="info-row uni-row">
					<text class="info-label">配送方式</text>
					<text class="info-value">普通快递 · 免运费</text>
				</view>
				<view class="card-line"></view>
				<view class="info-row uni-row">
					<text class="info-label">支付方式</text>
					<text class="info-value">微信支付（模拟）</text>
				</view>
				<view class="card-line"></view>
				<view class="coupon-pay-row uni-row" @click="chooseCoupon">
					<view class="coupon-pay-info uni-column">
						<text class="info-label">优惠卡券</text>
						<text class="coupon-pay-desc">{{ couponRowDesc }}</text>
					</view>
					<text class="coupon-pick">{{ couponRowValue }} ›</text>
				</view>
				<view class="card-line"></view>
				<view class="remark-row uni-column">
					<text class="info-label">订单备注</text>
					<textarea class="remark-input" v-model="remark" placeholder="选填，可备注配送要求" :maxlength="80" placeholder-style="color:#9CA3AF" />
				</view>
			</view>

			<view class="section-card">
				<view class="amount-row uni-row">
					<text class="amount-label">商品金额</text>
					<text class="amount-value">¥{{ goodsAmount }}</text>
				</view>
				<view class="amount-row uni-row">
					<text class="amount-label">运费</text>
					<text class="amount-value">¥0.00</text>
				</view>
				<view class="amount-row uni-row" v-if="couponDiscountNumber > 0">
					<text class="amount-label">卡券抵扣</text>
					<text class="points-value">-¥{{ couponDiscount }}</text>
				</view>
			</view>

			<view class="bottom-spacer"></view>
		</scroll-view>

		<view class="submit-bar uni-row">
			<view class="submit-total uni-column">
				<view class="submit-price-row uni-row">
					<text class="submit-label">实付</text>
					<text class="submit-currency">¥</text>
					<text class="submit-price">{{ payableAmount }}</text>
				</view>
				<text class="submit-desc">{{ submitDesc }}</text>
			</view>
			<view :class="['submit-btn', isSubmitting ? 'submit-btn-disabled' : '']" @click="submitOrder">
				<text class="submit-btn-text">{{ isSubmitting ? '提交中' : '提交订单' }}</text>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { ref, computed } from 'vue'
	import { onLoad, onShow } from '@dcloudio/uni-app'
	import { ApiEndpoints } from '../../utils/api-endpoints.uts'
	import { deleteApi, getApi, getAuthToken } from '../../utils/api-client.uts'
	import { fetchMallProductDetail } from './utils/mall-products.uts'
	import { resolveMallProductImageUrl } from './utils/mall-product-image.uts'
	import { couponBucket, couponDiscountYuan, couponFaceText, createMallOrder, fetchAddresses, fetchUserCoupons, type UserCoupon } from '../../utils/user-services.uts'
	import { getLayoutWindowInfo } from '../../utils/system-layout.uts'
	import { promptLoginThenGoMine } from '../../utils/app-nav.uts'

	const layout = getLayoutWindowInfo()
	const statusBarHeight = layout.statusBarHeight
	const windowHeight = layout.windowHeight
	const screenHeight = layout.screenHeight
	const headerTotalHeight = statusBarHeight + 44
	const pageStyle = 'height: ' + screenHeight + 'px;'
	const mainScrollStyle = 'height: ' + (windowHeight - headerTotalHeight - 92).toString() + 'px; margin-top: ' + headerTotalHeight.toString() + 'px;'

	type CheckoutItem = {
		cartItemId: string
		productId: string
		name: string
		price: number
		imageUrl: string
		quantity: number
	}

	type Address = {
		id: string
		receiver: string
		phone: string
		province: string
		city: string
		district: string
		detail: string
		isDefault: boolean
	}

	const source = ref('direct')
	const productId = ref('')
	const cartIds = ref<string[]>([])
	const orderItems = ref<CheckoutItem[]>([])
	const addresses = ref<Address[]>([])
	const selectedAddress = ref<Address | null>(null)
	const remark = ref('')
	const coupons = ref<UserCoupon[]>([])
	const selectedCouponId = ref('')
	const preselectCouponId = ref('')
	const isSubmitting = ref(false)

	const hasToken = (): boolean => {
		return getAuthToken().length > 0
	}

	const goodsAmount = computed((): string => {
		let total = 0
		for (let i = 0; i < orderItems.value.length; i++) {
			total += orderItems.value[i].price * orderItems.value[i].quantity
		}
		return total.toFixed(2)
	})

	const goodsAmountNumber = computed((): number => {
		return parseFloat(goodsAmount.value)
	})

	const selectedCoupon = computed((): UserCoupon | null => {
		const id = selectedCouponId.value
		if (id.length === 0) return null
		const list = coupons.value
		for (let i = 0; i < list.length; i++) {
			if (list[i].id === id) return list[i]
		}
		return null
	})

	const usableCoupons = computed((): UserCoupon[] => {
		const amount = goodsAmountNumber.value
		const list = coupons.value
		const out: UserCoupon[] = []
		for (let i = 0; i < list.length; i++) {
			const item = list[i]
			if (couponBucket(item) !== 'unused') continue
			if (item.productId.length > 0) {
				let hit = false
				for (let j = 0; j < orderItems.value.length; j++) {
					if (orderItems.value[j].productId === item.productId) hit = true
				}
				if (hit) out.push(item)
				continue
			}
			if (couponDiscountYuan(item, amount) > 0) out.push(item)
		}
		return out
	})

	const couponDiscountNumber = computed((): number => {
		const coupon = selectedCoupon.value
		if (coupon == null) return 0
		if (coupon.productId.length > 0) {
			let line = 0
			for (let i = 0; i < orderItems.value.length; i++) {
				const it = orderItems.value[i]
				if (it.productId === coupon.productId) line = line + Number(it.price) * Number(it.quantity)
			}
			return line > 0 ? line : 0
		}
		return couponDiscountYuan(coupon, goodsAmountNumber.value)
	})

	const couponDiscount = computed((): string => {
		return couponDiscountNumber.value.toFixed(2)
	})

	const payableAmount = computed((): string => {
		const amount = goodsAmountNumber.value - couponDiscountNumber.value
		return (amount > 0 ? amount : 0).toFixed(2)
	})

	const couponRowDesc = computed((): string => {
		if (usableCoupons.value.length === 0) return '暂无适用于本单的卡券'
		return usableCoupons.value.length.toString() + ' 张可抵扣'
	})

	const couponRowValue = computed((): string => {
		const coupon = selectedCoupon.value
		if (coupon == null) return '未使用'
		return couponFaceText(coupon)
	})

	const submitDesc = computed((): string => {
		const coupon = selectedCoupon.value
		return coupon != null ? '已使用 ' + coupon.title : '未使用卡券'
	})

	const goBack = () => {
		uni.navigateBack()
	}

	const ensureLogin = (): boolean => {
		if (hasToken()) return true
		promptLoginThenGoMine()
		return false
	}

	const loadAddresses = () => {
		if (!hasToken()) return
		fetchAddresses<Address>().then((list) => {
			addresses.value = list
			if (list.length === 0) {
				selectedAddress.value = null
				return
			}
			let target = list[0]
			for (let i = 0; i < list.length; i++) {
				if (list[i].isDefault) {
					target = list[i]
					break
				}
			}
			if (selectedAddress.value == null) selectedAddress.value = target
		}).catch((_err) => {
			addresses.value = []
			selectedAddress.value = null
		})
	}

	const loadCoupons = () => {
		if (!hasToken()) return
		fetchUserCoupons().then((list) => {
			coupons.value = list
			if (preselectCouponId.value.length > 0) {
				let hit = false
				for (let i = 0; i < list.length; i++) {
					if (list[i].id === preselectCouponId.value && couponBucket(list[i]) === 'unused') {
						selectedCouponId.value = list[i].id
						hit = true
						break
					}
				}
				if (hit) {
					uni.showToast({ title: '已自动选择卡券', icon: 'none' })
				}
			}
			const current = selectedCoupon.value
			if (current == null) return
			if (couponDiscountYuan(current, goodsAmountNumber.value) <= 0) selectedCouponId.value = ''
		}).catch((_err) => {
			coupons.value = []
			selectedCouponId.value = ''
		})
	}

	const loadDirectItem = () => {
		if (productId.value.length === 0) return
		fetchMallProductDetail(productId.value).then((product) => {
			if (product == null) return
			orderItems.value = [{
				cartItemId: '',
				productId: product.id,
				name: product.name,
				price: parseFloat(product.price.toString()),
				imageUrl: product.imageUrl,
				quantity: 1
			}]
		}).catch((_err) => {
			orderItems.value = []
			uni.showToast({ title: '商品加载失败', icon: 'none' })
		})
	}

	const loadCartItems = () => {
		if (cartIds.value.length === 0) {
			orderItems.value = []
			return
		}
		getApi<any[]>(ApiEndpoints.mallCart, true).then((list) => {
			const mapped: CheckoutItem[] = []
			for (let i = 0; i < list.length; i++) {
				const raw = list[i]
				const id = raw['id'] as string
				if (cartIds.value.indexOf(id) < 0) continue
				const product = raw['product'] as any
				mapped.push({
					cartItemId: id,
					productId: raw['productId'] as string,
					name: product['name'] as string,
					price: parseFloat(product['price'].toString()),
					imageUrl: product['imageUrl'] == null ? '' : product['imageUrl'].toString(),
					quantity: raw['quantity'] as number
				})
			}
			orderItems.value = mapped
		}).catch((_err) => {
			orderItems.value = []
			uni.showToast({ title: '商品加载失败', icon: 'none' })
		})
	}

	const chooseAddress = () => {
		if (addresses.value.length === 0) {
			uni.showModal({
				title: '暂无收货地址',
				content: '请先新增一个收货地址。',
				confirmText: '去新增',
				success: (res) => {
					if (res.confirm) uni.navigateTo({ url: '/pages/mine/address-edit' })
				}
			})
			return
		}
		const items: string[] = []
		for (let i = 0; i < addresses.value.length; i++) {
			const addr = addresses.value[i]
			items.push(addr.receiver + ' · ' + addr.province + addr.city + addr.district)
		}
		uni.showActionSheet({
			itemList: items,
			success: (res) => {
				selectedAddress.value = addresses.value[res.tapIndex]
			}
		})
	}

	const changeDirectQuantity = (delta: number) => {
		if (orderItems.value.length === 0) return
		const next = orderItems.value[0].quantity + delta
		if (next < 1 || next > 99) return
		orderItems.value[0].quantity = next
		const coupon = selectedCoupon.value
		if (coupon != null && couponDiscountYuan(coupon, goodsAmountNumber.value) <= 0) selectedCouponId.value = ''
	}

	const chooseCoupon = () => {
		const list = usableCoupons.value
		if (list.length === 0) {
			uni.showToast({ title: '暂无可用卡券', icon: 'none' })
			return
		}
		const names: string[] = ['不使用卡券']
		const limit = list.length > 5 ? 5 : list.length
		for (let i = 0; i < limit; i++) {
			const item = list[i]
			names.push(couponFaceText(item) + ' · ' + item.title)
		}
		uni.showActionSheet({
			itemList: names,
			success: (res) => {
				if (res.tapIndex === 0) {
					selectedCouponId.value = ''
					return
				}
				selectedCouponId.value = list[res.tapIndex - 1].id
			}
		})
	}

	const removeCheckedCartItems = () => {
		if (source.value !== 'cart') return
		for (let i = 0; i < orderItems.value.length; i++) {
			const id = orderItems.value[i].cartItemId
			if (id.length > 0) deleteApi<any>(ApiEndpoints.mallCart + '/' + id, true)
		}
	}

	const submitOrder = () => {
		if (isSubmitting.value) return
		if (!ensureLogin()) return
		if (orderItems.value.length === 0) {
			uni.showToast({ title: '请选择商品', icon: 'none' })
			return
		}
		const address = selectedAddress.value
		if (address == null) {
			uni.showToast({ title: '请选择收货地址', icon: 'none' })
			return
		}
		const items: any[] = []
		for (let i = 0; i < orderItems.value.length; i++) {
			items.push({
				productId: orderItems.value[i].productId,
				quantity: orderItems.value[i].quantity
			})
		}
		isSubmitting.value = true
		createMallOrder<any>({
			items,
			addressId: address.id,
			remark: remark.value,
			couponId: selectedCouponId.value
		}).then((order) => {
			isSubmitting.value = false
			removeCheckedCartItems()
			const orderNo = order != null && order['orderNo'] != null ? order['orderNo'].toString() : '订单'
			const orderId = order != null && order['id'] != null ? order['id'].toString() : ''
			const orderStatus = order != null && order['status'] != null ? order['status'].toString() : ''
			// 列表页只认精简桶：unpaid / active / completed / cancelled
			let listStatus = 'unpaid'
			const st = orderStatus.length > 0 ? orderStatus : (payableAmount.value === '0.00' ? 'paid' : 'unpaid')
			if (st === 'unpaid') listStatus = 'unpaid'
			else if (st === 'cancelled') listStatus = 'cancelled'
			else if (st === 'completed') listStatus = 'completed'
			else listStatus = 'active'
			uni.showModal({
				title: '订单已提交',
				content: payableAmount.value === '0.00' ? orderNo + ' 已使用卡券完成支付。' : orderNo + ' 已生成，请在我的订单中完成支付。',
				showCancel: false,
				confirmText: '查看订单',
				success: () => {
					if (orderId.length > 0) {
						uni.redirectTo({ url: '/pages/mine/order-detail?id=' + encodeURIComponent(orderId) })
					} else {
						uni.redirectTo({ url: '/pages/mine/my-orders?status=' + listStatus })
					}
				}
			})
		}).catch((_err) => {
			isSubmitting.value = false
			uni.showToast({ title: '提交订单失败', icon: 'none' })
		})
	}

	onLoad((options: OnLoadOptions) => {
		source.value = options['source'] != null ? options['source'].toString() : 'direct'
		productId.value = options['productId'] != null ? decodeURIComponent(options['productId'].toString()) : ''
		preselectCouponId.value = options['couponId'] != null ? decodeURIComponent(options['couponId'].toString()) : ''
		const ids = options['cartIds'] != null ? options['cartIds'].toString() : ''
		const decodedIds = ids.length > 0 ? decodeURIComponent(ids) : ''
		cartIds.value = decodedIds.length > 0 ? decodedIds.split(',') : []
		if (!ensureLogin()) return
		if (source.value === 'cart') {
			loadCartItems()
		} else {
			loadDirectItem()
		}
		loadAddresses()
		loadCoupons()
	})

	onShow(() => {
		if (hasToken()) {
			loadAddresses()
			loadCoupons()
		}
	})
</script>

<style>
	.page-container {
		border-width: 0;
		border-color: #FFFFFF;
		flex: 1;
		background-color: #F5F7FB;
	}
	.glass-nav {
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		z-index: 100;
		background-color: rgba(255, 255, 255, 0.9);
		border-bottom: 1px solid rgba(0, 0, 0, 0.05);
	}
	.nav-content {
		height: 44px;
		align-items: center;
		padding: 0 16px;
		position: relative;
	}
	.nav-back {
		align-items: center;
		z-index: 10;
	}
	.back-icon {
		width: 18px;
		height: 18px;
		margin-right: 4px;
	}
	.nav-back-text {
		font-size: 16px;
		color: #1A1A1A;
		font-weight: 500;
	}
	.nav-title {
		position: absolute;
		left: 0;
		right: 0;
		text-align: center;
		font-size: 17px;
		font-weight: 700;
		color: #1A1A1A;
	}
	.main-scroll {
		flex-shrink: 0;
	}
	.address-card,
	.section-card {
		margin: 14px 16px 0 16px;
		background-color: #FFFFFF;
		border-radius: 18px;
		border: 1px solid rgba(0, 0, 0, 0.04);
		overflow: visible;
	}
	.address-content,
	.empty-address {
		padding: 16px;
		align-items: center;
	}
	.address-pin {
		width: 38px;
		height: 38px;
		border-radius: 19px;
		background-color: #EFF6FF;
		align-items: center;
		justify-content: center;
		margin-right: 12px;
	}
	.address-pin-text {
		font-size: 15px;
		font-weight: 800;
		color: #1A1A1A;
	}
	.address-info {
		flex: 1;
	}
	.receiver-row {
		align-items: center;
		margin-bottom: 5px;
	}
	.receiver-name {
		font-size: 16px;
		font-weight: 800;
		color: #1A1A1A;
		margin-right: 10px;
	}
	.receiver-phone,
	.address-detail {
		font-size: 13px;
		color: #374151;
		line-height: 20px;
	}
	.empty-address {
		justify-content: space-between;
	}
	.empty-address-text {
		font-size: 15px;
		font-weight: 700;
		color: #1A1A1A;
	}
	.card-arrow {
		font-size: 22px;
		color: #E5E7EB;
		margin-left: 8px;
	}
	.section-card {
		padding: 16px;
	}
	.section-title-row,
	.info-row,
	.amount-row,
	.product-price-row {
		align-items: center;
		justify-content: space-between;
	}
	.section-title {
		font-size: 16px;
		font-weight: 800;
		color: #1A1A1A;
	}
	.section-sub,
	.info-label,
	.amount-label {
		font-size: 13px;
		color: #9CA3AF;
	}
	.order-item {
		padding-top: 14px;
		align-items: center;
	}
	.product-cover {
		width: 70px;
		height: 70px;
		border-radius: 14px;
		margin-right: 12px;
	}
	.product-info {
		flex: 1;
	}
	.product-name {
		font-size: 15px;
		font-weight: 800;
		color: #1A1A1A;
		line-height: 20px;
	}
	.product-spec {
		font-size: 12px;
		color: #9CA3AF;
		margin-top: 4px;
		margin-bottom: 7px;
	}
	.product-price {
		font-size: 15px;
		font-weight: 800;
		color: #B45309;
	}
	.quantity-text {
		font-size: 14px;
		color: #374151;
		margin-left: 10px;
	}
	.quantity-control {
		align-items: center;
		margin-left: 8px;
	}
	.qty-btn {
		width: 28px;
		height: 28px;
		border-radius: 14px;
		background-color: #E8EEF8;
		align-items: center;
		justify-content: center;
