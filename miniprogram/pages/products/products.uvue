<template>
	<view class="page">
		<view class="fixed-header">
			<view class="status-bar" :style="statusBarStyle"></view>
			<view class="nav uni-row">
				<view class="nav-back uni-row" @click="goBack">
					<image src="/static/auth-back.svg" class="nav-back-icon" mode="aspectFit"></image>
					<text class="nav-back-text">返回</text>
				</view>
				<text class="nav-title">文创商城</text>
<view class="nav-space"></view>
			</view>

			<view v-if="isProjectShop" class="shop-hero uni-column">
				<text class="shop-kicker">SOUVENIR</text>
				<text class="shop-project">{{ shopProjectTitle.length > 0 ? shopProjectTitle : '本项目文创' }}</text>
				<text class="shop-hint">仅展示本研学项目周边，与其他项目互不混入</text>
			</view>

			<view class="search-area">
				<view class="search-wrap uni-row">
					<image src="/static/func-search.svg" class="s-icon" mode="aspectFit"></image>
					<input class="s-input" type="text" :placeholder="searchPlaceholder" placeholder-style="color:#6B7280;" v-model="searchKeyword" />
				</view>
				<view class="shop-ico" @click="goOrders">
					<image src="/static/shop-nav-orders.svg" class="shop-ico-img" mode="aspectFit"></image>
				</view>
				<view class="shop-ico" @click="goCart">
					<image src="/static/shop-nav-cart.svg" class="shop-ico-img" mode="aspectFit"></image>
					<view v-if="cartTotal > 0" class="shop-ico-badge">
						<text class="shop-ico-badge-txt">{{ cartBadge }}</text>
					</view>
				</view>
			</view>

			<scroll-view v-if="categoryTabs.length > 1" class="cat-scroll" scroll-x="true" :show-scrollbar="false">
				<view class="cat-list uni-row">
					<view
						v-for="(cat, index) in categoryTabs"
						:key="'cat-'+index"
						:class="['cat-item', activeCategory === index ? 'cat-active' : '']"
						@click="activeCategory = index"
					>
						<text :class="['cat-txt', activeCategory === index ? 'cat-txt-active' : '']">{{ cat }}</text>
					</view>
				</view>
			</scroll-view>
		</view>

		<scroll-view class="main-scroll" :style="mainScrollStyle" scroll-y="true" :show-scrollbar="false" :bounces="true">
			<view v-if="filteredMallProducts.length > 0" class="products-grid">
				<view class="product-card" v-for="(item, index) in filteredMallProducts" :key="item.id" @click="handleProductClick(item.id)">
					<view class="product-frame">
						<image :src="resolveMallProductImageUrl(item.imageUrl)" class="product-img-box" mode="aspectFill"></image>
					</view>
					<view class="product-info">
						<text class="product-name">{{ item.name }}</text>
						<view class="product-footer uni-row">
							<text class="product-price">¥{{ item.price }}</text>
							<view class="buy-tag">
								<text class="buy-tag-txt">选购</text>
							</view>
						</view>
					</view>
				</view>
			</view>
			<view v-else class="empty uni-column">
				<text class="empty-title">{{ emptyTitle }}</text>
				<text class="empty-desc">{{ emptyDesc }}</text>
			</view>
			<view class="bottom-spacer"></view>
		</scroll-view>

		
	</view>
</template>

<script setup lang="uts">
	import { computed, ref } from 'vue'
	import { onLoad, onShow } from '@dcloudio/uni-app'
	import { getLayoutWindowInfo } from '../../utils/system-layout.uts'
	import { fetchMallProducts, mallProductDetailUrl, type MallProduct } from './utils/mall-products.uts'
	import { resolveMallProductImageUrl } from './utils/mall-product-image.uts'
	import { ApiEndpoints } from '../../utils/api-endpoints.uts'
	import { getApi, getAuthToken } from '../../utils/api-client.uts'
	import { StorageKeys } from '../../utils/storage-keys.uts'
	import { fetchStudyProjectDetail } from '../../utils/study-projects.uts'

	const layout = getLayoutWindowInfo()
	const statusBarHeight = layout.statusBarHeight
	const windowHeight = layout.windowHeight

	const statusBarStyle = 'height: ' + statusBarHeight + 'px;'

	const searchKeyword = ref('')
	const activeCategory = ref(0)
	const cartTotal = ref(0)
	const mallProducts = ref<MallProduct[]>([])
	const filterProjectId = ref('')
	const shopProjectTitle = ref('')

	const isProjectShop = computed((): boolean => {
		return filterProjectId.value.length > 0
	})

	const searchPlaceholder = computed((): string => {
		return isProjectShop.value ? '搜索本店文创...' : '搜索文创周边...'
	})

	const emptyTitle = computed((): string => {
		if (searchKeyword.value.trim().length > 0) return '没有找到相关文创'
		return isProjectShop.value ? '暂无本项目文创' : '暂无文创商品'
	})

	const emptyDesc = computed((): string => {
		if (searchKeyword.value.trim().length > 0) return '换个关键词再试试'
		return isProjectShop.value ? '该研学项目还没有上架专属周边' : '商品上架后会出现在这里'
	})

	const categoryTabs = computed((): string[] => {
		const tabs: string[] = ['全部']
		const list = mallProducts.value
		for (let i = 0; i < list.length; i++) {
			const cat = list[i].category != null ? list[i].category.toString() : ''
			if (cat.length === 0) continue
			let exists = false
			for (let j = 0; j < tabs.length; j++) {
				if (tabs[j] === cat) {
					exists = true
					break
				}
			}
			if (!exists) tabs.push(cat)
		}
		return tabs
	})

	const headerTotalHeight = computed((): number => {
		let height = statusBarHeight + 44 + 56
		if (isProjectShop.value) height += 86
		if (categoryTabs.value.length > 1) height += 46
		return height
	})

	const mainScrollStyle = computed((): string => {
		const top = headerTotalHeight.value
		return 'top: ' + top.toString() + 'px; height: ' + (windowHeight - top).toString() + 'px;'
	})

	const rememberShopProject = (projectId: string) => {
		if (projectId.length === 0) {
			uni.removeStorageSync(StorageKeys.mallShopProjectId)
			return
		}
		uni.setStorageSync(StorageKeys.mallShopProjectId, projectId)
	}

	const refreshCartBadge = () => {
		if (getAuthToken().length === 0) {
			cartTotal.value = 0
			return
		}
		getApi<any[]>(ApiEndpoints.mallCart, true).then((list) => {
			let total = 0
			for (let i = 0; i < list.length; i++) {
				total += list[i]['quantity'] as number
			}
			cartTotal.value = total
		}).catch((_err) => {
			cartTotal.value = 0
		})
	}

	const loadShopProjectTitle = (projectId: string) => {
		if (projectId.length === 0) {
			shopProjectTitle.value = ''
			return
		}
		fetchStudyProjectDetail(projectId).then((found) => {
			shopProjectTitle.value = found != null ? found.title : ''
		}).catch((_err) => {
			shopProjectTitle.value = ''
		})
	}

	const isolateProjectProducts = (list: MallProduct[], projectId: string): MallProduct[] => {
		const bound: MallProduct[] = []
		for (let i = 0; i < list.length; i++) {
			const item = list[i]
			if (item.category === '奖品') continue
			const itemPid = item.projectId != null ? item.projectId.toString() : ''
			if (projectId.length > 0) {
				if (itemPid === projectId) bound.push(item)
			} else {
				bound.push(item)
			}
		}
		return bound
	}

	const loadProducts = () => {
		const pid = filterProjectId.value
		fetchMallProducts(pid).then((list) => {
			mallProducts.value = isolateProjectProducts(list, pid)
			if (activeCategory.value >= categoryTabs.value.length) activeCategory.value = 0
		}).catch((_err) => {
			mallProducts.value = []
			uni.showToast({ title: '商品数据加载失败', icon: 'none' })
		})
	}

	onShow(() => {
		refreshCartBadge()
		loadProducts()
	})

	onLoad((options: OnLoadOptions) => {
		const pid = options['projectId']
		filterProjectId.value = pid != null ? decodeURIComponent(pid.toString()) : ''
		rememberShopProject(filterProjectId.value)
		loadShopProjectTitle(filterProjectId.value)
	})

	const filteredMallProducts = computed((): MallProduct[] => {
		let list = mallProducts.value
		if (activeCategory.value > 0 && activeCategory.value < categoryTabs.value.length) {
			const targetCat = categoryTabs.value[activeCategory.value]
			const matched: MallProduct[] = []
			for (let i = 0; i < list.length; i++) {
				if (list[i].category === targetCat) matched.push(list[i])
			}
			list = matched
		}
		const kw = searchKeyword.value.trim().toLowerCase()
		if (kw.length > 0) {
			const matched: MallProduct[] = []
			for (let i = 0; i < list.length; i++) {
				if (list[i].name.toLowerCase().includes(kw)) matched.push(list[i])
			}
			list = matched
		}
		return list
	})

	const goBack = () => {
		uni.navigateBack()
	}

	const cartBadge = computed((): string => {
		if (cartTotal.value > 99) return '99+'
		return cartTotal.value.toString()
	})

	const goOrders = () => {
		uni.navigateTo({ url: '/pages/mine/my-orders?status=all' })
	}

	const goCart = () => {
		uni.navigateTo({ url: '/pages/products/cart' })
	}

	const handleProductClick = (id: string) => {
		uni.navigateTo({
			url: mallProductDetailUrl(id, filterProjectId.value)
		})
	}


</script>

<style>
