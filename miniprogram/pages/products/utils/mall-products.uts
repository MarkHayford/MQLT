import { ApiEndpoints, endpointWithId } from '../../../utils/api-endpoints.uts'
import { getApi, postApi } from '../../../utils/api-client.uts'

export type MallSpec = {
	label: string
	value: string
}

export type MallDetailBlock = {
	id: string
	type: string
	html: string
	url: string
	width: number
	urls: string[]
}

export type MallProductComment = {
	id: string
	parentId: string
	content: string
	rating: number
	official: boolean
	createdAt: string
	authorName: string
	replyToName: string
	replies: MallProductComment[]
}

export type MallCommentGroup = {
	date: string
	items: MallProductComment[]
}

export type MallCommentList = {
	groups: MallCommentGroup[]
	items: MallProductComment[]
	ratingAvg: number
	ratingCount: number
	total: number
	page: number
	pageSize: number
}

export type MallProduct = {
	id: string
	sku: string
	name: string
	intro: string
	description: string
	gallery: string[]
	detailBlocks: MallDetailBlock[]
	specs: MallSpec[]
	services: string[]
	price: string
	icon: string
	imageUrl: string
	category: string
	imgStyle: string
	status: string
	stock: number
	sales: number
	ratingAvg: number
	ratingCount: number
	createdAt: string
	updatedAt: string
	projectId: string
}

export function fetchMallProducts(projectId: string = ''): Promise<MallProduct[]> {
	let url = ApiEndpoints.mallProducts
	if (projectId.length > 0) url = url + '?projectId=' + encodeURIComponent(projectId)
	return getApi<MallProduct[]>(url, false)
}

export function fetchMallProductDetail(id: string): Promise<MallProduct | null> {
	return getApi<MallProduct>(endpointWithId(ApiEndpoints.mallProductDetail, id), false)
}

export function mallShopUrl(projectId: string = ''): string {
	const pid = projectId.trim()
	if (pid.length === 0) return '/pages/products/products'
	return '/pages/products/products?projectId=' + encodeURIComponent(pid)
}

export function mallProductDetailUrl(id: string, projectId: string = '', review: boolean = false): string {
	let url = '/pages/products/product-detail?id=' + encodeURIComponent(id)
	if (projectId.length > 0) url = url + '&projectId=' + encodeURIComponent(projectId)
	if (review) url = url + '&review=1'
	return url
}

export function fetchMallProductComments(id: string, page: number = 1, pageSize: number = 10): Promise<MallCommentList> {
	let url = endpointWithId(ApiEndpoints.mallProductComments, id)
	url = url + '?page=' + encodeURIComponent(page.toString()) + '&pageSize=' + encodeURIComponent(pageSize.toString())
	return getApi<MallCommentList>(url, false)
}

export type MallReviewAccess = {
	canComment: boolean
}

export function fetchMallReviewAccess(id: string): Promise<MallReviewAccess> {
	return getApi<MallReviewAccess>(endpointWithId(ApiEndpoints.mallProductReviewAccess, id), true)
}

export function createMallProductComment(id: string, content: string, parentId: string = '', rating: number = 0): Promise<MallProductComment> {
	const body: any = { content: content }
	if (parentId.length > 0) {
		body.parentId = parentId
	} else {
		body.rating = rating
	}
	return postApi<MallProductComment>(endpointWithId(ApiEndpoints.mallProductComments, id), body, true)
}
