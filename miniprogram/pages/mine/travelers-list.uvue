<template>
	<view class="page uni-column">
		<view class="status-bar" :style="{ height: statusBarHeight + 'px' }"></view>
		<view class="nav-bar">
			<view class="nav-back" @click="goBack">
				<image src="/static/auth-back.svg" class="nav-back-icon" mode="aspectFit"></image>
				<text class="nav-back-text">返回</text>
			</view>
			<text class="nav-title">常用游客</text>
		</view>

		<scroll-view class="body" scroll-y="true" show-scrollbar="false">
			<view v-if="showRealNameTip" class="tip-card uni-row" @click="goSettings">
				<view class="tip-copy uni-column">
					<text class="tip-title">本人信息未生成</text>
					<text class="tip-desc">完成实名后会自动出现在列表中</text>
				</view>
				<text class="tip-act">去实名</text>
			</view>

			<view v-for="(item, index) in travelers" :key="item.id" class="card uni-column">
				<view class="card-top uni-row">
					<view v-if="item.isSelf" class="self-tag">
						<text class="self-tag-text">本人</text>
					</view>
					<text class="name">{{ item.name }}</text>
					<text v-if="item.isSelf" class="sync-text">自动同步</text>
					<text v-if="!item.isSelf" class="edit-text" @click.stop="handleEdit(index)">编辑</text>
					<text v-if="!item.isSelf" class="del-text" @click.stop="handleDelete(index)">删除</text>
				</view>
				<text class="info">手机 {{ maskPhone(item.phone) }}</text>
				<text class="info">证件 {{ maskIdCard(item.idCard) }}</text>
			</view>

			<view v-if="travelers.length === 0" class="empty uni-column">
				<text class="empty-t">暂无常用游客</text>
				<text class="empty-d">添加后预约研学会更快</text>
			</view>
			<view class="pad"></view>
		</scroll-view>

		<view class="bar uni-row">
			<view class="btn-ghost" @click="goBatchAdd">
				<text class="btn-ghost-text">批量添加</text>
			</view>
			<view class="btn-main" @click="goAddTraveler">
				<text class="btn-main-text">添加游客</text>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { ref } from 'vue'
	import { onShow } from '@dcloudio/uni-app'

	import { getStatusBarHeight } from '../../utils/system-layout.uts'
	import { deleteTraveler, fetchTravelers } from '../../utils/user-services.uts'

	const statusBarHeight = getStatusBarHeight()

	type Traveler = {
		id: string
		name: string
		phone: string
		idCard: string
		isSelf: boolean
	}

	const travelers = ref<Traveler[]>([])
	const showRealNameTip = ref(false)

	const maskPhone = (phone: string): string => {
		if (phone.length === 11) {
			return phone.substring(0, 3) + ' **** ' + phone.substring(7)
		}
		return phone
	}

	const maskIdCard = (id: string): string => {
		if (id.length >= 15) {
			return id.substring(0, 4) + ' ************ ' + id.substring(id.length - 4)
		}
		return id
	}

	const loadTravelers = () => {
		fetchTravelers<Traveler>().then((list) => {
			travelers.value = list
			let hasSelf = false
			for (let i = 0; i < list.length; i++) {
				if (list[i].isSelf) {
					hasSelf = true
					break
				}
			}
			showRealNameTip.value = !hasSelf
		}).catch((_err) => {
			travelers.value = []
			showRealNameTip.value = false
			uni.showToast({ title: '游客信息加载失败', icon: 'none' })
		})
	}

	onShow(() => {
		loadTravelers()
	})

	const goBack = () => {
		uni.navigateBack()
	}

	const goAddTraveler = () => {
		uni.navigateTo({ url: '/pages/mine/add-traveler' })
	}

	const goBatchAdd = () => {
		uni.navigateTo({ url: '/pages/mine/batch-add-travelers' })
	}

	const goSettings = () => {
		uni.navigateTo({ url: '/pages/mine/settings' })
	}

	const handleEdit = (index: number) => {
		const item = travelers.value[index]
		if (item == null) return
		if (item.isSelf) {
			uni.showToast({ title: '本人信息请在设置中修改', icon: 'none' })
			return
		}
		uni.navigateTo({ url: '/pages/mine/add-traveler?id=' + item.id })
	}

	const removeTravelerFromList = (id: string) => {
		const next: Traveler[] = []
		const list = travelers.value
		for (let i = 0; i < list.length; i++) {
			if (list[i].id !== id) next.push(list[i])
		}
		travelers.value = next
	}

	const handleDelete = (index: number) => {
		const item = travelers.value[index]
		if (item == null) return
		if (item.isSelf) {
			uni.showToast({ title: '本人游客信息不可删除', icon: 'none' })
			return
		}
		uni.showModal({
			title: '删除游客',
			content: '确定要删除“' + item.name + '”吗？',
			confirmText: '删除',
			confirmColor: '#DC2626',
			success: (res) => {
				if (!res.confirm) return
				deleteTraveler(item.id).then((_ret) => {
					removeTravelerFromList(item.id)
					uni.showToast({ title: '已删除', icon: 'success' })
				}).catch((err) => {
					const message = err != null && err.message != null ? err.message.toString() : '删除失败'
					uni.showToast({ title: message.length > 0 ? message : '删除失败', icon: 'none' })
				})
			}
		})
	}
</script>

