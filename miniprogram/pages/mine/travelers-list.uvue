		color: #1A1A1A;
	}
	.sync-text {
		font-size: 12px;
		font-weight: 700;
		color: #374151;
	}
	.edit-text {
		font-size: 13px;
		font-weight: 700;
		color: #1A73E8;
		padding: 4px 0 4px 10px;
	}
	.del-text {
		font-size: 13px;
		font-weight: 700;
		color: #DC2626;
		padding: 4px 0 4px 12px;
	}
	.info {
		font-size: 13px;
		color: #374151;
		line-height: 20px;
	}
	.empty {
		padding: 64px 16px;
		align-items: center;
	}
