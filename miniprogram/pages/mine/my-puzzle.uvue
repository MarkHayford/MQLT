<template>
	<view class="page uni-column">
		<view class="status-bar" :style="{ height: statusBarHeight + 'px' }"></view>
		<view class="nav-bar">
			<view class="nav-back" @click="goBack">
				<image src="/static/auth-back.svg" class="nav-back-icon" mode="aspectFit"></image>
				<text class="nav-back-text">返回</text>
			</view>
			<text class="nav-title">我的成果</text>
		</view>

		<scroll-view class="body" scroll-y="true" show-scrollbar="false">
			<view class="hero uni-column">
				<text class="hero-label">已结业</text>
				<text class="hero-value">{{ completedProjects }}</text>
				<text class="hero-tip">研学结业证书会发放到这里</text>
			</view>

			<view
				v-for="project in projectList"
				:key="project.id"
				class="card uni-column"
				@click="goProjectAchievement(project.id)"
			>
				<view class="card-top uni-row">
					<text class="card-title">{{ project.title }}</text>
					<view class="done-chip">
						<text class="done-chip-text">已结业</text>
					</view>
				</view>
				<text v-if="project.certificate != null" class="meta">编号 {{ project.certificate.certificateNo }}</text>
				<text v-if="project.certificate != null" class="meta">颁发 {{ project.certificate.issuedDate }} · {{ holderName(project) }}</text>
				<view class="card-foot uni-row">
					<text class="foot-link" @click.stop="goProjectAchievement(project.id)">查看证书</text>
					<text class="foot-link foot-download" @click.stop="downloadProjectCertificate(project)">下载</text>
				</view>
			</view>

			<view v-if="projectList.length === 0" class="empty uni-column">
				<text class="empty-t">暂无研学成果</text>
				<text class="empty-d">完成研学后，结业证书会显示在这里</text>
			</view>
			<view class="pad"></view>
		</scroll-view>
	</view>
</template>

<script setup lang="uts">
	import { computed, ref } from 'vue'
	import { onShow } from '@dcloudio/uni-app'
	import { StorageKeys } from '../../utils/storage-keys.uts'
	import { fetchProjectPuzzles, type ProjectPuzzle } from '../../utils/puzzle-data.uts'
	import { downloadStudyCertificate } from './utils/study-certificate.uts'
	import { getStatusBarHeight } from '../../utils/system-layout.uts'

	const statusBarHeight = getStatusBarHeight()
	const projectList = ref<ProjectPuzzle[]>([])

	const completedProjects = computed((): number => {
		return projectList.value.length
	})

	const holderName = (project: ProjectPuzzle): string => {
		const cert = project.certificate
		if (cert == null || cert.holderName.length === 0) return '研学学员'
		return cert.holderName
	}

	const loadAchievements = () => {
		const token = uni.getStorageSync(StorageKeys.authToken)
		if (token == null || token.toString().length === 0) {
			projectList.value = []
			uni.showToast({ title: '请先登录', icon: 'none' })
			return
		}
		fetchProjectPuzzles().then((list) => {
			const out: ProjectPuzzle[] = []
			for (let i = 0; i < list.length; i++) {
				if (list[i].certificate != null) out.push(list[i])
			}
			projectList.value = out
		}).catch((_err) => {
			projectList.value = []
			uni.showToast({ title: '成果加载失败，请稍后重试', icon: 'none' })
		})
	}

	const goProjectAchievement = (projectId: string) => {
		uni.navigateTo({ url: '/pages/mine/puzzle-project-achievement?id=' + projectId })
	}

	const downloadProjectCertificate = (project: ProjectPuzzle) => {
		const certificate = project.certificate
		if (certificate == null) {
			uni.showToast({ title: '证书暂未发放', icon: 'none' })
			return
		}
		downloadStudyCertificate(certificate)
	}

	const goBack = () => {
		uni.navigateBack()
	}

	onShow(() => {
		loadAchievements()
	})
</script>

