		flex: 1;
		padding: 0 16px;
	}
	.hero {
		margin-bottom: 12px;
		padding: 24px 20px;
		border-radius: 20px;
		background-image: linear-gradient(145deg, #1A1A1A 0%, #374151 100%);
		align-items: center;
	}
	.hero-label {
		font-size: 13px;
		color: #FFFFFF;
		margin-bottom: 6px;
	}
