		border-color: #1A1A1A;
	}
	.radio-dot {
		width: 8px;
		height: 8px;
		border-radius: 4px;
		background-color: #1A73E8;
	}
	.action-cell-icon {
		font-size: 13px;
		margin-right: 4px;
	}
	.action-cell-text {
