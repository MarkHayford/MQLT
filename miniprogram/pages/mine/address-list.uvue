	}
	.action-cell-text-danger {
		color: #DC2626;
	}

	.empty-state {
		padding-top: 100px;
		align-items: center;
	}
	.empty-icon {
		font-size: 56px;
		margin-bottom: 14px;
	}
	.empty-title {
		font-size: 17px;
