	}
	.addr-tag-text {
		font-size: 11px;
		color: #1A1A1A;
		font-weight: 600;
	}
	.edit-arrow {
		font-size: 22px;
		color: #E5E7EB;
		margin-left: 12px;
	}

	.card-actions {
		justify-content: space-around;
		padding-top: 12px;
		border-top-width: 0.5px;
		border-top-color: #FFFFFF;
	}
	.action-cell {
		flex: 1;
		flex-direction: row;
