<template>
	<view class="page uni-column">
		<view class="status-bar" :style="{ height: statusBarHeight + 'px' }"></view>
		<view class="nav-bar">
			<view class="nav-back" @click="goBack">
				<image src="/static/auth-back.svg" class="nav-back-icon" mode="aspectFit"></image>
				<text class="nav-back-text">返回</text>
			</view>
			<text class="nav-title">{{ editIndex === -1 ? '添加游客' : '编辑游客' }}</text>
		</view>

		<scroll-view class="body" scroll-y="true" show-scrollbar="false">
			<view class="card uni-column">
				<view class="field uni-row">
					<text class="field-label">姓名</text>
					<input class="field-input" type="text" v-model="formData.name" placeholder="真实姓名" placeholder-style="color:#E5E7EB;" />
				</view>
				<view class="line"></view>
				<view class="field uni-row">
					<text class="field-label">身份证</text>
					<input class="field-input" type="idcard" maxlength="18" v-model="formData.idCard" placeholder="15 或 18 位" placeholder-style="color:#E5E7EB;" />
				</view>
				<view class="line"></view>
				<view class="field uni-row">
					<text class="field-label">手机号</text>
					<input class="field-input" type="number" maxlength="11" v-model="formData.phone" placeholder="11 位手机号" placeholder-style="color:#E5E7EB;" />
				</view>
			</view>
			<text v-if="editIndex !== -1" class="del" @click="handleDelete">删除该游客</text>
			<view class="pad"></view>
		</scroll-view>

		<view class="bar">
			<view class="save" @click="handleSave">
				<text class="save-text">保存</text>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { ref } from 'vue'
	import { onLoad } from '@dcloudio/uni-app'

	import { getStatusBarHeight } from '../../utils/system-layout.uts'
	import { createTraveler, deleteTraveler, fetchTravelers, updateTraveler } from '../../utils/user-services.uts'

	const statusBarHeight = getStatusBarHeight()
	let isNavigating = false

	type Traveler = {
		id: string
		name: string
		phone: string
		idCard: string
		isSelf: boolean
	}

	const editIndex = ref(-1)
	const editId = ref('')
	const formData = ref<Traveler>({
		id: '',
		name: '',
		phone: '',
		idCard: '',
		isSelf: false
	})

	onLoad((options: OnLoadOptions) => {
		const idStr = options['id']
		if (idStr != null) editId.value = idStr.toString()
		fetchTravelers<Traveler>().then((list) => {
			if (editId.value.length > 0) {
				for (let i = 0; i < list.length; i++) {
					if (list[i].id === editId.value) {
						if (list[i].isSelf) {
							uni.showToast({ title: '本人信息请在设置中修改', icon: 'none' })
							setTimeout(() => { uni.navigateBack() }, 600)
							return
						}
						editIndex.value = i
						const current = list[i]
						formData.value = {
							id: current.id,
							name: current.name,
							phone: current.phone,
							idCard: current.idCard,
							isSelf: current.isSelf
						}
						break
					}
				}
			}
		}).catch((_err) => {
			uni.showToast({ title: '游客信息加载失败', icon: 'none' })
		})
	})

	const goBack = () => {
		if (isNavigating) return
		isNavigating = true
		uni.navigateBack()
	}

	const handleSave = () => {
		if (isNavigating) return
		const { name, phone, idCard } = formData.value
		if (name.trim().length < 2) {
			uni.showToast({ title: '请输入姓名', icon: 'none' })
			return
		}
		if (phone.length !== 11) {
			uni.showToast({ title: '手机号不正确', icon: 'none' })
			return
		}
		if (idCard.length !== 18 && idCard.length !== 15) {
			uni.showToast({ title: '身份证号不正确', icon: 'none' })
			return
		}

		isNavigating = true
		const payload = {
			name: formData.value.name,
			phone: formData.value.phone,
			idCard: formData.value.idCard,
			isSelf: false
		}
		const request = editId.value.length > 0 ? updateTraveler<Traveler>(editId.value, payload) : createTraveler<Traveler>(payload)
		request.then((_res) => {
			uni.showToast({ title: '保存成功', icon: 'success' })
			setTimeout(() => { uni.navigateBack() }, 800)
		}).catch((_err) => {
			isNavigating = false
			uni.showToast({ title: '保存失败，请稍后重试', icon: 'none' })
		})
	}

	const handleDelete = () => {
		if (isNavigating) return
		if (formData.value.isSelf) {
			uni.showToast({ title: '本人游客信息不可删除', icon: 'none' })
			return
		}
		uni.showModal({
			title: '提示',
			content: '确定要删除此游客信息吗？',
			confirmColor: '#DC2626',
			success: (res) => {
				if (res.confirm) {
					isNavigating = true
					deleteTraveler(editId.value).then((_res) => {
						uni.showToast({ title: '已删除', icon: 'none' })
						setTimeout(() => { uni.navigateBack() }, 800)
					}).catch((_err) => {
						isNavigating = false
						uni.showToast({ title: '删除失败，请稍后重试', icon: 'none' })
					})
				}
			}
		})
	}
</script>

<style>
	.page {
		border-width: 0;
		border-color: #FFFFFF;
		flex: 1;
		background-color: #F5F7FB;
	}
	.status-bar {
		border-width: 0;
		border-color: #FFFFFF;
		width: 100%;
		background-color: #FFFFFF;
	}
	.nav-bar {
		background-color: #FFFFFF;
		border-width: 0;
		border-color: #FFFFFF;
		height: 48px;
		padding: 0 16px;
		flex-direction: row;
		align-items: center;
		position: relative;
	}
	.nav-back {
		flex-direction: row;
		align-items: center;
		z-index: 1;
	}
	.nav-back-icon {
		width: 18px;
		height: 18px;
		margin-right: 4px;
	}
	.nav-back-text {
		font-size: 16px;
		color: #1A1A1A;
		font-weight: 500;
	}
	.nav-title {
		position: absolute;
		left: 0;
		right: 0;
		text-align: center;
		font-size: 17px;
		font-weight: 700;
		color: #1A1A1A;
	}
	.body {
		flex: 1;
		padding: 8px 16px 0 16px;
	}
	.card {
		background-color: #FFFFFF;
		border-radius: 16px;
		padding: 4px 16px;
		border-width: 1px;
		border-style: solid;
		border-color: #E5E7EB;
	}
	.field {
		height: 52px;
		align-items: center;
	}
	.field-label {
		width: 64px;
		font-size: 15px;
		color: #1A1A1A;
		font-weight: 700;
	}
	.field-input {
		flex: 1;
		height: 52px;
		font-size: 15px;
		color: #1A1A1A;
	}
	.line {
		height: 1px;
		background-color: #FFFFFF;
	}
	.del {
		margin-top: 24px;
		text-align: center;
		font-size: 14px;
		font-weight: 700;
		color: #1A73E8;
	}
	.pad {
		height: 96px;
	}
	.bar {
		padding: 12px 16px;
		padding-bottom: calc(12px + env(safe-area-inset-bottom));
		background-color: #F5F7FB;
	}
	.save {
		height: 48px;
		border-radius: 24px;
		background-color: #1A73E8;
		align-items: center;
		justify-content: center;
	}
	.save-text{
		font-size: 16px;
		font-weight: 800;
		color: #FFFFFF;
	}
</style>
