<template>
	<view class="page-wrapper" :style="pageStyle">
		<view class="fixed-header">
			<view class="status-bar" :style="statusBarStyle"></view>
			<view class="nav-bar">
				<view class="nav-back" @click="goBack">
					<image src="/static/auth-back.svg" class="nav-back-icon" mode="aspectFit"></image>
					<text class="nav-back-text">返回</text>
				</view>
				<view v-if="isEditMode" class="nav-right" @click="handleDelete">
					<text class="nav-right-text">删除</text>
				</view>
				<text class="nav-title">{{ isEditMode ? '编辑地址' : '新增地址' }}</text>
			</view>
		</view>

		<scroll-view class="main-scroll" :style="mainScrollStyle" scroll-y="true" :show-scrollbar="false" :bounces="true">
			<!-- 联系人信息 -->
			<view class="form-section">
				<text class="section-title">联系人信息</text>
				<view class="form-group">
					<view class="form-item">
						<text class="form-label">收件人</text>
						<input class="form-input" type="text" placeholder="请输入收件人姓名" v-model="name" :maxlength="20" placeholder-style="color: #E5E7EB;" />
					</view>
					<view class="form-item">
						<text class="form-label">手机号</text>
						<input class="form-input" type="number" placeholder="请输入手机号" v-model="phone" :maxlength="11" placeholder-style="color: #E5E7EB;" />
					</view>
				</view>
			</view>

			<!-- 地址信息 -->
			<view class="form-section">
				<text class="section-title">地址信息</text>
				<view class="form-group">
					<picker class="region-picker" mode="region" :value="regionPickerValue" @change="handleRegionPickerChange">
						<view class="form-item">
							<text class="form-label">所在地区</text>
							<view class="form-value-wrap uni-row">
								<text :class="['form-value', region.length === 0 ? 'form-value-placeholder' : '']">{{ region.length === 0 ? '请选择' : region }}</text>
								<text class="form-arrow">›</text>
							</view>
						</view>
					</picker>
					<view class="form-item form-item-textarea">
						<text class="form-label">详细地址</text>
						<textarea class="form-textarea" placeholder="请输入街道、楼栋号、门牌号等" v-model="detail" :maxlength="100" placeholder-style="color: #E5E7EB;" />
					</view>
				</view>
			</view>

			<!-- 标签 -->
			<view class="form-section">
				<text class="section-title">地址标签</text>
				<view class="tag-row uni-row">
					<view
						v-for="(t, i) in tagOptions"
						:key="i"
						:class="['tag-chip', tag === t ? 'tag-chip-active' : '']"
						@click="selectTag(t)"
					>
						<text :class="['tag-chip-text', tag === t ? 'tag-chip-text-active' : '']">{{ t }}</text>
					</view>
				</view>
			</view>

			<!-- 默认地址 -->
			<view class="switch-section uni-row" @click="toggleDefault">
				<view class="switch-info uni-column">
					<text class="switch-title">设为默认地址</text>
					<text class="switch-desc">下单时将自动选用该地址</text>
				</view>
				<view :class="['switch-track', isDefault ? 'switch-track-on' : '']">
					<view :class="['switch-thumb', isDefault ? 'switch-thumb-on' : '']"></view>
				</view>
			</view>

			<view class="bottom-spacer"></view>
		</scroll-view>

		<!-- 底部按钮 -->
		<view class="bottom-action-bar">
			<view class="submit-btn" @click="submit">
				<text class="submit-btn-text">保存</text>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { ref, computed } from 'vue'
	import { onLoad } from '@dcloudio/uni-app'
	import { getLayoutWindowInfo } from '../../utils/system-layout.uts'
	import { createAddress, deleteAddress, fetchAddresses, updateAddress } from '../../utils/user-services.uts'

	const layout = getLayoutWindowInfo()
	const statusBarHeight = layout.statusBarHeight
	const windowHeight = layout.windowHeight
	const screenHeight = layout.screenHeight
	const navBarHeight = 44
	const headerTotalHeight = statusBarHeight + navBarHeight

	const pageStyle = 'height: ' + screenHeight + 'px;'
	const statusBarStyle = 'height: ' + statusBarHeight + 'px;'
	const mainScrollStyle = 'top: ' + headerTotalHeight + 'px; height: ' + (windowHeight - headerTotalHeight) + 'px;'

	type Address = {
		id: string
		receiver: string
		phone: string
		province: string
		city: string
		district: string
		detail: string
		isDefault: boolean
	}

	const editId = ref('')
	const name = ref('')
	const phone = ref('')
	const region = ref('')
	const regionPickerValue = ref<string[]>([])
	const detail = ref('')
	const tag = ref('')
	const isDefault = ref(false)

	const tagOptions = ref<string[]>(['家', '公司', '学校', '其他'])

	const isEditMode = computed((): boolean => {
		return editId.value.length > 0
	})

	const validatePhone = (p: string): boolean => {
		if (p.length !== 11) return false
		if (p.charAt(0) !== '1') return false
		const second = p.charCodeAt(1)
		if (second < 51 || second > 57) return false
		for (let i = 0; i < p.length; i++) {
			const c = p.charCodeAt(i)
			if (c < 48 || c > 57) return false
		}
		return true
	}

	const handleRegionPickerChange = (event: any) => {
		const value = event.detail.value
		if (value.length < 3) {
			uni.showToast({ title: '请选择完整省市区', icon: 'none' })
			return
		}
		regionPickerValue.value = [value[0].toString(), value[1].toString(), value[2].toString()]
		region.value = regionPickerValue.value.join(' ')
	}

	const selectTag = (t: string) => {
		tag.value = tag.value === t ? '' : t
	}

	const toggleDefault = () => {
		isDefault.value = !isDefault.value
	}

	const splitRegion = (value: string): string[] => {
		const parts = value.trim().split(/\s+/)
		const result = ['', '', '']
		for (let i = 0; i < parts.length && i < 3; i++) result[i] = parts[i]
		return result
	}

	const submit = () => {
		const trimmedName = name.value.trim()
		const trimmedPhone = phone.value.trim()
		const trimmedDetail = detail.value.trim()

		if (trimmedName.length === 0) {
			uni.showToast({ title: '请输入收件人姓名', icon: 'none' })
			return
		}
		if (!validatePhone(trimmedPhone)) {
			uni.showToast({ title: '请输入正确的手机号', icon: 'none' })
			return
		}
		if (region.value.length === 0) {
			uni.showToast({ title: '请选择所在地区', icon: 'none' })
			return
		}
		if (trimmedDetail.length === 0) {
			uni.showToast({ title: '请输入详细地址', icon: 'none' })
			return
		}

		const parts = splitRegion(region.value)
		const payload = {
			receiver: trimmedName,
			phone: trimmedPhone,
			province: parts[0],
			city: parts[1],
			district: parts[2],
			detail: trimmedDetail,
			isDefault: isDefault.value
		}
		const request = isEditMode.value ? updateAddress<Address>(editId.value, payload) : createAddress<Address>(payload)
		request.then((_res) => {
			uni.showToast({ title: '保存成功', icon: 'success' })
			setTimeout(() => {
				uni.navigateBack()
			}, 600)
		}).catch((_err) => {
			uni.showToast({ title: '保存失败，请稍后重试', icon: 'none' })
		})
	}

	const handleDelete = () => {
		uni.showModal({
			title: '删除地址',
			content: '确定要删除该收货地址吗？',
			confirmText: '删除',
			confirmColor: '#DC2626',
			cancelText: '取消',
			success: (res) => {
				if (res.confirm) {
					deleteAddress(editId.value).then((_res) => {
						uni.showToast({ title: '已删除', icon: 'success' })
						setTimeout(() => {
							uni.navigateBack()
						}, 600)
					}).catch((err) => {
						const message = err != null && err.message != null ? err.message.toString() : '删除失败'
						uni.showToast({ title: message.length > 0 ? message : '删除失败', icon: 'none' })
					})
				}
			}
		})
	}

	const goBack = () => {
		uni.navigateBack()
	}

	onLoad((options: OnLoadOptions) => {
		if (options != null) {
			const idStr = options['id']
			if (idStr != null) {
				editId.value = idStr.toString()
				fetchAddresses<Address>().then((list) => {
					for (let i = 0; i < list.length; i++) {
						const item = list[i]
						if (item.id === editId.value) {
							name.value = item.receiver
							phone.value = item.phone
							region.value = item.province + ' ' + item.city + ' ' + item.district
							regionPickerValue.value = [item.province, item.city, item.district]
							detail.value = item.detail
							tag.value = ''
							isDefault.value = item.isDefault
							break
						}
					}
				}).catch((_err) => {
					uni.showToast({ title: '地址加载失败', icon: 'none' })
				})
			}
		}
	})
</script>

<style>
	.page-wrapper {
		border-width: 0;
		border-color: #FFFFFF;
		flex: 1;
		background-color: #F5F7FB;
		position: relative;
	}

