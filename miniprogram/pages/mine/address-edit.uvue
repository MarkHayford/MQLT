		border-width: 0;
		border-color: #FFFFFF;
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		z-index: 1000;
		background-color: #FFFFFF;
	}
	.status-bar {
		border-width: 0;
		border-color: #FFFFFF;
		width: 100%;
		background-color: #FFFFFF;
	}
	.nav-bar {
		background-color: #FFFFFF;
		border-width: 0;
		border-color: #FFFFFF;
		height: 44px;
		flex-direction: row;
		align-items: center;
		padding: 0 16px;
		position: relative;
		border-bottom-width: 0.5px;
		border-bottom-color: rgba(0, 0, 0, 0.08);
	}
