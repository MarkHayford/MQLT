		flex-direction: row;
		align-items: center;
		z-index: 1;
	}
	.nav-back-icon {
		width: 18px;
		height: 18px;
		margin-right: 4px;
	}
	.nav-back-text {
		font-size: 16px;
		color: #1A1A1A;
		font-weight: 500;
	}
	.nav-title {
		position: absolute;
		left: 0;
		right: 0;
		text-align: center;
		font-size: 17px;
		font-weight: 700;
		color: #1A1A1A;
	}
	.nav-bar { background-color: #FFFFFF; border-width: 0; border-color: #FFFFFF; padding-right: 96px; }
	.nav-right {
		position: relative;
		padding: 4px 8px;
		margin-left: 6px;
		z-index: 2;
	}
	.nav-right-text {
		font-size: 14px;
		color: #DC2626;
		font-weight: 500;
	}

	.main-scroll {
		position: absolute;
		left: 0;
		right: 0;
	}

	/* 表单分区 */
	.form-section {
		margin: 16px 16px 0 16px;
		background-color: #FFFFFF;
		border-radius: 14px;
		padding: 16px 18px 8px 18px;
		border: 1px solid rgba(0, 0, 0, 0.04);
	}
	.section-title {
		font-size: 13px;
		font-weight: 700;
		color: #1A1A1A;
		margin-bottom: 8px;
		letter-spacing: 1px;
	}
	.form-group {
		flex-direction: column;
	}
	.region-picker {
		width: 100%;
	}
	.form-item {
		flex-direction: row;
		align-items: center;
		padding: 12px 0;
		border-bottom-width: 0.5px;
		border-bottom-color: rgba(0, 0, 0, 0.08);
	}
	.form-item:last-child {
		border-bottom-width: 0;
	}
	.form-item-textarea {
		align-items: flex-start;
		padding: 14px 0;
	}
	.form-label {
		width: 76px;
		font-size: 15px;
		color: #1A1A1A;
		font-weight: 500;
		flex-shrink: 0;
	}
	.form-input {
		flex: 1;
		font-size: 15px;
		color: #1A1A1A;
	}
	.form-textarea {
		flex: 1;
		min-height: 60px;
		font-size: 15px;
		color: #1A1A1A;
		line-height: 22px;
	}
	.form-value-wrap {
		flex: 1;
		justify-content: flex-end;
		align-items: center;
	}
	.form-value {
		font-size: 15px;
		color: #1A1A1A;
		text-align: right;
		flex: 1;
	}
	.form-value-placeholder {
		color: #E5E7EB;
	}
	.form-arrow {
		font-size: 18px;
		color: #E5E7EB;
		margin-left: 6px;
	}

	/* 标签 */
	.tag-row {
		flex-wrap: wrap;
		margin: 0 -4px 8px -4px;
		padding: 4px 0;
	}
	.tag-chip {
		padding: 6px 16px;
		background-color: #F7F8FA;
		border-radius: 14px;
		margin: 4px;
		border: 1px solid transparent;
	}
	.tag-chip-active {
		background-color: #EFF6FF;
		border-color: #1A1A1A;
	}
	.tag-chip-text {
		font-size: 13px;
		color: #374151;
	}
	.tag-chip-text-active {
		color: #1A1A1A;
		font-weight: 700;
	}

	/* 开关 */
	.switch-section {
		margin: 16px;
		padding: 16px 18px;
		background-color: #FFFFFF;
		border-radius: 14px;
		align-items: center;
		justify-content: space-between;
		border: 1px solid rgba(0, 0, 0, 0.04);
	}
	.switch-info {
		flex: 1;
	}
	.switch-title {
		font-size: 15px;
		color: #1A1A1A;
		font-weight: 600;
		margin-bottom: 2px;
	}
	.switch-desc {
		font-size: 12px;
		color: #9CA3AF;
	}
	.switch-track {
		width: 48px;
		height: 28px;
		border-radius: 14px;
		background-color: #E5E7EB;
		justify-content: center;
		padding: 2px;
	}
	.switch-track-on {
		background-color: #1A73E8;
	}
	.switch-thumb {
		width: 24px;
		height: 24px;
		border-radius: 12px;
		background-color: #FFFFFF;
	}
	.switch-thumb-on {
		margin-left: 20px;
	}

	.bottom-spacer {
		height: 100px;
	}

	.bottom-action-bar {
		position: fixed;
		bottom: 0;
		left: 0;
		right: 0;
		padding: 12px 16px;
		padding-bottom: calc(12px + env(safe-area-inset-bottom));
		background-color: #FFFFFF;
		border-top-width: 0.5px;
		border-top-color: rgba(0, 0, 0, 0.1);
	}
	.submit-btn {
		height: 50px;
		background-image: linear-gradient(135deg, #1A1A1A 0%, #374151 100%);
		border-radius: 25px;
		align-items: center;
		justify-content: center;
	}
	.submit-btn-text {
		color: #FFFFFF;
		font-size: 16px;
		font-weight: 700;
	}
</style>
