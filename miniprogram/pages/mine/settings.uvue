<template>
	<view class="page uni-column">
		<view class="status-bar" :style="{ height: statusBarHeight + 'px' }"></view>
		<view class="nav-bar">
			<view class="nav-back" @click="goBack">
				<image src="/static/auth-back.svg" class="nav-back-icon" mode="aspectFit"></image>
				<text class="nav-back-text">返回</text>
			</view>
			<text class="nav-title">设置</text>
		</view>

		<scroll-view class="body" scroll-y="true" show-scrollbar="false">
			<view v-if="isLoggedIn" class="set-card">
				<view class="set-glass"></view>
				<view class="set-line"></view>
				<view class="set-body">
					<text class="set-head">账号</text>
					<view class="row uni-row" @click="handleRealNameVerify">
						<text class="row-label">实名认证</text>
						<text :class="realNameVerified ? 'row-val row-val-ok' : 'row-val'">{{ realNameVerified ? '已填写' : '去填写' }}</text>
					</view>
					<view class="line"></view>
					<view class="row uni-row" @click="handleChangePhone">
						<text class="row-label">手机号</text>
						<text class="row-val">{{ phoneText }}</text>
					</view>
				</view>
			</view>

			<view class="set-card">
				<view class="set-glass"></view>
				<view class="set-line"></view>
				<view class="set-body">
					<text class="set-head">协议</text>
					<view class="row uni-row" @click="openLegal('agreement')">
						<text class="row-label">用户协议</text>
						<text class="row-val">查看</text>
					</view>
					<view class="line"></view>
					<view class="row uni-row" @click="openLegal('privacy')">
						<text class="row-label">隐私政策</text>
						<text class="row-val">查看</text>
					</view>
				</view>
			</view>

			<view class="set-card">
				<view class="set-glass"></view>
				<view class="set-line"></view>
				<view class="set-body">
					<text class="set-head">关于</text>
					<view class="row uni-row" @click="handleAction('关于我们')">
						<text class="row-label">当前版本</text>
						<text class="row-val">1.0.0</text>
					</view>
				</view>
			</view>

			<view v-if="isLoggedIn" class="logout" @click="handleLogout">
				<text class="logout-text">退出登录</text>
			</view>
			<text class="copy">蒙企链探 版权所有</text>
			<view class="pad"></view>
		</scroll-view>

		<view class="mask" v-if="isRealNameSheetVisible" @click="closeRealNameSheet">
			<view class="sheet uni-column" @click.stop>
				<view class="sheet-head uni-row">
					<text class="sheet-title">实名认证</text>
					<text class="sheet-close" @click="closeRealNameSheet">关闭</text>
				</view>
				<text class="sheet-label">真实姓名</text>
				<input class="sheet-input" v-model="realNameInput" placeholder="请输入真实姓名" placeholder-style="color:#E5E7EB;" />
				<text class="sheet-label">身份证号</text>
				<input class="sheet-input" v-model="idCardInput" placeholder="18 位身份证号" :maxlength="18" placeholder-style="color:#E5E7EB;" />
				<view class="sheet-btn" @click="handleSaveRealName">
					<text class="sheet-btn-text">保存</text>
				</view>
			</view>
		</view>

		<view class="mask" v-if="isPhoneSheetVisible" @click="closePhoneSheet">
			<view class="sheet uni-column" @click.stop>
				<view class="sheet-head uni-row">
					<text class="sheet-title">修改手机号</text>
					<text class="sheet-close" @click="closePhoneSheet">关闭</text>
				</view>
				<text class="sheet-label">新手机号</text>
				<input class="sheet-input" type="number" maxlength="11" v-model="newPhoneInput" placeholder="11 位手机号" placeholder-style="color:#E5E7EB;" />
				<view class="sheet-btn" @click="handleSavePhone">
					<text class="sheet-btn-text">保存</text>
				</view>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { ref, computed } from 'vue'
	import { onShow } from '@dcloudio/uni-app'

	import { getStatusBarHeight } from '../../utils/system-layout.uts'
	import { StorageKeys } from '../../utils/storage-keys.uts'
	import { fetchUserProfile, saveUserRealName, updateUserProfile } from '../../utils/user-services.uts'

	const statusBarHeight = getStatusBarHeight()
	const isLoggedIn = ref(false)
	const currentPhone = ref('')
	const realNameVerified = ref(false)
	const isRealNameSheetVisible = ref(false)
	const isPhoneSheetVisible = ref(false)
	const realNameInput = ref('')
	const idCardInput = ref('')
	const newPhoneInput = ref('')
	let isSavingRealName = false
	let isSavingPhone = false
	let isNavigating = false

	const phoneText = computed((): string => {
		const p = currentPhone.value
		if (p.length === 11) return p.substring(0, 3) + ' **** ' + p.substring(7)
		if (p.length > 0) return p
		return '未绑定'
	})

	onShow(() => {
		const token = uni.getStorageSync(StorageKeys.authToken)
		isLoggedIn.value = token != null && token.toString().length > 0
		if (isLoggedIn.value) {
			fetchUserProfile().then((profile) => {
				currentPhone.value = profile.phone != null ? profile.phone.toString() : ''
				if (!isSavingRealName) {
					realNameVerified.value = profile.realNameVerified === true
					realNameInput.value = profile.realName != null ? profile.realName.toString() : ''
				}
			}).catch((_err) => {
				currentPhone.value = ''
				if (!isSavingRealName) {
					realNameVerified.value = false
				}
			})
		} else {
			currentPhone.value = ''
			realNameVerified.value = false
			realNameInput.value = ''
			idCardInput.value = ''
		}
	})

	const goBack = () => {
		if (isNavigating) return
		isNavigating = true
		uni.navigateBack()
	}

	const handleAction = (name: string) => {
		uni.showToast({ title: name + '功能开发中', icon: 'none' })
	}

	const openLegal = (type: string) => {
		uni.navigateTo({ url: '/pages/mine/legal?type=' + type })
	}

	const validatePhone = (phone: string): boolean => {
		if (phone.length !== 11 || phone.charAt(0) !== '1') {
			uni.showToast({ title: '请输入正确的11位手机号', icon: 'none' })
			return false
		}
		for (let i = 0; i < phone.length; i++) {
			const code = phone.charCodeAt(i)
			if (code < 48 || code > 57) {
				uni.showToast({ title: '手机号只能包含数字', icon: 'none' })
				return false
			}
		}
		return true
	}

	const validateRealName = (name: string): boolean => {
		if (name.length < 2 || name.length > 30) {
			uni.showToast({ title: '请输入正确的真实姓名', icon: 'none' })
			return false
		}
		return true
	}

	const validateIdCard = (idCard: string): boolean => {
		if (idCard.length !== 18) {
			uni.showToast({ title: '请输入18位身份证号', icon: 'none' })
			return false
		}
		for (let i = 0; i < idCard.length; i++) {
			const code = idCard.charCodeAt(i)
			if (i < 17) {
				if (code < 48 || code > 57) {
					uni.showToast({ title: '身份证号格式不正确', icon: 'none' })
					return false
				}
			} else if (!((code >= 48 && code <= 57) || code === 88 || code === 120)) {
				uni.showToast({ title: '身份证号格式不正确', icon: 'none' })
				return false
			}
		}
		return true
	}

	const handleRealNameVerify = () => {
		if (!isLoggedIn.value) {
			uni.showToast({ title: '请先登录', icon: 'none' })
			return
		}
		if (realNameVerified.value) {
			uni.showModal({
				title: '修改实名信息',
				content: '当前账号已保存实名信息，是否前往修改？',
				confirmText: '修改',
				cancelText: '取消',
				success: (res) => {
					if (res.confirm) {
						idCardInput.value = ''
						isRealNameSheetVisible.value = true
					}
				}
			})
			return
		}
		isRealNameSheetVisible.value = true
	}

	const closeRealNameSheet = () => {
		isRealNameSheetVisible.value = false
	}

	const handleSaveRealName = () => {
		if (isSavingRealName) return
		const name = realNameInput.value.trim()
		const idCard = idCardInput.value.trim().toUpperCase()
		if (!validateRealName(name)) return
		if (!validateIdCard(idCard)) return

		isSavingRealName = true
		uni.showLoading({ title: '保存中...' })
		saveUserRealName({
			realName: name,
			idCard
		}).then((profile) => {
			uni.hideLoading()
			isSavingRealName = false
			isRealNameSheetVisible.value = false
			realNameInput.value = profile.realName != null ? profile.realName.toString() : name
			idCardInput.value = ''
			realNameVerified.value = profile.realNameVerified === true
			uni.showToast({ title: '实名信息已保存', icon: 'success' })
		}).catch((err) => {
			uni.hideLoading()
			isSavingRealName = false
			const message = err != null && err.message != null ? err.message.toString() : '实名信息保存失败'
			uni.showToast({ title: message.length > 0 ? message : '实名信息保存失败', icon: 'none' })
		})
	}

	const handleChangePhone = () => {
		if (!isLoggedIn.value) {
			uni.showToast({ title: '请先登录', icon: 'none' })
			return
		}
		newPhoneInput.value = currentPhone.value
		isPhoneSheetVisible.value = true
	}

	const closePhoneSheet = () => {
		if (isSavingPhone) return
		isPhoneSheetVisible.value = false
	}

	const handleSavePhone = () => {
		if (isSavingPhone) return
		const phone = newPhoneInput.value.trim()
		if (!validatePhone(phone)) return
		if (phone === currentPhone.value) {
			uni.showToast({ title: '手机号未变化', icon: 'none' })
			return
		}
		isSavingPhone = true
		uni.showLoading({ title: '保存中...' })
		updateUserProfile({ phone }).then((profile) => {
			uni.hideLoading()
			isSavingPhone = false
			isPhoneSheetVisible.value = false
			currentPhone.value = profile.phone != null ? profile.phone.toString() : phone
			newPhoneInput.value = currentPhone.value
			uni.setStorageSync(StorageKeys.userPhone, currentPhone.value)
			uni.showToast({ title: '手机号已更新', icon: 'success' })
		}).catch((err) => {
			uni.hideLoading()
			isSavingPhone = false
			const message = err != null && err.message != null ? err.message.toString() : '手机号修改失败'
			uni.showToast({ title: message.length > 0 ? message : '手机号修改失败', icon: 'none' })
		})
	}

	const handleLogout = () => {
		if (isNavigating) return
		uni.showModal({
			title: '确定退出登录吗？',
			confirmColor: '#DC2626',
			success: (res) => {
				if (res.confirm) {
					isNavigating = true
					uni.removeStorageSync(StorageKeys.authToken)
					uni.removeStorageSync(StorageKeys.userNickname)
					uni.removeStorageSync(StorageKeys.userPhone)
					uni.removeStorageSync(StorageKeys.userGender)
					uni.removeStorageSync(StorageKeys.userRegion)
					uni.removeStorageSync(StorageKeys.userAvatarTheme)
					uni.removeStorageSync(StorageKeys.userStudyNo)
					uni.removeStorageSync(StorageKeys.userPuzzleCollected)
					uni.removeStorageSync('user_points')
					uni.removeStorageSync('user_point_records')
					uni.removeStorageSync(StorageKeys.userAddresses)
					uni.removeStorageSync(StorageKeys.userInvoiceTitles)
					uni.removeStorageSync(StorageKeys.userFeedbackList)
					uni.removeStorageSync(StorageKeys.travelersList)
					uni.removeStorageSync(StorageKeys.mallCart)
					uni.removeStorageSync(StorageKeys.mallFavorites)
					uni.removeStorageSync(StorageKeys.studyBookedProjectIds)
					uni.showToast({ title: '已安全退出', icon: 'none' })
					setTimeout(() => {
						uni.navigateBack()
					}, 600)
				}
			}
		})
	}
</script>

<style>
	.page {
		border-width: 0;
		border-color: #FFFFFF;
		flex: 1;
		background-color: #F5F7FB;
	}
	.status-bar {
		border-width: 0;
		border-color: #FFFFFF;
		width: 100%;
		background-color: #FFFFFF;
	}
	.nav-bar {
		background-color: #FFFFFF;
		border-width: 0;
		border-color: #FFFFFF;
		height: 48px;
		padding: 0 16px;
		flex-direction: row;
		align-items: center;
		position: relative;
	}
	.nav-back {
		flex-direction: row;
		align-items: center;
		z-index: 1;
		border-width: 0;
	}
	.nav-back-icon {
		width: 18px;
		height: 18px;
		margin-right: 4px;
		border-width: 0;
	}
	.nav-back-text {
		font-size: 16px;
		color: #1A1A1A;
		font-weight: 500;
		border-width: 0;
	}
	.nav-title {
		position: absolute;
		left: 0;
		right: 0;
		text-align: center;
		font-size: 17px;
		font-weight: 700;
		color: #1A1A1A;
		border-width: 0;
	}
	.body {
		flex: 1;
		padding: 8px 16px 0 16px;
	}
	.set-card {
		position: relative;
		margin-bottom: 28px;
		overflow: visible;
		background-color: transparent;
	}
	.set-glass {
		position: absolute;
		left: 0;
		top: 0;
		right: 0;
		bottom: 0;
		border-radius: 16px;
		background-color: #FFFFFF;
		overflow: visible;
		z-index: 0;
		box-shadow: none;
	}
	.set-line {
		position: absolute;
		left: 0;
		top: 0;
		right: 0;
		bottom: 0;
		border-radius: 16px;
		border-width: 1px;
		border-style: solid;
		border-color: #E5E7EB;
		z-index: 2;
		pointer-events: none;
	}
	.set-body {
		position: relative;
		z-index: 1;
		background-color: transparent;
		overflow: visible;
		padding: 14px 16px 4px 16px;
	}
	.set-head {
		font-size: 17px;
		font-weight: 800;
		color: #1A1A1A;
		align-self: flex-start;
		padding-bottom: 6px;
		margin-bottom: 4px;
		border-bottom-width: 2px;
		border-bottom-style: solid;
		border-bottom-color: #1A73E8;
	}
	.row {
		height: 48px;
		align-items: center;
	}
	.row-label {
		flex: 1;
		font-size: 15px;
		font-weight: 700;
		color: #1A1A1A;
	}
	.row-val {
		font-size: 13px;
		font-weight: 700;
		color: #1A73E8;
	}
	.row-val-ok {
		color: #4B5563;
	}
	.line {
		height: 1px;
		background-color: #E5E7EB;
	}
	.logout {
		margin-top: 28px;
		height: 48px;
		border-radius: 24px;
		background-color: #FFFFFF;
		align-items: center;
		justify-content: center;
		border-width: 1px;
		border-style: solid;
		border-color: #E5E7EB;
	}
	.logout-text {
		font-size: 15px;
		font-weight: 800;
		color: #DC2626;
	}
	.copy {
		margin-top: 20px;
		text-align: center;
		font-size: 12px;
		color: #374151;
	}
	.pad {
		height: 32px;
	}
	.mask {
		position: fixed;
		left: 0;
		right: 0;
		top: 0;
		bottom: 0;
		background-color: rgba(32, 33, 36, 0.4);
		justify-content: center;
		align-items: center;
		padding: 24px;
	}
	.sheet {
		width: 100%;
		background-color: #FFFFFF;
		border-radius: 16px;
		padding: 18px 20px 20px 20px;
		border-width: 1px;
		border-style: solid;
		border-color: #E5E7EB;
	}
	.sheet-head {
		align-items: center;
		margin-bottom: 16px;
	}
	.sheet-title {
		flex: 1;
		font-size: 17px;
		font-weight: 800;
		color: #1A1A1A;
	}
	.sheet-close {
		font-size: 14px;
		font-weight: 700;
		color: #374151;
	}
	.sheet-label {
		font-size: 13px;
		font-weight: 800;
		color: #1A1A1A;
		margin-bottom: 8px;
	}
	.sheet-input {
		height: 48px;
		border-radius: 12px;
		background-color: #F5F7FB;
		padding: 0 14px;
		font-size: 16px;
		color: #1A1A1A;
		margin-bottom: 14px;
	}
	.sheet-btn {
		height: 48px;
		border-radius: 24px;
		background-color: #1A73E8;
		align-items: center;
		justify-content: center;
		margin-top: 4px;
	}
	.sheet-btn-text{
		font-size: 16px;
		font-weight: 800;
		color: #FFFFFF;
	}
</style>
