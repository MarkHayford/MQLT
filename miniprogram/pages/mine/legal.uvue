<template>
	<view class="page uni-column">
		<view class="status-bar" :style="{ height: statusBarHeight + 'px' }"></view>
		<view class="nav-bar">
			<view class="nav-back" @click="goBack">
				<image src="/static/auth-back.svg" class="nav-back-icon" mode="aspectFit"></image>
				<text class="nav-back-text">返回</text>
			</view>
			<text class="nav-title">{{ doc.title }}</text>
		</view>

		<scroll-view class="body" scroll-y="true" show-scrollbar="false">
			<view class="intro-card uni-column">
				<text class="intro">{{ doc.intro }}</text>
				<text class="updated">更新日期：{{ doc.updatedAt }}</text>
			</view>
			<view v-for="(sec, i) in doc.sections" :key="i" class="sec uni-column">
				<text class="heading">{{ sec.heading }}</text>
				<text class="body-text">{{ sec.body }}</text>
			</view>
			<view class="pad"></view>
		</scroll-view>
	</view>
</template>

<script setup lang="uts">
	import { ref } from 'vue'
	import { onLoad } from '@dcloudio/uni-app'
	import { getStatusBarHeight } from '../../utils/system-layout.uts'
	import { getLegalDoc, type LegalDoc } from './utils/legal-docs.uts'
	import { fetchPlatformSettings } from '../../utils/platform-settings.uts'

	const statusBarHeight = getStatusBarHeight()
	const doc = ref<LegalDoc>(getLegalDoc('agreement'))

	onLoad((options: OnLoadOptions) => {
		const t = options['type'] != null ? options['type'].toString() : 'agreement'
		doc.value = getLegalDoc(t)
		fetchPlatformSettings().then((p) => {
			const remote = t === 'privacy' ? p.legal.privacy : p.legal.agreement
			if (remote != null && remote.title.length > 0) {
				const next: LegalDoc = {
					title: remote.title,
					updatedAt: remote.updatedAt,
					intro: remote.intro,
					sections: []
				}
				if (remote.sections != null) {
					for (let i = 0; i < remote.sections.length; i++) {
						next.sections.push({ heading: remote.sections[i].heading, body: remote.sections[i].body })
					}
				}
				if (next.sections.length > 0) doc.value = next
			}
		}).catch((_err) => {})
	})

	const goBack = () => {
		uni.navigateBack()
	}
</script>

<style>
	.page {
		border-width: 0;
		border-color: #FFFFFF;
		flex: 1;
		background-color: #F5F7FB;
	}
	.status-bar {
		border-width: 0;
		border-color: #FFFFFF;
		width: 100%;
		background-color: #FFFFFF;
	}
	.nav-bar {
		background-color: #FFFFFF;
		border-width: 0;
		border-color: #FFFFFF;
		height: 48px;
		padding: 0 16px;
		flex-direction: row;
		align-items: center;
		position: relative;
	}
	.nav-back {
		flex-direction: row;
		align-items: center;
		z-index: 1;
	}
	.nav-back-icon {
		width: 18px;
		height: 18px;
		margin-right: 4px;
	}
	.nav-back-text {
		font-size: 16px;
		color: #1A1A1A;
		font-weight: 500;
	}
	.nav-title {
		position: absolute;
		left: 0;
		right: 0;
		text-align: center;
		font-size: 17px;
		font-weight: 700;
		color: #1A1A1A;
	}
	.body {
		flex: 1;
		padding: 8px 16px 0 16px;
	}
	.intro-card {
		background-color: #1A73E8;
		border-radius: 16px;
		padding: 18px 16px 16px 16px;
		margin-bottom: 14px;
		border-width: 0;
		border-color: #1A73E8;
	}
	.intro {
		font-size: 14px;
		color: rgba(255, 248, 238, 0.9);
		line-height: 22px;
	}
	.updated {
		margin-top: 10px;
		font-size: 12px;
		color: #1A73E8;
	}
	.sec {
		background-color: #FFFFFF;
		border-radius: 16px;
		padding: 16px;
		margin-bottom: 10px;
		border-width: 1px;
		border-style: solid;
		border-color: #E5E7EB;
	}
	.heading {
		font-size: 15px;
		font-weight: 800;
		color: #1A1A1A;
		margin-bottom: 8px;
	}
	.body-text {
		font-size: 14px;
		color: #374151;
		line-height: 22px;
	}
	.pad {
		height: 28px;
	}
</style>
