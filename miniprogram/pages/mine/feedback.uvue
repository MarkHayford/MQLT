		color: #1A1A1A;
	}
	.chip-text-on{
		color: #FFFFFF;
	}
	.textarea {
		width: 100%;
		min-height: 120px;
		font-size: 15px;
		color: #1A1A1A;
		line-height: 22px;
		padding: 12px;
		background-color: #E8EEF8;
		border-width: 1px;
		border-style: solid;
		border-color: #C5D0E0;
		border-radius: 12px;
	}
	.count {
		font-size: 12px;
		color: #374151;
		text-align: right;
		margin-top: 6px;
	}
	.input {
		height: 40px;
		font-size: 15px;
		color: #1A1A1A;
		padding: 0 12px;
		background-color: #E8EEF8;
		border-width: 1px;
		border-style: solid;
		border-color: #C5D0E0;
		border-radius: 20px;
	}
	.submit-wrap {
		margin: 8px 0 12px 0;
	}
	.submit-btn {
		height: 48px;
		border-radius: 24px;
		background-color: #1A73E8;
		align-items: center;
		justify-content: center;
	}
	.submit-off {
		opacity: 0.45;
	}
	.submit-btn-text {
		font-size: 16px;
		font-weight: 800;
		color: #FFFFFF;
	}
	.pad {
