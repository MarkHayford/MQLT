		font-size: 16px;
		color: #1A1A1A;
		font-weight: 500;
	}
	.nav-title {
		position: absolute;
		left: 0;
		right: 0;
		text-align: center;
		font-size: 17px;
		font-weight: 700;
		color: #1A1A1A;
	}
	.filter-bar {
		margin: 0 16px 12px 16px;
		height: 36px;
		padding: 3px;
		background-color: #FFFFFF;
		border-radius: 12px;
		border-width: 1px;
		border-style: solid;
		border-color: #E5E7EB;
		align-items: center;
	}
	.f-chip {
		flex: 1;
		height: 30px;
		border-radius: 9px;
		background-color: transparent;
		align-items: center;
		justify-content: center;
		border-width: 0;
	}
	.f-chip-on {
		background-color: #1A73E8;
		border-width: 0;
	}
	.f-chip-text {
		font-size: 13px;
		font-weight: 700;
		color: #1A1A1A;
	}
	.f-chip-text-on{
		color: #FFFFFF;
	}
	.body {
		flex: 1;
		padding: 0 16px;
	}
	.card {
		background-color: #FFFFFF;
		border-radius: 16px;
		padding: 14px 16px;
		margin-bottom: 10px;
		border-width: 1px;
		border-style: solid;
		border-color: #E5E7EB;
	}
	.card-top {
		align-items: center;
		margin-bottom: 8px;
	}
	.type-text {
		flex: 1;
		font-size: 13px;
		font-weight: 800;
		color: #1A1A1A;
	}
	.st {
		font-size: 12px;
		font-weight: 700;
		color: #1A73E8;
	}
	.st-ok {
		color: #1A1A1A;
	}
	.st-mute {
		color: #374151;
	}
	.content {
		font-size: 14px;
		color: #374151;
		line-height: 22px;
	}
	.reply {
		margin-top: 10px;
		padding: 10px 12px;
		background-color: #FFFFFF;
		border-radius: 10px;
	}
	.reply-label {
		font-size: 12px;
		font-weight: 800;
		color: #1A1A1A;
		margin-bottom: 4px;
	}
	.reply-text {
		font-size: 13px;
		color: #374151;
		line-height: 20px;
	}
	.card-foot {
		margin-top: 10px;
		align-items: center;
	}
	.time {
		flex: 1;
		font-size: 12px;
		color: #374151;
	}
	.withdraw {
		font-size: 12px;
		font-weight: 700;
		color: #1A73E8;
	}
	.empty {
		padding: 64px 16px;
		align-items: center;
	}
	.empty-t {
		font-size: 15px;
		color: #374151;
		margin-bottom: 16px;
	}
	.empty-btn {
		height: 40px;
		padding: 0 22px;
		border-radius: 20px;
		background-color: #1A73E8;
		align-items: center;
		justify-content: center;
	}
	.empty-btn-text{
		font-size: 14px;
		font-weight: 800;
		color: #FFFFFF;
	}
	.pad {
		height: 24px;
	}
</style>
