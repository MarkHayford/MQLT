export const PRIVACY_POLICY: LegalDoc = {
	title: '隐私政策',
	updatedAt: '2026年9月10日',
	intro: '蒙企链探重视您的个人信息保护。本政策说明我们如何收集、使用、存储和保护您的信息。使用本小程序前，请仔细阅读。未满十四周岁用户请在监护人陪同下阅读并征得同意。',
	sections: [
		{
			heading: '一、我们收集的信息',
			body: '1. 账号信息：微信昵称、头像、OpenID 等授权信息，以及您完善的手机号、真实姓名、证件号。\n2. 研学信息：预约订单、游客资料、结业证书。\n3. 位置信息：在选点租车时，经您同意后获取定位。\n4. 交易信息：订单、支付状态、卡券、地址、发票抬头。\n5. 内容信息：您发布的研学体验、评论、反馈与客服会话。\n6. 设备信息：用于保障运行安全的基本设备与日志信息。'
		},
		{
			heading: '二、使用目的',
			body: '用于完成登录与身份核验、研学预约与现场服务、商城下单与配送、卡券与成果展示、客户服务与安全风控，以及在依法合规前提下改进产品体验。我们不会将您的信息用于与上述目的无关的用途。'
		},
		{
			heading: '三、共享与披露',
			body: '我们不会出售您的个人信息。仅在以下情形共享或披露：获得您的同意；完成支付、物流、微信登录等所必需的合作方；法律法规或有权机关要求；保护用户或公众的重大合法权益。'
		},
		{
			heading: '四、存储与保护',
			body: '信息存储于中华人民共和国境内。我们采取合理的安全措施防止未经授权的访问、泄露或篡改，并仅在实现目的所必需的期限内保留。超出期限后将删除或匿名化处理，法律法规另有规定的除外。'
		},
		{
			heading: '五、您的权利',
			body: '您可查询、更正账号资料，管理常用游客与地址，申请开具发票，提交反馈。您可撤回定位等授权（可能影响对应功能）。如需注销账号或删除特定数据，请通过客服热线或邮箱提出，我们将在核实身份后依法处理。'
		},
		{
			heading: '六、未成年人保护',
			body: '本服务面向研学场景，可能涉及未成年人随行。监护人应妥善保管证件与账号。我们不会主动向不满十四周岁的儿童收集非必要信息。如发现误收集，将及时删除。'
		},
		{
			heading: '七、第三方服务',
			body: '本小程序基于微信平台运行，登录、支付、客服会话等可能调用微信提供的能力。相关处理同时适用微信的隐私政策。请您在授权前阅读微信相关提示。'
		},
		{
			heading: '八、政策更新',
			body: '我们可能适时修订本政策，并在小程序内公布。重大变更将通过页面提示等方式告知。继续使用即表示您了解更新后的政策。'
