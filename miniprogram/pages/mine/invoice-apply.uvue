		align-items: center;
		border-width: 1px;
		border-style: solid;
		border-color: #E5E7EB;
	}

	.tip-icon {
		width: 18px;
		height: 18px;
		margin-right: 8px;
	}

	.tip-text {
		font-size: 13px;
		color: #374151;
		font-weight: 500;
		flex: 1;
	}

	.order-list {
		padding: 0 16px;
	}

	.order-card {
		background-color: #FFFFFF;
		border-radius: 16px;
		padding: 16px;
		margin-bottom: 12px;
		flex-direction: row;
		border-width: 1px;
		border-style: solid;
		border-color: #E5E7EB;
	}

	.order-selected {
		border-color: #1A1A1A;
		background-color: #FFFFFF;
	}

	.checkbox-wrap {
		margin-right: 12px;
		padding-top: 2px;
	}

	.checkbox {
		width: 22px;
		height: 22px;
		border-radius: 11px;
		border-width: 1.5px;
		border-style: solid;
		border-color: #E5E7EB;
