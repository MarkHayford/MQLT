<template>
	<view class="page-wrapper" :style="pageStyle">
		<view class="fixed-header">
			<view class="status-bar" :style="statusBarStyle"></view>
			<view class="nav-bar">
				<view class="nav-back" @click="goBack">
					<image src="/static/auth-back.svg" class="nav-back-icon" mode="aspectFit"></image>
					<text class="nav-back-text">返回</text>
				</view>
				<text class="nav-title">申请开发票</text>
			</view>

			<view class="order-type-tabs uni-row">
				<view :class="['tab-item', orderType === 'all' ? 'tab-active' : '']" @click="switchOrderType('all')">
					<text :class="['tab-text', orderType === 'all' ? 'tab-text-active' : '']">全部</text>
				</view>
				<view :class="['tab-item', orderType === 'mall' ? 'tab-active' : '']" @click="switchOrderType('mall')">
					<text :class="['tab-text', orderType === 'mall' ? 'tab-text-active' : '']">文创</text>
				</view>
				<view :class="['tab-item', orderType === 'study' ? 'tab-active' : '']" @click="switchOrderType('study')">
					<text :class="['tab-text', orderType === 'study' ? 'tab-text-active' : '']">研学</text>
				</view>
				<view :class="['tab-item', orderType === 'rental' ? 'tab-active' : '']" @click="switchOrderType('rental')">
					<text :class="['tab-text', orderType === 'rental' ? 'tab-text-active' : '']">租车</text>
				</view>
			</view>
		</view>

		<scroll-view class="main-scroll" :style="mainScrollStyle" scroll-y="true" :show-scrollbar="false" :bounces="true">
			<view class="tip-banner">
				<image src="/static/icon-lightbulb.svg" class="tip-icon" mode="aspectFit"></image>
				<text class="tip-text">请选择同一开票方的订单（平台租车 / 企业文创研学不可混选）</text>
			</view>

			<view class="order-list">
				<view
					v-for="(order, index) in currentOrderList"
					:key="order.sourceType + ':' + order.id"
					:class="['order-card', isOrderSelected(order) ? 'order-selected' : '']"
					@click="toggleOrderSelect(order)"
				>
					<view class="checkbox-wrap">
						<view :class="['checkbox', isOrderSelected(order) ? 'checkbox-checked' : '']">
							<image v-if="isOrderSelected(order)" src="/static/icon-check.svg" class="checkbox-icon" mode="aspectFit"></image>
						</view>
					</view>

					<view class="order-content">
						<view class="order-header uni-row">
							<text class="order-title">{{ order.title }}</text>
							<view :class="['order-status-tag', getOrderStatusClass(order.status)]">
								<text class="order-status-text">{{ order.status }}</text>
							</view>
						</view>

						<view class="order-info-row uni-row">
							<text class="order-label">类型</text>
							<text class="order-value">{{ sourceTypeLabel(order.sourceType) }}</text>
						</view>

						<view class="order-info-row uni-row">
							<text class="order-label">开票方</text>
							<view class="issuer-chip">
								<text class="issuer-chip-text">{{ order.issuerLabel }}</text>
							</view>
						</view>

						<view class="order-info-row uni-row">
							<text class="order-label">订单编号</text>
							<text class="order-value">{{ order.orderNo }}</text>
						</view>

						<view class="order-info-row uni-row">
							<text class="order-label">时间</text>
							<text class="order-value">{{ order.orderTime }}</text>
						</view>

						<view class="order-info-row uni-row">
							<text class="order-label">订单金额</text>
							<text class="order-amount">¥{{ order.amount }}</text>
						</view>

						<view v-if="order.invoiceStatus" class="invoice-status-row">
							<text class="invoice-status-text">{{ order.invoiceStatus }}</text>
						</view>
					</view>
				</view>

				<view v-if="currentOrderList.length === 0" class="empty-state">
					<image src="/static/shop-nav-orders.svg" class="empty-icon" mode="aspectFit"></image>
					<text class="empty-text">暂无可开票订单</text>
					<text class="empty-hint">已支付的文创、研学与租车订单可申请开票</text>
				</view>
			</view>

			<view class="bottom-spacer"></view>
		</scroll-view>

		<view class="bottom-action-bar">
			<view class="selected-info uni-row">
				<text class="selected-text">已选 {{ selectedKeys.length }} 个订单</text>
				<text class="total-amount">合计：¥{{ totalAmount }}</text>
			</view>
			<view :class="['submit-btn', selectedKeys.length === 0 ? 'submit-btn-disabled' : '']" @click="submitInvoiceApply">
				<text class="submit-btn-text">下一步</text>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { ref, computed } from 'vue'
	import { onLoad, onShow } from '@dcloudio/uni-app'
	import { getLayoutWindowInfo } from '../../utils/system-layout.uts'
	import { fetchEligibleInvoiceOrders } from '../../utils/user-services.uts'

	const layout = getLayoutWindowInfo()
	const statusBarHeight = layout.statusBarHeight
	const windowHeight = layout.windowHeight
	const screenHeight = layout.screenHeight
	const navBarHeight = 44
	const tabsHeight = 50
	const headerTotalHeight = statusBarHeight + navBarHeight + tabsHeight

	const pageStyle = 'height: ' + screenHeight + 'px;'
	const statusBarStyle = 'height: ' + statusBarHeight + 'px;'
	const mainScrollStyle = 'top: ' + headerTotalHeight + 'px; height: ' + (windowHeight - headerTotalHeight) + 'px;'

	type Order = {
		id: string
		sourceType: string
		title: string
		orderNo: string
		orderTime: string
		amount: string
		status: string
		invoiceStatus: string
		issuerType: string
		enterpriseId: string
		issuerLabel: string
	}

	const orderType = ref('all')
	const selectedKeys = ref<string[]>([])
	const preselectKey = ref('')
	const allOrders = ref<Order[]>([])

	const currentOrderList = computed((): Order[] => {
		if (orderType.value === 'mall') {
			return allOrders.value.filter((o) => o.sourceType === 'MALL_ORDER')
		}
		if (orderType.value === 'study') {
			return allOrders.value.filter((o) => o.sourceType === 'STUDY_BOOKING')
		}
		if (orderType.value === 'rental') {
			return allOrders.value.filter((o) => o.sourceType === 'RENTAL_ORDER')
		}
		return allOrders.value
	})

	const sourceTypeLabel = (sourceType: string): string => {
		if (sourceType === 'STUDY_BOOKING') return '研学预约'
		if (sourceType === 'RENTAL_ORDER') return '租车'
		return '文创商城'
	}

	const orderIssuerKey = (order: Order): string => {
		if (order.issuerType === 'PLATFORM') return 'PLATFORM'
		return 'ENTERPRISE:' + order.enterpriseId
	}

	const totalAmount = computed((): string => {
		let total = 0
		for (let i = 0; i < selectedKeys.value.length; i++) {
			const key = selectedKeys.value[i]
			const order = allOrders.value.find((o) => (o.sourceType + ':' + o.id) === key)
			if (order != null) {
				total += parseFloat(order.amount)
			}
		}
		return total.toFixed(2)
	})

	const switchOrderType = (type: string) => {
		orderType.value = type
	}

	const isOrderSelected = (order: Order): boolean => {
		return selectedKeys.value.includes(order.sourceType + ':' + order.id)
	}

	const toggleOrderSelect = (order: Order) => {
		if (order.invoiceStatus.length > 0) {
			uni.showToast({ title: '该订单' + order.invoiceStatus, icon: 'none' })
			return
		}
		const key = order.sourceType + ':' + order.id
		const index = selectedKeys.value.indexOf(key)
		if (index > -1) {
			selectedKeys.value.splice(index, 1)
			return
		}
		if (selectedKeys.value.length > 0) {
			const firstKey = selectedKeys.value[0]
			const first = allOrders.value.find((o) => (o.sourceType + ':' + o.id) === firstKey)
			if (first != null && orderIssuerKey(first) !== orderIssuerKey(order)) {
				uni.showToast({ title: '不可混选不同开票方', icon: 'none' })
				return
			}
		}
		selectedKeys.value.push(key)
	}

	const getOrderStatusClass = (status: string): string => {
		if (status === '已完成' || status === 'COMPLETED') return 'status-completed'
		if (status === '待使用' || status === 'UNUSED' || status === 'BOOKED') return 'status-pending'
		return 'status-default'
	}

	const formatTime = (value: any): string => {
		if (value == null) return ''
		const text = value.toString().replace('T', ' ')
		if (text.length >= 16) return text.substring(0, 16)
		return text
	}

	const statusLabel = (sourceType: string, status: string): string => {
		const s = status != null ? status.toString() : ''
		if (sourceType === 'STUDY_BOOKING') {
			if (s === 'BOOKED') return '已预约'
			if (s === 'COMPLETED') return '已完成'
			return s
		}
		if (sourceType === 'RENTAL_ORDER') {
			if (s === 'PAID') return '已支付'
			if (s === 'EN_ROUTE') return '前往中'
			if (s === 'ARRIVED') return '已到达'
			if (s === 'IN_TRIP') return '行程中'
			if (s === 'COMPLETED') return '已完成'
			return s
		}
		if (s === 'COMPLETED') return '已完成'
		if (s === 'PAID') return '待发货'
		if (s === 'UNRECEIVED') return '待收货'
		if (s === 'UNUSED') return '待使用'
		return s
	}

	const loadOrders = () => {
		fetchEligibleInvoiceOrders<any>().then((list) => {
			const mapped: Order[] = []
			for (let i = 0; i < list.length; i++) {
				const raw = list[i]
				const sourceType = raw['sourceType'] != null ? (raw['sourceType'] as string) : 'MALL_ORDER'
				const inv = raw['invoiceStatus'] != null ? (raw['invoiceStatus'] as string) : ''
				mapped.push({
					id: raw['id'] as string,
					sourceType,
					title: raw['title'] != null ? (raw['title'] as string) : '订单',
					orderNo: raw['orderNo'] != null ? (raw['orderNo'] as string) : (raw['id'] as string),
					orderTime: formatTime(raw['time']),
					amount: raw['amount'] != null ? raw['amount'].toString() : '0',
					status: statusLabel(sourceType, raw['status'] != null ? raw['status'].toString() : ''),
					invoiceStatus: inv,
					issuerType: raw['issuerType'] != null ? (raw['issuerType'] as string) : 'ENTERPRISE',
					enterpriseId: raw['enterpriseId'] != null ? (raw['enterpriseId'] as string) : '',
					issuerLabel: raw['issuerLabel'] != null ? (raw['issuerLabel'] as string) : '企业'
				})
			}
			allOrders.value = mapped
			if (preselectKey.value.length > 0) {
				const pref = mapped.find((o) => (o.sourceType + ':' + o.id) === preselectKey.value)
				if (pref != null && pref.invoiceStatus.length === 0 && selectedKeys.value.indexOf(preselectKey.value) < 0) {
					selectedKeys.value = [preselectKey.value]
					if (pref.sourceType === 'MALL_ORDER') orderType.value = 'mall'
					else if (pref.sourceType === 'STUDY_BOOKING') orderType.value = 'study'
					else if (pref.sourceType === 'RENTAL_ORDER') orderType.value = 'rental'
				}
			}
			const valid: string[] = []
			for (let i = 0; i < selectedKeys.value.length; i++) {
				const key = selectedKeys.value[i]
				const hit = mapped.find((o) => (o.sourceType + ':' + o.id) === key)
				if (hit != null && hit.invoiceStatus.length === 0) valid.push(key)
			}
			selectedKeys.value = valid
		}).catch((_err) => {
			allOrders.value = []
			uni.showToast({ title: '订单加载失败', icon: 'none' })
		})
	}

	const submitInvoiceApply = () => {
		if (selectedKeys.value.length === 0) {
			uni.showToast({ title: '请选择订单', icon: 'none' })
			return
		}
		const items: string[] = []
		for (let i = 0; i < selectedKeys.value.length; i++) {
			items.push(selectedKeys.value[i])
		}
		uni.navigateTo({
			url: '/pages/mine/invoice-form?items=' + encodeURIComponent(items.join(',')) + '&amount=' + totalAmount.value
		})
	}

	const goBack = () => {
		uni.navigateBack()
	}

	onLoad((query: any) => {
		const raw = query != null && query['preselect'] != null ? String(query['preselect']) : ''
		preselectKey.value = raw.length > 0 ? decodeURIComponent(raw) : ''
		loadOrders()
	})

	onShow(() => {
		loadOrders()
	})
</script>

<style>
