		background-color: #FFFFFF;
	}

	.checkbox-checked {
		background-color: #1A73E8;
		border-color: #1A1A1A;
	}

	.checkbox-icon {
		width: 14px;
		height: 14px;
	}

	.order-content {
		flex: 1;
	}

	.order-header {
		justify-content: space-between;
		align-items: flex-start;
		margin-bottom: 12px;
	}

	.order-title {
		font-size: 16px;
		color: #1A1A1A;
		font-weight: 600;
		flex: 1;
		margin-right: 8px;
	}

	.order-status-tag {
		padding: 4px 10px;
		border-radius: 8px;
		flex-shrink: 0;
	}

	.status-completed {
		background-color: #1A73E8;
	}

	.status-pending {
		background-color: #1A73E8;
	}

	.status-default {
		background-color: #FFFFFF;
	}

	.order-status-text {
		font-size: 12px;
		font-weight: 700;
	}

	.status-completed .order-status-text {
		color: #1A73E8;
	}

	.status-pending .order-status-text {
		color: #1A1A1A;
	}

	.status-default .order-status-text {
		color: #1A1A1A;
	}

	.order-info-row {
