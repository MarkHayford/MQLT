		height: 50px;
		padding: 0 16px;
		align-items: center;
	}

	.tab-item {
		flex: 1;
		height: 36px;
		align-items: center;
		justify-content: center;
		border-radius: 18px;
		margin: 0 4px;
		background-color: #E8EEF8;
		border-width: 1px;
		border-style: solid;
		border-color: #C5D0E0;
}

	.tab-active {
		background-color: #1A73E8;
		border-width: 1px;
		border-style: solid;
		border-color: #1A73E8;
}

	.tab-text {
		font-size: 14px;
		color: #1A1A1A;
