	}

	.tab-text-active {
		color: #FFFFFF;
		font-weight: 800;
	}

	.main-scroll {
		position: absolute;
		left: 0;
		right: 0;
	}

	.tip-banner {
		margin: 16px 16px 12px 16px;
		padding: 12px 16px;
