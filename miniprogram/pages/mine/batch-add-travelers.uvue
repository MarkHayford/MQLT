		color: #374151;
	}
	.parse-input {
		width: 100%;
		min-height: 80px;
		font-size: 14px;
		color: #1A1A1A;
		line-height: 22px;
	}
	.parse-btn {
		margin-top: 12px;
		height: 40px;
		border-radius: 20px;
		background-color: #1A73E8;
		align-items: center;
		justify-content: center;
	}
	.parse-btn-text{
		font-size: 14px;
