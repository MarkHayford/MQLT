	}
	.remove {
		font-size: 13px;
		font-weight: 700;
		color: #1A73E8;
	}
	.field {
		height: 44px;
		align-items: center;
	}
	.field-label {
		width: 56px;
		font-size: 14px;
		color: #374151;
	}
	.field-input {
		flex: 1;
		height: 44px;
		font-size: 15px;
		color: #1A1A1A;
	}
	.line {
		height: 1px;
		background-color: #FFFFFF;
	}
	.add-row {
		height: 48px;
		border-radius: 16px;
		align-items: center;
		justify-content: center;
		margin-bottom: 8px;
		background-color: #FFFFFF;
		border-width: 1px;
		border-style: solid;
		border-color: #E5E7EB;
	}
	.add-row-text {
		font-size: 14px;
