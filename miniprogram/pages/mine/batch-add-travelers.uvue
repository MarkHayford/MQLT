<template>
	<view class="page uni-column">
		<view class="status-bar" :style="{ height: statusBarHeight + 'px' }"></view>
		<view class="nav-bar">
			<view class="nav-back" @click="goBack">
				<image src="/static/auth-back.svg" class="nav-back-icon" mode="aspectFit"></image>
				<text class="nav-back-text">返回</text>
			</view>
			<text class="nav-title">批量添加</text>
		</view>

		<scroll-view class="body" scroll-y="true" show-scrollbar="false">
			<view class="card uni-column">
				<view class="parse-head uni-row">
					<text class="label">粘贴解析</text>
					<text class="clear" @click="rawText = ''">清空</text>
				</view>
				<textarea
					class="parse-input"
					placeholder="每行一位：张三 13800138000 110101199001011234"
					v-model="rawText"
					:auto-height="true"
					placeholder-style="color:#E5E7EB;"
				/>
				<view class="parse-btn" @click="handleSmartParse">
					<text class="parse-btn-text">解析填充</text>
				</view>
			</view>

			<text class="sec-title">待添加 {{ batchList.length }} 人</text>

			<view v-for="(item, index) in batchList" :key="index" class="card uni-column">
				<view class="item-head uni-row">
					<text class="item-no">游客 {{ index + 1 }}</text>
					<text class="remove" @click="removeRow(index)">移除</text>
				</view>
				<view class="field uni-row">
					<text class="field-label">姓名</text>
					<input class="field-input" v-model="item.name" placeholder="姓名" placeholder-style="color:#E5E7EB;" />
				</view>
				<view class="line"></view>
				<view class="field uni-row">
					<text class="field-label">身份证</text>
					<input class="field-input" type="idcard" maxlength="18" v-model="item.idCard" placeholder="身份证号" placeholder-style="color:#E5E7EB;" />
				</view>
				<view class="line"></view>
				<view class="field uni-row">
					<text class="field-label">手机号</text>
					<input class="field-input" type="number" maxlength="11" v-model="item.phone" placeholder="手机号" placeholder-style="color:#E5E7EB;" />
				</view>
			</view>

			<view class="add-row" @click="addNewRow">
				<text class="add-row-text">+ 再加一位</text>
			</view>
			<view class="pad"></view>
		</scroll-view>

		<view class="bar">
			<view class="save" @click="handleBatchSave">
				<text class="save-text">保存 {{ batchList.length }} 人</text>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { ref } from 'vue'

	import { getStatusBarHeight } from '../../utils/system-layout.uts'
	import { createTraveler } from '../../utils/user-services.uts'

	const statusBarHeight = getStatusBarHeight()
	let isNavigating = false

	type Traveler = {
		id: string
		name: string
		phone: string
		idCard: string
		isSelf: boolean
	}

	const rawText = ref('')
	const batchList = ref<Traveler[]>([
		{ id: '', name: '', phone: '', idCard: '', isSelf: false }
	])

	const goBack = () => {
		if (isNavigating) return
		isNavigating = true
		uni.navigateBack()
	}

	const addNewRow = () => {
		batchList.value.push({ id: '', name: '', phone: '', idCard: '', isSelf: false })
	}

	const removeRow = (index: number) => {
		if (batchList.value.length <= 1) {
			batchList.value = [{ id: '', name: '', phone: '', idCard: '', isSelf: false }]
			return
		}
		batchList.value.splice(index, 1)
	}

	const handleSmartParse = () => {
		if (rawText.value.trim().length === 0) {
			uni.showToast({ title: '请输入需要解析的文本', icon: 'none' })
			return
		}

		const lines = rawText.value.split('\n')
		const parsedList: Traveler[] = []

		lines.forEach(line => {
			const parts = line.trim().split(/\s+/)
			if (parts.length >= 1) {
				const traveler: Traveler = {
					id: '',
					name: parts[0] || '',
					phone: '',
					idCard: '',
					isSelf: false
				}

				parts.forEach(part => {
					if (part.length === 11 && !isNaN(parseInt(part))) {
						traveler.phone = part
					} else if ((part.length === 15 || part.length === 18) && part !== traveler.name) {
						traveler.idCard = part
					}
				})

				if (traveler.name.length > 0) {
					parsedList.push(traveler)
				}
			}
		})

		if (parsedList.length > 0) {
			if (batchList.value.length === 1 && batchList.value[0].name === '') {
				batchList.value = parsedList
			} else {
				batchList.value = batchList.value.concat(parsedList)
			}
			rawText.value = ''
			uni.showToast({ title: '解析成功 ' + parsedList.length + ' 位', icon: 'none' })
		} else {
			uni.showToast({ title: '解析失败，请检查格式', icon: 'none' })
		}
	}

	const handleBatchSave = () => {
		if (isNavigating) return

		const validList = batchList.value.filter(item => item.name.trim().length > 0)

		if (validList.length === 0) {
			uni.showToast({ title: '没有可保存的游客信息', icon: 'none' })
			return
		}

		for (let i = 0; i < validList.length; i++) {
			const item = validList[i]
			if (item.phone.length > 0 && item.phone.length !== 11) {
				uni.showToast({ title: '游客 ' + (i+1) + ' 手机号长度不符', icon: 'none' })
				return
			}
			if (item.idCard.length > 0 && item.idCard.length !== 18 && item.idCard.length !== 15) {
				uni.showToast({ title: '游客 ' + (i+1) + ' 身份证号不符', icon: 'none' })
				return
			}
		}

		isNavigating = true
		const requests: Promise<Traveler>[] = []
		for (let i = 0; i < validList.length; i++) {
			const item = validList[i]
			requests.push(createTraveler<Traveler>({
				name: item.name,
				phone: item.phone,
				idCard: item.idCard,
				isSelf: false
			}))
		}
		Promise.all(requests).then((_list) => {
			uni.showToast({ title: '批量保存成功', icon: 'success' })
			setTimeout(() => {
				uni.navigateBack()
			}, 800)
		}).catch((_err) => {
			isNavigating = false
			uni.showToast({ title: '批量保存失败，请稍后重试', icon: 'none' })
		})
	}
</script>

<style>
