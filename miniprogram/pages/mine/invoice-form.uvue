		font-weight: 700;
	}

	.type-btn-text-active {
		color: #FFFFFF;
		font-weight: 800;
	}

	.form-group {
		flex-direction: column;
	}

	.form-item {
		flex-direction: row;
		align-items: center;
		padding: 12px 0;
		border-bottom-width: 0.5px;
		border-bottom-color: rgba(0, 0, 0, 0.1);
	}

	.form-item:last-child {
		border-bottom-width: 0;
	}

	.form-label {
		width: 100px;
		font-size: 15px;
		color: #1A1A1A;
		font-weight: 500;
		flex-shrink: 0;
	}

	.form-input {
		flex: 1;
