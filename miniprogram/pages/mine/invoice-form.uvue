		width: 18px;
		height: 18px;
		margin-right: 4px;
	}

	.nav-back-text {
		font-size: 16px;
		color: #1A1A1A;
		font-weight: 500;
	}

	.nav-title {
		position: absolute;
		left: 0;
		right: 0;
		text-align: center;
		font-size: 17px;
		font-weight: 700;
		color: #1A1A1A;
	}

	.main-scroll {
		position: absolute;
		left: 0;
		right: 0;
	}

	.amount-section {
		margin: 16px 16px 14px 16px;
		padding: 22px 20px 18px 20px;
		background-color: #1A73E8;
		border-radius: 16px;
		border-width: 0;
		border-color: #1A73E8;
	}

	.amount-label {
		font-size: 12px;
		color: rgba(255, 248, 238, 0.72);
		margin-bottom: 6px;
	}

	.amount-value {
		font-size: 32px;
		color: #1A73E8;
		font-weight: 800;
	}

	.form-section {
		margin: 0 16px 12px 16px;
		background-color: #FFFFFF;
		border-radius: 16px;
		padding: 16px;
		border-width: 1px;
		border-style: solid;
		border-color: #E5E7EB;
	}

	.section-header {
		justify-content: space-between;
		align-items: center;
		margin-bottom: 12px;
	}

	.section-title {
		font-size: 13px;
		color: #1A1A1A;
		font-weight: 800;
		margin-bottom: 12px;
	}

	.section-action {
		font-size: 13px;
		color: #1A73E8;
		font-weight: 700;
		margin-bottom: 12px;
	}

	.quiet {
		font-size: 13px;
		color: #374151;
	}

	.title-pick-list {
		flex-direction: column;
	}

	.title-pick {
		padding: 12px;
		border-radius: 12px;
		background-color: #FFFFFF;
		margin-bottom: 8px;
	}

	.title-pick-on {
		background-color: #1A73E8;
	}

	.title-pick-name {
		font-size: 15px;
		color: #1A1A1A;
		font-weight: 700;
		margin-bottom: 4px;
	}

	.title-pick-on .title-pick-name {
		color: #1A73E8;
	}

	.title-pick-meta {
		font-size: 12px;
		color: #374151;
	}

	.title-pick-on .title-pick-meta {
		color: rgba(26, 115, 232, 0.85);
	}

	.header-type-group {
		flex-direction: row;
		margin-bottom: 16px;
	}

	.type-btn {
		flex: 1;
		height: 40px;
		background-color: #E8EEF8;
		border-radius: 16px;
		align-items: center;
		justify-content: center;
		margin-right: 10px;
		border-width: 1px;
		border-style: solid;
		border-color: #C5D0E0;
}

	.type-btn:last-child {
		margin-right: 0;
	}

	.type-btn-active {
		background-color: #1A73E8;
