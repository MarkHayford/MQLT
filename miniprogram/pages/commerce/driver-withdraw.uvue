<template>
	<view class="page uni-column">
		<view class="status-bar" :style="{ height: statusBarHeight + 'px' }"></view>
		<view class="nav-bar">
			<view class="nav-back" @click="goBack">
				<image src="/static/auth-back.svg" class="nav-back-icon" mode="aspectFit"></image>
				<text class="nav-back-text">返回</text>
			</view>
			<text class="nav-title">提现</text>
		</view>

		<scroll-view class="body" scroll-y="true" show-scrollbar="false">
			<view class="balance-card uni-column">
				<text class="balance-label">可提现金额</text>
				<text class="balance-value">{{ wallet.availableText }}</text>
				<view class="balance-meta uni-row">
					<text class="balance-meta-text">审核中 {{ wallet.pendingText }}</text>
					<text class="balance-meta-dot">·</text>
					<text class="balance-meta-text">已提现 {{ wallet.withdrawnText }}</text>
				</view>
			</view>

			<view class="form-card uni-column">
				<text class="form-title">提现金额</text>
				<view class="amount-row uni-row">
					<text class="amount-prefix">¥</text>
					<input class="amount-input" type="digit" v-model="amountText" placeholder="0.00" placeholder-style="color:#E5E7EB;" />
					<text class="amount-all" @click="fillAll">全部</text>
				</view>
				<text class="form-hint">最低提现 {{ minText }}，预计 1–3 个工作日到账</text>
			</view>

			<view class="form-card uni-column">
				<text class="form-title">到账方式</text>
				<view class="channel-row uni-row">
					<view :class="channel === 'WECHAT' ? 'ch-chip ch-chip-on' : 'ch-chip'" @click="channel = 'WECHAT'">
						<text :class="channel === 'WECHAT' ? 'ch-chip-text ch-chip-text-on' : 'ch-chip-text'">微信零钱</text>
					</view>
					<view :class="channel === 'BANK' ? 'ch-chip ch-chip-on' : 'ch-chip'" @click="channel = 'BANK'">
						<text :class="channel === 'BANK' ? 'ch-chip-text ch-chip-text-on' : 'ch-chip-text'">银行卡</text>
					</view>
				</view>
				<view v-if="channel === 'BANK'" class="bank-fields uni-column">
					<view class="field uni-row">
						<text class="field-label">户名</text>
						<input class="field-input" type="text" v-model="accountName" placeholder="与身份证一致" placeholder-style="color:#E5E7EB;" />
					</view>
					<view class="field uni-row">
						<text class="field-label">银行</text>
						<input class="field-input" type="text" v-model="bankName" placeholder="如 中国工商银行" placeholder-style="color:#E5E7EB;" />
					</view>
					<view class="field uni-row">
						<text class="field-label">卡号</text>
						<input class="field-input" type="number" v-model="bankAccount" placeholder="银行卡号" placeholder-style="color:#E5E7EB;" />
					</view>
				</view>
				<view v-else class="wechat-tip">
					<text class="form-hint">将打入当前微信绑定的零钱，需司机实名与微信一致</text>
				</view>
			</view>

			<view class="submit-wrap">
				<view :class="submitting ? 'submit-btn submit-off' : 'submit-btn'" @click="submit">
					<text class="submit-btn-text">{{ submitting ? '提交中…' : '确认提现' }}</text>
				</view>
			</view>

			<view class="sec uni-column">
				<text class="sec-title">提现记录</text>
				<view v-for="item in records" :key="item.id" class="rec uni-row">
					<view class="rec-main uni-column">
						<text class="rec-amount">{{ item.amountText }}</text>
						<text class="rec-sub">{{ item.channelLabel }} · {{ item.timeText }}</text>
					</view>
					<text :class="statusClass(item.status)">{{ item.statusLabel }}</text>
				</view>
				<view v-if="records.length === 0" class="empty">
					<text class="empty-t">暂无提现记录</text>
				</view>
			</view>
			<view class="pad"></view>
		</scroll-view>
	</view>
</template>

<script setup lang="uts">
	import { ref, computed } from 'vue'
	import { onShow } from '@dcloudio/uni-app'
	import { getStatusBarHeight } from '../../utils/system-layout.uts'
	import { emptyDriverWallet, fetchDriverWallet, parseDriverWallet, fetchDriverHome, requestDriverWithdraw, fetchDriverWithdrawals, type DriverWallet, type DriverWithdrawRecord } from '../../utils/commerce.uts'

	const statusBarHeight = getStatusBarHeight()
	const wallet = ref<DriverWallet>(emptyDriverWallet())
	const records = ref<DriverWithdrawRecord[]>([])
	const amountText = ref('')
	const channel = ref('WECHAT')
	const accountName = ref('')
	const bankName = ref('')
	const bankAccount = ref('')
	const submitting = ref(false)

	const minText = computed((): string => {
		return '¥' + wallet.value.minAmount.toFixed(2)
	})

	const goBack = () => { uni.navigateBack() }

	const fillAll = () => {
		amountText.value = wallet.value.availableAmount.toFixed(2)
	}

	const statusClass = (status: string): string => {
		if (status === 'PAID' || status === 'SUCCESS') return 'rec-st rec-st-ok'
		if (status === 'REJECTED' || status === 'FAILED') return 'rec-st rec-st-bad'
		return 'rec-st'
	}

	const load = () => {
		fetchDriverHome().then((home) => {
			wallet.value = parseDriverWallet(home)
		}).catch((_e) => {})
		fetchDriverWallet().then((w) => {
			wallet.value = w
		}).catch((_e) => {})
		fetchDriverWithdrawals().then((list) => {
			records.value = list
		}).catch((_e) => {
			records.value = []
		})
	}

	const submit = () => {
		if (submitting.value) return
		const amount = parseFloat(amountText.value)
		if (amount != amount || amount <= 0) {
			uni.showToast({ title: '请输入提现金额', icon: 'none' })
			return
		}
		if (amount < wallet.value.minAmount) {
			uni.showToast({ title: '最低提现 ' + minText.value, icon: 'none' })
			return
		}
		if (amount > wallet.value.availableAmount + 0.001) {
			uni.showToast({ title: '超过可提现金额', icon: 'none' })
			return
		}
		if (channel.value === 'BANK') {
			if (accountName.value.trim().length === 0) {
				uni.showToast({ title: '请填写户名', icon: 'none' })
				return
			}
			if (bankName.value.trim().length === 0) {
				uni.showToast({ title: '请填写开户行', icon: 'none' })
				return
			}
			if (bankAccount.value.trim().length < 8) {
				uni.showToast({ title: '请填写正确卡号', icon: 'none' })
				return
			}
		}
		uni.showModal({
			title: '确认提现',
			content: '提现 ' + amount.toFixed(2) + ' 元到' + (channel.value === 'BANK' ? '银行卡' : '微信零钱') + '？',
			success: (res) => {
				if (!res.confirm) return
				submitting.value = true
				requestDriverWithdraw(amount, channel.value, accountName.value.trim(), bankName.value.trim(), bankAccount.value.trim(), '').then((_r) => {
					submitting.value = false
					amountText.value = ''
					uni.showToast({ title: '已提交审核', icon: 'success' })
					load()
				}).catch((e) => {
					submitting.value = false
					const msg = e != null && e.message != null ? e.message.toString() : '提现失败'
					uni.showToast({ title: msg, icon: 'none' })
				})
			}
		})
	}

	onShow(() => { load() })
</script>

