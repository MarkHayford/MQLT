	.nav-title {
		position: absolute; left: 0; right: 0; text-align: center;
		font-size: 17px; font-weight: 700; color: #1A1A1A;
	}
	.search-area { background-color: #FFFFFF; border-width: 0; border-color: #FFFFFF; padding: 8px 16px 12px 16px; height: 60px; }
	.search-wrap {
		border-width: 1px;
		border-style: solid;
		border-color: #C5D0E0;
		width: 100%; height: 40px; background-color: #E8EEF8;
		border-radius: 20px; align-items: center; padding: 0 16px;
	
}
	.s-icon { width: 16px; height: 16px; margin-right: 8px; }
	.s-input { flex: 1; font-size: 14px; color: #1A1A1A; }
	.filter-sort-bar {
		border-width: 0;
		border-color: #FFFFFF;
		height: 50px; width: 100%; align-items: center;
		background-color: #FFFFFF;
		border-bottom-width: 0.5px; border-bottom-color: rgba(0,0,0,0.05);
		justify-content: space-between;
	}
	.type-scroll { flex: 1; height: 50px; }
	.type-list { padding: 0 16px; height: 50px; align-items: center; flex-direction: row; }
	.type-tail { width: 12px; height: 1px; flex-shrink: 0; }
	.type-pill {
		padding: 0 14px; height: 28px; background-color: #E8EEF8;
		border-radius: 14px; justify-content: center; margin-right: 8px; flex-shrink: 0;
		align-items: center;
		border-width: 1px;
		border-style: solid;
		border-color: #C5D0E0;
}
	.type-active { background-color: #1A73E8;
		border-width: 1px;
		border-style: solid;
		border-color: #1A73E8;
}
	.type-txt { font-size: 13px; color: #374151; font-weight: 500; }
	.type-txt-active { color: #FFFFFF; font-weight: 600; }
	.sort-bar {
		width: 100%;
		height: 40px;
		flex-direction: row;
		background-color: #F5F7FB;
		border-top-width: 1px;
		border-top-style: solid;
		border-top-color: #E5E7EB;
	}
	.sort-cell {
		flex: 1;
		height: 40px;
		align-items: center;
		justify-content: center;
		background-color: #F5F7FB;
		border-right-width: 1px;
		border-right-style: solid;
		border-right-color: #E5E7EB;
		border-radius: 0;
	}
	.sort-cell-last {
		border-right-width: 0;
	}
	.sort-cell-on {
		background-color: #1A73E8;
	}
	.sort-cell-txt {
		font-size: 13px;
		font-weight: 700;
		color: #1A1A1A;
	}
	.sort-cell-txt-on {
		color: #FFFFFF;
	}
.main-list {
		position: absolute;
		left: 0;
		right: 0;
		bottom: 0;
	}
	.list-padding { padding: 16px; padding-bottom: 0; }
	.list-bottom-space {
		height: 34px;
		padding-bottom: env(safe-area-inset-bottom);
	}
	.route-card {
		background-color: #FFFFFF; border-radius: 16px; padding: 18px;
		margin-bottom: 16px; border-width: 1px; border-style: solid;
		border-color: rgba(0, 0, 0, 0.05);
	}
	.route-card-picked {
		border-color: #1A73E8;
	}
	.route-card-header { justify-content: space-between; align-items: center; margin-bottom: 12px; }
	.zone-tag { padding: 2px 8px; border-radius: 4px; background-color: #1A73E8; }
	.zone-tag-txt { color: #FFFFFF; font-size: 11px; font-weight: 700; }
	.route-duration { font-size: 13px; color: #9CA3AF; }
	.route-title {
		font-size: 17px; font-weight: 700; color: #1A1A1A; margin-bottom: 8px;
		lines: 2; overflow: hidden; text-overflow: ellipsis;
	}
	.route-brief {
		font-size: 14px; color: #374151; line-height: 20px; margin-bottom: 14px;
		lines: 2; overflow: hidden; text-overflow: ellipsis;
	}
	.route-footer {
		padding-top: 12px; border-top-width: 0.5px; border-top-color: #FFFFFF;
		justify-content: space-between; align-items: center;
	}
	.read-more { font-size: 13px; color: #1A1A1A; font-weight: 600; }
	.picked-flag { font-size: 12px; font-weight: 700; color: #1A73E8; flex: 1; }
	.detail-btn {
		height: 28px; padding: 0 14px; border-radius: 14px; background-color: #1A73E8;
		align-items: center; justify-content: center; flex-shrink: 0;
	}
	.detail-btn-text { font-size: 12px; font-weight: 700; color: #FFFFFF; }
	.arrow-right { font-size: 18px; color: #E5E7EB; }
	.empty-state { padding-top: 60px; align-items: center; }
	.empty-emoji { width: 40px; height: 40px; margin-bottom: 10px; }
	.empty-txt { color: #9CA3AF; font-size: 14px; }

	.pick-bar {
		position: fixed; left: 0; right: 0; bottom: 0;
		padding: 12px 16px 28px 16px; background-color: #FFFFFF;
		border-top-width: 0.5px; border-top-color: rgba(60,60,67,0.12);
		align-items: center; z-index: 900;
	}
	.pick-info { flex: 1; }
	.pick-label { font-size: 12px; color: #9CA3AF; margin-bottom: 2px; }
	.pick-value { font-size: 16px; font-weight: 800; color: #1A1A1A; }
	.pick-done {
		height: 44px; padding: 0 28px; border-radius: 22px; background-color: #1A73E8;
		align-items: center; justify-content: center;
	}
	.pick-done-text { font-size: 15px; font-weight: 800; color: #FFFFFF; }

	.detail-mask {
		position: fixed; left: 0; right: 0; top: 0; bottom: 0;
		background-color: rgba(0, 0, 0, 0.45); z-index: 920;
	}
	.detail-sheet {
		position: fixed; left: 0; right: 0; bottom: 0;
		height: 78%; max-height: 78%; background-color: #FFFFFF;
		border-top-left-radius: 20px; border-top-right-radius: 20px;
		z-index: 921; overflow: hidden;
	}
	.detail-handle {
		width: 36px; height: 4px; border-radius: 2px; background-color: #E5E7EB;
		align-self: center; margin-top: 10px; margin-bottom: 8px; flex-shrink: 0;
	}
	.detail-top { align-items: center; padding: 4px 16px 10px 16px; flex-shrink: 0; }
	.detail-titles { flex: 1; min-width: 0; }
	.detail-title { font-size: 17px; font-weight: 800; color: #1A1A1A; margin-bottom: 4px; }
	.detail-zone { font-size: 12px; color: #374151; font-weight: 600; }
	.detail-close {
		padding: 6px 12px; border-radius: 14px; background-color: #FFFFFF;
		flex-shrink: 0; margin-left: 10px;
	}
	.detail-close-text { font-size: 12px; font-weight: 700; color: #374151; }
	.detail-scroll { width: 100%; flex: 1; min-height: 240px; }
	.detail-inner { padding: 0 16px 8px 16px; flex-direction: column; }
	.detail-scroll-pad { height: 24px; }
	.detail-photo {
		height: 160px; border-radius: 16px; align-items: center; justify-content: center;
		margin-bottom: 16px; overflow: hidden;
	}
	.detail-photo-cap { font-size: 13px; font-weight: 700; color: #FFFFFF; }
	.detail-sec { margin-bottom: 16px; }
	.detail-sec-title { font-size: 14px; font-weight: 800; color: #1A1A1A; margin-bottom: 8px; }
	.detail-sec-body { font-size: 13px; color: #374151; line-height: 20px; }
	.detail-rich { font-size: 13px; color: #374151; line-height: 22px; }
	.bullet-row { align-items: flex-start; margin-bottom: 6px; }
