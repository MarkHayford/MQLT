<template>
	<view class="page-wrapper uni-column">
		<view class="header-section uni-column">
			<view class="status-bar" :style="{ height: statusBarHeight + 'px' }"></view>
			<view class="nav-bar">
				<view class="nav-back" @click="goBack">
					<image src="/static/auth-back.svg" class="nav-back-icon" mode="aspectFit"></image>
					<text class="nav-back-text">返回</text>
				</view>
				<text class="nav-title">填写预约</text>
			</view>
			<view class="project-banner uni-column" v-if="project != null">
				<text class="project-kicker">STUDY BOOKING</text>
				<text class="project-title">{{ project.title }}</text>
				<text class="project-sub">{{ project.location != null && project.location.length > 0 ? project.location : project.subtitle }}</text>
			</view>
		</view>

		<scroll-view class="main-scroll" scroll-y="true" :show-scrollbar="false" :bounces="true">
			<view class="scroll-inner">
				<!-- 1. 选择游客 -->
				<view class="section-card uni-column">
					<view class="section-gold-edge"></view>
					<view class="section-head uni-column">
						<view class="section-head-row uni-row">
							<text class="section-kicker">01 GUESTS</text>
							<view class="section-link" @click="goAddTraveler">
								<text class="section-link-text">添加</text>
							</view>
						</view>
						<text class="section-title">选择游客</text>
						<text class="section-desc">勾选参与人；可代约，对方实名一致后自动获得预约</text>
					</view>

					<view
						v-for="item in travelers"
						:key="item.id"
						:class="['traveler-row uni-row', isTravelerSelected(item.id) ? 'traveler-row-on' : '']"
						@click="toggleTraveler(item.id)"
					>
						<view :class="['check-dot', isTravelerSelected(item.id) ? 'check-dot-on' : '']">
							<image v-if="isTravelerSelected(item.id)" src="/static/icon-check.svg" class="check-dot-icon" mode="aspectFit"></image>
						</view>
						<view class="traveler-info uni-column">
							<view class="traveler-name-row uni-row">
								<text class="traveler-name">{{ item.name }}</text>
								<view v-if="item.isSelf" class="self-tag">
									<text class="self-tag-text">本人</text>
								</view>
							</view>
							<text class="traveler-phone">{{ maskPhone(item.phone) }}</text>
						</view>
					</view>

					<view v-if="travelers.length === 0" class="empty-block uni-column">
						<text class="empty-title">暂无常用游客</text>
						<text class="empty-desc">先添加游客，或完成实名后自动生成本人</text>
						<view class="empty-btn" @click="goAddTraveler">
							<text class="empty-btn-text">去添加游客</text>
						</view>
					</view>
				</view>

				<!-- 2. 日历选日期 + 每日路线 -->
				<view class="section-card uni-column">
					<view class="section-gold-edge"></view>
					<view class="section-head uni-column">
						<text class="section-kicker">02 DATE</text>
						<text class="section-title">研学日期与点位</text>
						<text class="section-desc">每天都可以预约，可多选；每天显示开放–截止，点位可不同</text>
					</view>

					<!-- 月切换 -->
					<view class="cal-nav uni-row">
						<view class="cal-nav-btn" @click="shiftMonth(-1)">
							<text class="cal-nav-btn-text">‹</text>
						</view>
						<text class="cal-month-title">{{ calendarTitle }}</text>
						<view class="cal-nav-btn" @click="shiftMonth(1)">
							<text class="cal-nav-btn-text">›</text>
						</view>
					</view>

					<view class="cal-week-row uni-row">
						<text v-for="w in weekLabels" :key="w" class="cal-week-cell">{{ w }}</text>
					</view>

					<view class="cal-grid">
						<view
							v-for="cell in calendarCells"
							:key="cell.key"
							:class="['cal-cell', cell.inMonth ? '' : 'cal-cell-muted', cell.open ? '' : 'cal-cell-closed', cell.full ? 'cal-cell-full' : '', cell.selected ? 'cal-cell-on' : '', cell.isToday ? 'cal-cell-today' : '']"
							@click="toggleDay(cell)"
						>
							<text :class="['cal-day-num', cell.selected ? 'cal-day-num-on' : '']">{{ cell.day > 0 ? cell.day.toString() : '' }}</text>
							<text v-if="cell.open && cell.inMonth && cell.full" class="cal-day-hours cal-day-hours-full">已满</text>
							<text v-else-if="cell.open && cell.inMonth" class="cal-day-hours">{{ cell.openLabel }}</text>
							<text v-else-if="cell.inMonth && cell.day > 0 && cell.paused" class="cal-day-hours cal-day-hours-off">暂停</text>
							<text v-else-if="cell.inMonth && cell.day > 0 && !cell.open" class="cal-day-hours cal-day-hours-off">休</text>
							<text v-if="cell.open && cell.inMonth && !cell.full && cell.enrollLabel.length > 0" class="cal-day-enroll">{{ cell.enrollLabel }}</text>
						</view>
					</view>

					<view class="selected-days-bar uni-row" v-if="selectedDayKeys.length > 0">
						<text class="selected-days-label">已选 {{ selectedDayKeys.length }} 天</text>
						<scroll-view class="selected-days-scroll" scroll-x="true" :show-scrollbar="false" :enable-flex="true">
							<view class="selected-days-inner">
								<view
									v-for="dk in selectedDayKeys"
									:key="dk"
									:class="['day-pill', activeDayKey === dk ? 'day-pill-on' : '']"
									@click="setActiveDay(dk)"
								>
									<text :class="['day-pill-text', activeDayKey === dk ? 'day-pill-text-on' : '']">{{ dayShortLabel(dk) }}</text>
								</view>
							</view>
						</scroll-view>
					</view>
					<text v-else class="cal-hint">点选日期（可多选）；选 2 天即两天行程</text>

					<!-- 当前日期的路线编辑 -->
					<view class="day-route-block uni-column" v-if="activeDayKey.length > 0">
						<view class="day-route-head uni-column">
							<view class="day-route-title-row uni-row">
								<text class="day-route-title">{{ dayFullLabel(activeDayKey) }} 已选点位</text>
								<text class="card-more-link" v-if="spotsForActiveDay.length > 0" @click="goSpotListPage">查看更多</text>
							</view>
							<text class="day-route-hours">开放时间 {{ dayOpenCloseText(activeDayKey) }}</text>
						</view>

						<!-- 分区筛选 -->
						<view class="zone-row uni-row">
							<view
								v-for="z in zoneFilters"
								:key="z.key"
								:class="['zone-chip', selectedZoneKey === z.key ? 'zone-chip-on' : '']"
								@click="selectZone(z.key)"
							>
								<text :class="['zone-chip-text', selectedZoneKey === z.key ? 'zone-chip-text-on' : '']">{{ z.label }}</text>
							</view>
						</view>

						<view class="ai-entry uni-row" @click="openAiChat">
							<view class="ai-entry-dot">
								<image src="/static/icon-assistant.svg" class="ai-entry-icon" mode="aspectFit"></image>
							</view>
							<view class="ai-entry-copy uni-column">
								<text class="ai-entry-title">{{ aiPlanning ? '正在规划…' : '研学行程小助手' }}</text>
								<text class="ai-entry-sub">帮你推荐点位搭配、人数节奏与是否叫车</text>
							</view>
							<text class="ai-entry-go">打开</text>
						</view>
						<view class="ai-row uni-row">
							<view class="ai-btn ai-btn-ghost" @click="selectAllSpotsForActiveDay">
								<text class="ai-btn-ghost-text">全选本区</text>
							</view>
							<view class="ai-btn ai-btn-ghost" @click="clearSpotsForActiveDay">
								<text class="ai-btn-ghost-text">清空</text>
							</view>
						</view>
						<text v-if="aiPlanHint.length > 0" class="ai-hint">{{ aiPlanHint }}</text>

						<view v-if="spotsForActiveDay.length === 0" class="empty-block uni-column">
							<text class="empty-title">{{ selectedZoneKey === 'all' ? '本日暂无可选区域' : '本分区暂无点位' }}</text>
							<text class="empty-desc">{{ selectedZoneKey === 'all' ? '可换一天或联系项目方配置点位' : '可切换其他分区查看' }}</text>
						</view>

						<view v-else class="route-map-block uni-column">
							<view class="route-map-wrap">
								<map
									id="study-route-map"
									class="route-map"
									:latitude="routeMapLatitude"
									:longitude="routeMapLongitude"
									:scale="routeMapScale"
									:markers="routeMapMarkers"
									:include-points="routeMapIncludePoints"
									:enable-scroll="true"
									:enable-zoom="true"
									:show-location="false"
									@markertap="onRouteMarkerTap"
									@callouttap="onRouteCalloutTap"
								></map>
								<view class="spot-guide uni-column" @touchmove.stop>
									<view class="spot-guide-head uni-row" @click="toggleSpotGuide">
										<text class="spot-guide-kicker">GUIDE</text>
										<text class="spot-guide-title">站点</text>
										<text class="spot-guide-count">{{ spotsForActiveDay.length }}</text>
									</view>
									<scroll-view v-if="spotGuideOpen" class="spot-guide-scroll" scroll-y="true" :show-scrollbar="false" :enable-flex="true">
										<view
											v-for="(spot, gIdx) in spotsForActiveDay"
											:key="'g-'+spot.id"
											:class="['spot-guide-item', focusedSpotId === spot.id ? 'spot-guide-item-on' : '']"
											@click="focusSpotOnMap(spot)"
										>
											<view :class="['spot-guide-idx', isSpotSelectedOnActiveDay(spot.id) ? 'spot-guide-idx-on' : '']">
												<text :class="['spot-guide-idx-txt', isSpotSelectedOnActiveDay(spot.id) ? 'spot-guide-idx-txt-on' : '']">{{ isSpotSelectedOnActiveDay(spot.id) ? '✓' : (gIdx + 1).toString() }}</text>
											</view>
											<text class="spot-guide-name route-marker-name">{{ spot.title }}</text>
										</view>
									</scroll-view>
								</view>
							</view>
							<view class="route-legend uni-row">
								<view class="legend-item uni-row">
									<view class="legend-dot legend-dot-college"></view>
									<text class="legend-txt">点位</text>
								</view>
								<view class="legend-item uni-row">
									<view class="legend-dot legend-dot-on"></view>
									<text class="legend-txt">已选站点</text>
								</view>
							</view>
							<text class="route-map-hint">点地图标注选择该点位，再点一次取消。蓝色为已选点位（无先后顺序，研学时可自选前往）。</text>
						</view>

						<!-- 本日已选：无先后，卡片集合而非路线时间轴 -->
						<view class="picked-block uni-column" v-if="activeDaySchedule.length > 0">
							<view class="picked-head uni-row">
								<text class="route-preview-title">本日已选点位</text>
								<text class="picked-count">{{ activeDaySchedule.length }} 站</text>
							</view>
							<view class="picked-wrap">
								<view
									v-for="item in activeDaySchedule"
									:key="item.id"
									class="picked-chip uni-column"
									@click="openSpotDetailById(item.id)"
								>
									<text class="picked-chip-title">{{ item.title }}</text>
									<text class="picked-chip-meta">{{ item.stayText }}</text>
								</view>
							</view>
						</view>
					</view>
				</view>

				<!-- 预约页不再含租车选车型/选司机，改走浮动叫车入口 -->
				<view class="section-card uni-column">
					<view class="section-gold-edge"></view>
					<view class="section-head uni-column">
						<text class="section-kicker">03 RIDE</text>
						<text class="section-title">用车提示</text>
						<text class="section-desc">需要用车请点页面浮动叫车，发单后由司机接单议价；本页只预约研学行程</text>
					</view>
					<view class="ride-tip-btn" @click="goRentalCreateFromBooking">
						<text class="ride-tip-btn-text">去发租车需求</text>
					</view>
				</view>

				<view class="bottom-safe-spacer"></view>
			</view>
		</scroll-view>

		<view class="bottom-bar uni-column" style="background-color:#FFFFFF;border-width:0;border-top-width:1px;border-top-style:solid;border-top-color:#E5E7EB;">
			<view class="summary-row uni-row">
				<view class="summary-col uni-column">
					<text class="summary-label">参与 · 行程</text>
					<text class="summary-value">{{ participantCount }} 人 · {{ selectedDayKeys.length }} 天 · {{ totalSelectedStops }} 站</text>
				</view>
				<view class="summary-col uni-column summary-col-right">
					<text class="summary-label">应付金额</text>
					<text class="summary-price">¥{{ bookingTotalAmount }}</text>
				</view>
			</view>
			<view :class="['submit-btn', isSubmitting ? 'submit-btn-disabled' : '']" @click="submitBooking">
				<text class="submit-btn-text">{{ isSubmitting ? '提交中…' : '立即预约' }}</text>
			</view>
		</view>

		<!-- 路线区域详情 -->
		<view v-if="showSpotDetail" class="spot-detail-mask" @click="closeSpotDetail" @touchmove.stop.prevent="onDetailMaskTouchMove"></view>
		<view v-if="showSpotDetail && detailSpot != null" class="spot-detail-sheet uni-column" @touchmove.stop="onDetailSheetTouchMove">
			<view class="spot-detail-handle"></view>
			<view class="spot-detail-top uni-row">
				<view class="spot-detail-titles uni-column">
					<text class="spot-detail-title">{{ detailSpot.title }}</text>
					<text class="spot-detail-zone">{{ detailSpot.zoneLabel }} · 预计 {{ detailSpot.durationText }}</text>
				</view>
				<view class="spot-detail-close" @click="closeSpotDetail">
					<text class="spot-detail-close-text">关闭</text>
				</view>
			</view>
			<scroll-view
				class="spot-detail-scroll"
				scroll-y="true"
				:show-scrollbar="true"
				:enhanced="true"
				:bounces="true"
				:enable-flex="true"
			>
				<view class="spot-detail-inner">
					<view class="spot-photo-card" :style="detailSpot.coverStyle">
						<text class="spot-photo-caption">{{ detailSpot.photoCaption }}</text>
					</view>
					<view v-for="sec in detailSpot.sections" :key="sec.key">
						<view v-if="sectionHasBody(sec.html)" class="spot-detail-section uni-column">
							<text class="spot-detail-sec-title">{{ sec.title }}</text>
							<rich-text v-if="sectionIsHtml(sec.html)" class="spot-detail-rich" :nodes="sec.html"></rich-text>
							<text v-else class="spot-detail-sec-body">{{ sec.html }}</text>
						</view>
					</view>
					<view class="spot-detail-scroll-pad"></view>
				</view>
			</scroll-view>
			<view class="spot-detail-footer uni-row">
				<view class="spot-detail-secondary" @click="closeSpotDetail">
					<text class="spot-detail-secondary-text">关闭</text>
				</view>
				<view class="spot-detail-primary" @click="toggleDetailSpotSelect">
					<text class="spot-detail-primary-text">{{ detailSpotSelected ? '取消选择' : '选择该点位' }}</text>
				</view>
			</view>
		</view>

		<!-- AI 行程小助手对话 -->
		<view v-if="showAiChat" class="ai-chat-mask" @click="closeAiChat" @touchmove.stop.prevent="onDetailMaskTouchMove"></view>
		<view v-if="showAiChat" class="ai-chat-sheet uni-column">
			<view class="ai-chat-handle"></view>
			<view class="ai-chat-top uni-row">
				<view class="ai-chat-avatar">
					<image src="/static/icon-assistant.svg" class="ai-chat-avatar-icon" mode="aspectFit"></image>
				</view>
				<view class="ai-chat-titles uni-column">
					<text class="ai-chat-kicker">STUDY ASSISTANT</text>
					<text class="ai-chat-title">研学行程小助手</text>
				</view>
				<view class="ai-chat-aud-top" @click="goAudiencePlansFromAi">
					<text class="ai-chat-aud-top-txt">分层点位</text>
				</view>
				<view class="ai-chat-close" @click="closeAiChat">
					<text class="ai-chat-close-text">关闭</text>
				</view>
			</view>

			<scroll-view
				class="ai-chat-scroll"
				scroll-y="true"
				:scroll-into-view="aiScrollInto"
				:show-scrollbar="false"
				:enhanced="true"
				:bounces="true"
				:enable-flex="true"
				@touchmove.stop="onDetailSheetTouchMove"
			>
				<view class="ai-chat-inner">
					<view
						v-for="(msg, mIdx) in aiMessages"
						:key="msg.id"
						:id="msg.id"
						:class="['ai-msg-row', msg.role === 'user' ? 'ai-msg-row-user' : 'ai-msg-row-bot']"
					>
						<view v-if="msg.role !== 'user'" class="ai-msg-bot-dot">
							<image src="/static/icon-assistant.svg" class="ai-msg-bot-icon" mode="aspectFit"></image>
						</view>
						<view :class="['ai-bubble', msg.role === 'user' ? 'ai-bubble-user' : 'ai-bubble-bot', msg.isPlan || msg.spots.length > 0 || msg.drivers.length > 0 ? 'ai-bubble-plan' : '']">
							<text :class="['ai-bubble-text', msg.role === 'user' ? 'ai-bubble-text-user' : '']">{{ msg.text }}</text>
							<view v-if="mIdx === 0 && msg.role !== 'user'" class="ai-aud-wrap uni-column">
								<view class="ai-aud-btn uni-row" @click.stop="goAudiencePlansFromAi">
									<text class="ai-aud-btn-txt">打开分层点位</text>
								</view>
								<text class="ai-aud-hint">亲子 / 高校 / 商务或自定义人群，选一套推荐点位</text>
							</view>

							<!-- 分日行程摘要 -->
							<view v-if="msg.days.length > 0" class="ai-day-list uni-column">
								<text class="ai-block-label">行程安排</text>
								<view v-for="d in msg.days" :key="msg.id + '-d-' + d.dayKey" class="ai-day-card uni-column">
									<view class="ai-day-head uni-row">
										<text class="ai-day-label">{{ d.label }}</text>
										<text class="ai-day-stops">{{ d.stopCount.toString() }} 个点位</text>
									</view>
									<text class="ai-day-route">{{ d.routeText }}</text>
									<view v-if="msg.isPlan" class="ai-day-ops uni-row">
										<text class="ai-mini-link" @click.stop="applyAiOneDay(d.dayKey)">只应用这天</text>
										<text class="ai-mini-link" @click.stop="focusAiDay(d.dayKey)">设为编辑日</text>
									</view>
								</view>
							</view>

							<!-- 推荐点位图文卡 -->
							<view v-if="msg.spots.length > 0" class="ai-spot-block uni-column">
								<text class="ai-block-label">推荐点位 · 点开看详情</text>
								<scroll-view class="ai-spot-scroll" scroll-x="true" :show-scrollbar="false" :enable-flex="true">
									<view class="ai-spot-scroll-inner">
										<view
											v-for="sp in msg.spots"
											:key="msg.id + '-s-' + sp.id + '-' + sp.dayKey"
											class="ai-spot-card uni-column"
											@click.stop="openAiSpotDetail(sp.id)"
										>
											<view class="ai-spot-cover" :style="sp.coverStyle">
												<text class="ai-spot-cover-cap">{{ sp.photoCaption }}</text>
											</view>
											<text class="ai-spot-title">{{ sp.title }}</text>
											<text class="ai-spot-meta">{{ sp.zoneLabel }} · {{ sp.durationText }}</text>
											<text class="ai-spot-desc">{{ sp.desc }}</text>
											<view class="ai-spot-ops uni-row">
												<text class="ai-mini-link" @click.stop="openAiSpotDetail(sp.id)">详情</text>
												<text class="ai-mini-link" @click.stop="addAiSpotToActiveDay(sp.id)">选择该点位</text>
											</view>
										</view>
										<view class="ai-spot-tail"></view>
									</view>
								</scroll-view>
							</view>

							<!-- 用车引导：不写入预约，去浮动叫车发单 -->
							<view v-if="msg.showRental" class="ai-rental-block uni-column">
								<text class="ai-block-label">用车建议</text>
								<view class="ai-rental-card uni-row">
									<view class="ai-rental-body uni-column">
										<text class="ai-rental-name">{{ msg.rentalName }}</text>
										<text class="ai-rental-desc">{{ msg.rentalHint }}</text>
									</view>
									<view class="ai-rental-pick" @click.stop="goRentalCreateFromAi">
										<text class="ai-rental-pick-text">去发单</text>
									</view>
								</view>
							</view>

							<!-- 不再在预约对话里列司机选入 booking -->
							<view v-if="msg.needDrivers" class="ai-driver-tip uni-column">
								<text class="ai-driver-tip-text">{{ msg.driverTip.length > 0 ? msg.driverTip : '用车请走浮动叫车发单，司机接单后议价' }}</text>
								<view class="ai-driver-tip-btn" @click.stop="goRentalCreateFromAi">
									<text class="ai-driver-tip-btn-text">去发租车需求</text>
								</view>
							</view>

							<view v-if="msg.isPlan && aiHasPendingPlan" class="ai-plan-actions uni-row">
								<view class="ai-plan-apply" @click="applyAiPendingPlan">
									<text class="ai-plan-apply-text">{{ aiPlanning ? '应用中…' : '应用点位方案' }}</text>
								</view>
								<view class="ai-plan-retry" @click="requestAiReplan">
									<text class="ai-plan-retry-text">再改一版</text>
								</view>
							</view>
						</view>
					</view>
					<view v-if="aiThinking" class="ai-msg-row ai-msg-row-bot">
						<view class="ai-msg-bot-dot">
							<image src="/static/icon-assistant.svg" class="ai-msg-bot-icon" mode="aspectFit"></image>
						</view>
						<view class="ai-bubble ai-bubble-bot">
							<text class="ai-bubble-text">正在为你梳理行程…</text>
						</view>
					</view>
					<view id="ai-msg-end" class="ai-chat-end-anchor"></view>
				</view>
			</scroll-view>

			<view class="ai-composer uni-column" style="background-color:#FFFFFF;border-width:0;border-top-width:1px;border-top-style:solid;border-top-color:#E5E7EB;">
								<scroll-view class="ai-quick-scroll" scroll-x="true" :show-scrollbar="false" :enable-flex="true">
					<view class="ai-quick-inner uni-row">
						<view
							v-for="chip in aiQuickChips"
							:key="chip.id"
							class="ai-quick-chip uni-row"
							@click="sendAiQuick(chip.text)"
						>
							<text class="ai-quick-chip-text">{{ chip.label }}</text>
						</view>
						<view class="ai-quick-tail"></view>
					</view>
				</scroll-view>
				<view class="ai-field uni-row" style="background-color:#F5F7FB;border-width:0;">
					<input
						class="ai-input" style="background-color:#F5F7FB;border-width:0;color:#1A1A1A;"
						v-model="aiInputText"
						placeholder="说说人数、想去哪、要不要叫车…"
						placeholder-style="color:#9CA3AF;"
						confirm-type="send"
						:disabled="aiThinking"
						@confirm="sendAiInput"
					/>
					<view :class="['ai-send-btn', aiThinking || aiInputText.length === 0 ? 'ai-send-btn-off' : '']" @click="sendAiInput">
						<text class="ai-send-btn-text">{{ aiThinking ? '…' : '发送' }}</text>
					</view>
				</view>
			</view>
		</view>

		<!-- 租车浮动入口 -->
		<taxi-fab :projectId="projectId" />

	</view>

</template>

<script setup lang="uts">
	import { ref, computed, watch } from 'vue'
	import { onLoad, onShow } from '@dcloudio/uni-app'
	import { getStatusBarHeight } from '../../utils/system-layout.uts'
	import { addProjectBooking, isStudyBookingPendingStatus, isStudyBookingUnpaidStatus, syncStudyBookingsFromApi } from '../../utils/study-booking.uts'
	import {
		createStudyBooking,
		fetchStudyAiPlan,
		fetchStudyProjectDetail,
		fetchStudyProjectRoutePoints,
		payStudyBooking,
		type StudyAiPlanResult,
		type StudyAiPlanSpotInput,
		type StudyAiPlanHistoryItem,
		type StudyBookingRecord,
		type StudyProjectMeta,
		type AudienceSpotTemplate
	} from '../../utils/study-projects.uts'
	import { fetchTravelers } from '../../utils/user-services.uts'
	import { buildRouteZoneFilters, parseRouteZoneFilters, parseStudyRouteSpots, routeSectionHasBody, studyRouteZoneLabelOf, type StudyRouteZoneFilter, type StudyRouteZoneSpot } from './utils/study-route-zones.uts'
	import { isHtmlContent } from '../../utils/html-content.uts'

	const statusBarHeight = getStatusBarHeight()

	type Traveler = {
		id: string
		name: string
		phone: string
		idCard: string
		isSelf: boolean
	}

	type SpotOption = StudyRouteZoneSpot

	type DaySlot = {
		key: string
		year: number
		month: number
		day: number
		weekday: number
		openMin: number
		closeMin: number
		openLabel: string
		closeLabel: string
		spotIds: string[]
		enrolled: number
		capacity: number
		full: boolean
		paused: boolean
	}

	type CalCell = {
		key: string
		day: number
		inMonth: boolean
		open: boolean
		full: boolean
		paused: boolean
		selected: boolean
		isToday: boolean
		openLabel: string
		enrollLabel: string
		year: number
		month: number
	}

	type ScheduleItem = {
		id: string
		title: string
		stayText: string
	}

	type DayRouteEntry = {
		dayKey: string
		spotIds: string[]
	}

	const weekLabels: string[] = ['日', '一', '二', '三', '四', '五', '六']

	const projectId = ref('')
	const project = ref<StudyProjectMeta | null>(null)
	const travelers = ref<Traveler[]>([])
	const selectedTravelerIds = ref<string[]>([])
	const allSpots = ref<SpotOption[]>([])
	const daySlots = ref<DaySlot[]>([])
	/** 已选日期 key，按选择顺序 */
	const selectedDayKeys = ref<string[]>([])
	/** 每天已选点位（无顺序） */
	const dayRoutes = ref<DayRouteEntry[]>([])
	const activeDayKey = ref('')
	const selectedZoneKey = ref('all')
	const focusedSpotId = ref('')
	const spotGuideOpen = ref(true)
	const routeMapScale = ref(16)
	const routeMapNudge = ref(0)
	const SPOT_LIST_PREVIEW = 3
	const showSpotDetail = ref(false)
	const detailSpot = ref<SpotOption | null>(null)
	const viewYear = ref(2026)
	const viewMonth = ref(1)

	const zoneFilters = ref<StudyRouteZoneFilter[]>(buildRouteZoneFilters([] as StudyRouteZoneSpot[], [] as StudyRouteZoneFilter[]))
	const zoneLabelOf = (key: string): string => {
		const list = zoneFilters.value
		for (let i = 0; i < list.length; i++) {
			if (list[i].key === key) return list[i].label
		}
		return studyRouteZoneLabelOf(key)
	}

	const isSubmitting = ref(false)
	const aiPlanning = ref(false)
	const aiPlanHint = ref('')
	const calendarTick = ref(0)

	/** AI 对话规划 */
	type AiSpotCard = {
		id: string
		title: string
		zoneLabel: string
		durationText: string
		desc: string
		coverStyle: string
		coverIcon: string
		photoCaption: string
		dayKey: string
	}
	type AiDriverCard = {
		id: string
		name: string
		avatar: string
		vehicleName: string
		vehicleType: string
		plateNo: string
		phone: string
		wechat: string
		seats: number
		priceText: string
		statusLabel: string
		available: boolean
		distanceText: string
		price: number
	}
	type AiDayCard = {
		dayKey: string
		label: string
		routeText: string
		stopCount: number
	}
	type AiChatMsg = {
		id: string
		role: string
		text: string
		isPlan: boolean
		spots: AiSpotCard[]
		drivers: AiDriverCard[]
		days: AiDayCard[]
		rentalId: string
		rentalName: string
		rentalHint: string
		showRental: boolean
		needDrivers: boolean
		driverTip: string
		showAudienceEntry: boolean
	}
	type AiQuickChip = {
		id: string
		label: string
		text: string
	}
	const showAiChat = ref(false)
	const aiThinking = ref(false)
	const aiInputText = ref('')
	const aiScrollInto = ref('')
	const aiMsgSeq = ref(0)
	const aiMessages = ref<AiChatMsg[]>([])
	const aiHasPendingPlan = ref(false)
	const aiPendingDayKeys = ref<string[]>([])
	const aiPendingSpotIdsByDay = ref<string[]>([])
	const aiPendingRentalId = ref('none')
	const aiPendingRentalName = ref('不租车')
	const aiPendingSummary = ref('')
	const aiPrefZone = ref('all')
	const aiPrefPace = ref('balanced')
	const aiPrefNeedCar = ref('auto')
	const aiPrefKids = ref(false)
	const aiPrefTeam = ref(false)
	const aiPlanVariant = ref(0)
	const aiActiveTemplateId = ref('')
	const pendingAudienceTplId = ref('')
	const audienceTemplates = computed((): AudienceSpotTemplate[] => {
		const proj = project.value
		if (proj == null) return [] as AudienceSpotTemplate[]
		const src = proj.audienceTemplates
		if (src == null) return [] as AudienceSpotTemplate[]
		const out: AudienceSpotTemplate[] = []
		for (let i = 0; i < src.length; i++) {
			if (src[i].enabled !== false) out.push(src[i])
		}
		return out
	})
	const applyPendingAudienceIfReady = () => {
		const id = pendingAudienceTplId.value
		if (id.length === 0) return
		const list = audienceTemplates.value
		let tpl: AudienceSpotTemplate | null = null
		for (let i = 0; i < list.length; i++) {
			if (list[i].id === id) tpl = list[i]
		}
		if (tpl == null) return
		if (selectedDayKeys.value.length === 0) return
		if (allSpots.value.length === 0) return
		pendingAudienceTplId.value = ''
		applyAudienceTemplate(tpl)
	}
	const goAudiencePlans = () => {
		const id = projectId.value
		if (id.length === 0) return
		uni.navigateTo({ url: '/pages/appointment/audience-plans?projectId=' + id + '&from=booking' })
	}
	const goAudiencePlansFromAi = () => {
		showAiChat.value = false
		goAudiencePlans()
	}
	const aiQuickChips = ref<AiQuickChip[]>([
		{ id: 'q1', label: '亲子轻松', text: '一家带小孩，想轻松好玩，每天少选几个点，先出方案并带点位图' },
		{ id: 'q2', label: '高校研学', text: '学生团队，偏职业和实验室方向，节奏可以紧凑些，按已选日期推荐点位' },
		{ id: 'q3', label: '商务接待', text: '接待客户，想看展陈和产线观摩，节奏适中，按已选日期推荐点位' },
		{ id: 'q4', label: '一键出方案', text: '按我已选的日期，直接给每天的点位推荐，带图文；顺便提一句要不要叫车' },
		{ id: 'q5', label: '只要点位', text: '先不用车，只帮我把多日点位搭配好，展示详情就行' },
		{ id: 'q6', label: '怎么叫车', text: '想叫车的话怎么发单？司机会怎么接单议价？简单说下步骤' },
		{ id: 'q7', label: '人多稳妥', text: '我们大概十五人以上，点位别排太满，节奏稳一点' },
		{ id: 'q8', label: '两天混搭', text: '两天想混着来：一天偏亲子轻松，一天偏商务或高校，请按天给点位' },
		{ id: 'q9', label: '再轻松点', text: '上一版有点赶，帮我改轻松些，每天少几个点' },
		{ id: 'q10', label: '按人数来', text: '按页面上已选的人数，帮我看看每天选几个点比较合适' }
	])



	const pad2 = (n: number): string => {
		return n < 10 ? '0' + n.toString() : n.toString()
	}

	const dayKeyOf = (y: number, m: number, d: number): string => {
		return y.toString() + '-' + pad2(m) + '-' + pad2(d)
	}

	const chinaDateKeyNow = (): string => {
		const now = new Date()
		const utc = now.getTime() + now.getTimezoneOffset() * 60000
		const china = new Date(utc + 8 * 3600000)
		const y = china.getFullYear()
		const m = china.getMonth() + 1
		const d = china.getDate()
		return dayKeyOf(y, m, d)
	}

	const todayKey = (): string => {
		return chinaDateKeyNow()
	}

	const addDaysKey = (key: string, days: number): string => {
		const parts = key.split('-')
		if (parts.length < 3) return key
		const y = parseInt(parts[0])
		const m = parseInt(parts[1])
		const d = parseInt(parts[2])
		const dt = new Date(y, m - 1, d)
		dt.setDate(dt.getDate() + days)
		return dayKeyOf(dt.getFullYear(), dt.getMonth() + 1, dt.getDate())
	}

	const projectBookableDays = (): number => {
		const p = project.value
		if (p == null) return 7
		const n = Math.floor(Number(p.bookableDays))
		if (!Number.isFinite(n) || n <= 0) return 7
		if (n > 365) return 365
		return n
	}

	const dayOpsOf = (key: string): any => {
		const p = project.value
		if (p == null || p.dayOps == null) return null
		const map = p.dayOps as any
		return map[key]
	}

		const scheduleDayOf = (key: string): any => {
		const p = project.value
		if (p == null) return null
		const list = (p as any).scheduleDays as any
		if (list == null || !Array.isArray(list)) return null
		for (let i = 0; i < list.length; i++) {
			const d = list[i]
			if (d != null && String(d['date'] || '') == key) return d
		}
		return null
	}
const isDayPaused = (key: string): boolean => {
		const ops = dayOpsOf(key)
		return ops != null && ops['paused'] == true
	}

	const dayCapacityOf = (key: string): number => {
		const ops = dayOpsOf(key)
		if (ops != null && ops['capacity'] != null) {
			const c = Math.floor(Number(ops['capacity']))
			if (Number.isFinite(c) && c >= 0) return c
		}
		const p = project.value
		if (p != null && p.maxCapacity > 0) return p.maxCapacity
		return 99
	}

	const spotVisibleOnSelectedDay = (spotId: string): boolean => {
		const key = activeDayKey.value
		if (key == null || String(key).length < 8) return true
		const sd = scheduleDayOf(String(key))
		if (sd == null) return true
		const closed = sd['closedSpotIds'] as any
		if (closed != null && Array.isArray(closed)) {
			for (let i = 0; i < closed.length; i++) {
				if (String(closed[i]) == spotId) return false
			}
		}
		if (sd['spotsConfigured'] == true) {
			const ids = sd['enabledSpotIds'] as any
			if (ids != null && Array.isArray(ids)) {
				for (let i = 0; i < ids.length; i++) {
					if (String(ids[i]) == spotId) return true
				}
				return false
			}
		}
		return true
	}

	const isWithinBookableWindow = (key: string): boolean => {
		const today = todayKey()
		const end = addDaysKey(today, projectBookableDays())
		return key >= today && key < end
	}

	const formatClock = (totalMinutes: number): string => {
		let m = totalMinutes
		if (m < 0) m = 0
		if (m >= 24 * 60) m = 24 * 60 - 1
		const hh = Math.floor(m / 60)
		const mm = m - hh * 60
		return pad2(hh) + ':' + pad2(mm)
	}
	const compactClock = (totalMinutes: number): string => {
		let m = totalMinutes
		if (m < 0) m = 0
		if (m >= 24 * 60) m = 24 * 60 - 1
		const hh = Math.floor(m / 60)
		const mm = m - hh * 60
		if (mm === 0) return hh.toString()
		return hh.toString() + ':' + pad2(mm)
	}
	const compactRange = (openMin: number, closeMin: number): string => {
		return compactClock(openMin) + '–' + compactClock(closeMin)
	}

	const formatStay = (mins: number): string => {
		if (mins < 60) return mins.toString() + ' 分钟'
		const h = Math.floor(mins / 60)
		const r = mins - h * 60
		if (r === 0) return h.toString() + ' 小时'
		return h.toString() + ' 小时 ' + r.toString() + ' 分'
	}

	const findSpot = (id: string): SpotOption | null => {
		const list = allSpots.value
		for (let i = 0; i < list.length; i++) {
			if (list[i].id === id) return list[i]
		}
		return null
	}

	const findDaySlot = (key: string): DaySlot | null => {
		const list = daySlots.value
		for (let i = 0; i < list.length; i++) {
			if (list[i].key === key) return list[i]
		}
		return null
	}

	const getRouteIds = (dayKey: string): string[] => {
		const list = dayRoutes.value
		for (let i = 0; i < list.length; i++) {
			if (list[i].dayKey === dayKey) {
				const ids = list[i].spotIds
				const out: string[] = []
				for (let j = 0; j < ids.length; j++) out.push(ids[j])
				return out
			}
		}
		return [] as string[]
	}

	const setRouteIds = (dayKey: string, ids: string[]) => {
		const list = dayRoutes.value
		const next: DayRouteEntry[] = []
		let found = false
		const copyIds: string[] = []
		for (let j = 0; j < ids.length; j++) copyIds.push(ids[j])
		for (let i = 0; i < list.length; i++) {
			if (list[i].dayKey === dayKey) {
				next.push({ dayKey: dayKey, spotIds: copyIds })
				found = true
			} else {
				const oldIds = list[i].spotIds
				const keep: string[] = []
				for (let j = 0; j < oldIds.length; j++) keep.push(oldIds[j])
				next.push({ dayKey: list[i].dayKey, spotIds: keep })
			}
		}
		if (!found) next.push({ dayKey: dayKey, spotIds: copyIds })
		dayRoutes.value = next
		calendarTick.value++
	}

	const participantCount = computed((): number => selectedTravelerIds.value.length)


	const remainingSeats = computed((): number => {
		const p = project.value
		if (p == null || p.maxCapacity <= 0) return 999999
		const left = p.maxCapacity - p.enrolled
		return left > 0 ? left : 0
	})

	const bookingTotalAmount = computed((): string => {
		const p = project.value
		if (p == null) return '0.00'
		const price = parseFloat(p.price)
		const days = selectedDayKeys.value.length
		const dayMul = days > 0 ? days : 1
		const seats = isNaN(price) ? 0 : price * participantCount.value * dayMul
		return seats.toFixed(2) // 预约金额不含租车
	})

	const totalSelectedStops = computed((): number => {
		const _t = calendarTick.value
		let n = 0
		const keys = selectedDayKeys.value
		for (let i = 0; i < keys.length; i++) {
			n += getRouteIds(keys[i]).length
		}
		return n
	})

	const calendarTitle = computed((): string => {
		return viewYear.value.toString() + '年' + viewMonth.value.toString() + '月'
	})

	const isDaySelected = (key: string): boolean => {
		const list = selectedDayKeys.value
		for (let i = 0; i < list.length; i++) {
			if (list[i] === key) return true
		}
		return false
	}

	const calendarCells = computed((): CalCell[] => {
		const _t = calendarTick.value
		const y = viewYear.value
		const m = viewMonth.value
		const first = new Date(y, m - 1, 1)
		const startWeek = first.getDay()
		const daysInMonth = new Date(y, m, 0).getDate()
		const tkToday = todayKey()
		const tkParts = tkToday.split("-")
		const ty = parseInt(tkParts[0])
		const tm = parseInt(tkParts[1])
		const td = parseInt(tkParts[2])
		const cells: CalCell[] = []
		// leading blanks from prev month
		const prevDays = new Date(y, m - 1, 0).getDate()
		for (let i = 0; i < startWeek; i++) {
			const d = prevDays - startWeek + 1 + i
			const pm = m === 1 ? 12 : m - 1
			const py = m === 1 ? y - 1 : y
			cells.push({
				key: 'p-' + dayKeyOf(py, pm, d),
				day: d,
				inMonth: false,
				open: false,
				full: false,
				paused: false,
				selected: false,
				isToday: false,
				openLabel: '',
				enrollLabel: '',
				year: py,
				month: pm
			})
		}
		for (let d = 1; d <= daysInMonth; d++) {
			const key = dayKeyOf(y, m, d)
			const slot = findDaySlot(key)
			const paused = isDayPaused(key)
			const inWindow = isWithinBookableWindow(key)
			const sd = scheduleDayOf(key)
			let scheduleOpen = true
			if (sd != null) {
				scheduleOpen = sd['open'] == true
			}
			const open = slot != null && inWindow && !paused && scheduleOpen
			const full = open && slot != null ? slot.full : false
			let enrollLabel = ''
			if (open && slot != null && !full) {
				enrollLabel = slot.enrolled.toString() + '/' + slot.capacity.toString()
			}
			cells.push({
				key: key,
				day: d,
				inMonth: true,
				open: open,
				full: full,
				paused: paused,
				selected: isDaySelected(key),
				isToday: y === ty && m === tm && d === td,
				openLabel: open && slot != null ? compactRange(slot.openMin, slot.closeMin) : '',
				enrollLabel: enrollLabel,
				year: y,
				month: m
			})
		}
		// trailing to fill 6 weeks max
		while (cells.length % 7 !== 0) {
			const n = cells.length - startWeek - daysInMonth + 1
			const nm = m === 12 ? 1 : m + 1
			const ny = m === 12 ? y + 1 : y
			cells.push({
				key: 'n-' + dayKeyOf(ny, nm, n),
				day: n,
				inMonth: false,
				open: false,
				full: false,
				paused: false,
				selected: false,
				isToday: false,
				openLabel: '',
				enrollLabel: '',
				year: ny,
				month: nm
			})
		}
		return cells
	})

	const activeDaySpotIds = computed((): string[] => {
		const _t = calendarTick.value
		if (activeDayKey.value.length === 0) return [] as string[]
		return getRouteIds(activeDayKey.value)
	})

	const spotsForActiveDayBase = computed((): SpotOption[] => {
		const slot = findDaySlot(activeDayKey.value)
		const out: SpotOption[] = []
		if (slot == null) {
			const list = allSpots.value
			for (let i = 0; i < list.length; i++) out.push(list[i])
			return out
		}
		for (let i = 0; i < slot.spotIds.length; i++) {
			const s = findSpot(slot.spotIds[i])
			if (s != null) out.push(s)
		}
		if (out.length === 0) {
			const list = allSpots.value
			for (let i = 0; i < list.length; i++) out.push(list[i])
		}
		return out
	})

	const spotsForActiveDay = computed((): SpotOption[] => {
		const base0 = spotsForActiveDayBase.value
		const base: SpotOption[] = []
		for (let bi = 0; bi < base0.length; bi++) {
			if (spotVisibleOnSelectedDay(base0[bi].id)) base.push(base0[bi])
		}
		const zone = selectedZoneKey.value
		if (zone === 'all') return base
		const out: SpotOption[] = []
		for (let i = 0; i < base.length; i++) {
			if (base[i].zoneKey === zone) out.push(base[i])
		}
		return out
	})

	const routeMapLatitude = computed((): number => {
		const list = spotsForActiveDay.value
		const fid = focusedSpotId.value
		if (fid.length > 0) {
			for (let i = 0; i < list.length; i++) {
				if (list[i].id === fid) return list[i].latitude + routeMapNudge.value
			}
		}
		if (list.length === 0) return 40.509204
		let sum = 0
		for (let j = 0; j < list.length; j++) sum = sum + list[j].latitude
		return sum / list.length
	})

	const routeMapLongitude = computed((): number => {
		const list = spotsForActiveDay.value
		const fid = focusedSpotId.value
		if (fid.length > 0) {
			for (let i = 0; i < list.length; i++) {
				if (list[i].id === fid) return list[i].longitude
			}
		}
		if (list.length === 0) return 111.826493
		let sum = 0
		for (let j = 0; j < list.length; j++) sum = sum + list[j].longitude
		return sum / list.length
	})

	const routeMapIncludePoints = computed((): any[] => {
		if (focusedSpotId.value.length > 0) {
			const empty: any[] = []
			return empty
		}
		const list = spotsForActiveDay.value
		const pts: any[] = []
		for (let i = 0; i < list.length; i++) {
			pts.push({ latitude: list[i].latitude, longitude: list[i].longitude })
		}
		return pts
	})

	const routeMapMarkers = computed((): any[] => {
		const _t = calendarTick.value
		const list = spotsForActiveDay.value
		const selected = getRouteIds(activeDayKey.value)
		const markers: any[] = []
		for (let i = 0; i < list.length; i++) {
			const s = list[i]
			let selectedOn = false
			for (let j = 0; j < selected.length; j++) {
				if (selected[j] === s.id) {
					selectedOn = true
					break
				}
			}
			let bg = '#FFFFFF'
			let color = '#1A1A1A'
			let label = s.title
			if (selectedOn) {
				bg = '#1A73E8'
				color = '#FFFFFF'
				label = '\u2713 ' + s.title
			}
			const marker: any = {
				id: i + 1,
				latitude: s.latitude,
				longitude: s.longitude,
				title: s.title,
				iconPath: selectedOn ? '/static/map-pin-on.png' : '/static/map-pin.png',
				width: 28,
				height: 36,
				callout: {
					content: label,
					display: 'ALWAYS',
					padding: 6,
					borderRadius: 8,
					borderWidth: 0,
					fontSize: 11,
					color: color,
					bgColor: bg
				}
			}
			markers.push(marker)
		}
		return markers
	})

	const goSpotListPage = () => {
		const key = activeDayKey.value
		if (key.length === 0) {
			uni.showToast({ title: '请先选择日期', icon: 'none' })
			return
		}
		const ids = getRouteIds(key)
		let selected = ''
		for (let i = 0; i < ids.length; i++) {
			if (i > 0) selected = selected + ','
			selected = selected + ids[i]
		}
		let url = '/pages/appointment/route-list?mode=pick&dayKey=' + encodeURIComponent(key)
		const pid = projectId.value
		if (pid.length > 0) url = url + '&projectId=' + encodeURIComponent(pid)
		if (selectedZoneKey.value.length > 0 && selectedZoneKey.value !== 'all') {
			url = url + '&zone=' + encodeURIComponent(selectedZoneKey.value)
		}
		if (selected.length > 0) url = url + '&selected=' + encodeURIComponent(selected)
		uni.navigateTo({ url: url })
	}


