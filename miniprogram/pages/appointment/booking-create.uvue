	const durationLabelOf = (spot: SpotOption | null): string => {
		if (spot != null) {
			const t = spot.durationText.trim()
			if (t.length > 0) {
				if (t.indexOf('约') === 0) return t
				return '约 ' + t
			}
			if (spot.durationMin > 0) return '约 ' + formatStay(spot.durationMin)
		}
		return '约 20 分钟'
	}

	const activeDaySchedule = computed((): ScheduleItem[] => {
		const _t = calendarTick.value
		const key = activeDayKey.value
		const ids = getRouteIds(key)
		const out: ScheduleItem[] = []
		for (let i = 0; i < ids.length; i++) {
			const sid = ids[i]
			const spot = findSpot(sid)
			out.push({
				id: sid,
				title: spot != null ? spot.title : '点位',
				stayText: durationLabelOf(spot)
			})
		}
		return out
	})













	const goBack = () => { uni.navigateBack() }

	const maskPhone = (phone: string): string => {
		if (phone == null || phone.length < 7) return phone != null ? phone : ''
		if (phone.length === 11) return phone.substring(0, 3) + ' **** ' + phone.substring(7)
		return phone
	}

	const isTravelerSelected = (id: string): boolean => {
		const list = selectedTravelerIds.value
		for (let i = 0; i < list.length; i++) if (list[i] === id) return true
		return false
	}

	const toggleTraveler = (id: string) => {
		const next: string[] = []
		let found = false
		const list = selectedTravelerIds.value
		for (let i = 0; i < list.length; i++) {
			if (list[i] === id) found = true
			else next.push(list[i])
		}
		if (!found) next.push(id)
		selectedTravelerIds.value = next
	}

	const shiftMonth = (delta: number) => {
		let y = viewYear.value
		let m = viewMonth.value + delta
		if (m < 1) {
			m = 12
			y--
		} else if (m > 12) {
			m = 1
			y++
		}
		viewYear.value = y
		viewMonth.value = m
		ensureMonthSlots(y, m, allSpots.value)
		calendarTick.value++
	}

	/** 两日期间隔天数（按自然日） */
	const toggleDay = (cell: CalCell) => {
		if (!cell.inMonth || cell.day <= 0) return
		if (!cell.open) {
			if (cell.key < todayKey()) {
				uni.showToast({ title: '不能预约过去的日期', icon: 'none' })
				return
			}
			if (cell.paused) {
				uni.showToast({ title: '该日已暂停预约', icon: 'none' })
				return
			}
			if (!isWithinBookableWindow(cell.key)) {
				uni.showToast({ title: '仅可预约未来 ' + projectBookableDays().toString() + ' 天', icon: 'none' })
				return
			}
			uni.showToast({ title: '该日未开放', icon: 'none' })
			return
		}
		if (cell.full) {
			uni.showToast({ title: '该日报名已满', icon: 'none' })
			return
		}
		const key = cell.key
		const list = selectedDayKeys.value
		let found = false
		for (let i = 0; i < list.length; i++) {
			if (list[i] === key) {
				found = true
				break
			}
		}

		if (found) {
			const next: string[] = []
			for (let i = 0; i < list.length; i++) {
				if (list[i] !== key) next.push(list[i])
			}
			setRouteIds(key, [] as string[])
			selectedDayKeys.value = next
			if (activeDayKey.value === key) {
				activeDayKey.value = next.length > 0 ? next[next.length - 1] : ''
			}
		} else {
			const next: string[] = []
			for (let i = 0; i < list.length; i++) next.push(list[i])
			next.push(key)
			if (getRouteIds(key).length === 0) setRouteIds(key, [] as string[])
			selectedDayKeys.value = next
			activeDayKey.value = key
			applyPendingAudienceIfReady()
		}
		aiPlanHint.value = ''
		calendarTick.value++
	}

	const setActiveDay = (key: string) => {
		activeDayKey.value = key
		// 换日保留分区筛选，仅清提示
		aiPlanHint.value = ''
	}

	const dayShortLabel = (key: string): string => {
		const parts = key.split('-')
		if (parts.length < 3) return key
		return parseInt(parts[1]).toString() + '/' + parseInt(parts[2]).toString()
	}

	const dayFullLabel = (key: string): string => {
		const parts = key.split('-')
		if (parts.length < 3) return key
		const m = parseInt(parts[1])
		const d = parseInt(parts[2])
		const slot = findDaySlot(key)
		const wd = slot != null ? weekLabels[slot.weekday] : ''
		return m.toString() + '月' + d.toString() + '日' + (wd.length > 0 ? ' 周' + wd : '')
	}

	const dayOpenCloseText = (key: string): string => {
		const slot = findDaySlot(key)
		if (slot == null) return '—'
		return slot.openLabel + ' – ' + slot.closeLabel
	}


	const toggleSpotOnActiveDay = (id: string) => {
		const key = activeDayKey.value
		if (key.length === 0) return
		const ids = getRouteIds(key)
		const next: string[] = []
		let found = false
		for (let i = 0; i < ids.length; i++) {
			if (ids[i] === id) found = true
			else next.push(ids[i])
		}
		if (!found) next.push(id)
		setRouteIds(key, next)
		aiPlanHint.value = ''
		uni.showToast({ title: found ? '取消选择' : '已选择', icon: 'none' })
	}


	const selectAllSpotsForActiveDay = () => {
		const key = activeDayKey.value
		if (key.length === 0) return
		// 全选当前分区可见点；保留其他分区已选
		const visible = spotsForActiveDay.value
		const prev = getRouteIds(key)
		const next: string[] = []
		// 先保留不在当前列表里的（其他分区）
		for (let i = 0; i < prev.length; i++) {
			let inVisible = false
			for (let j = 0; j < visible.length; j++) {
				if (visible[j].id === prev[i]) {
					inVisible = true
					break
				}
			}
			// 若当前是「全部」分区，visible 即全部，inVisible 恒真；若筛选分区，保留区外已选
			const spot = findSpot(prev[i])
			if (selectedZoneKey.value !== 'all') {
				if (spot != null && spot.zoneKey !== selectedZoneKey.value) next.push(prev[i])
			}
		}
		for (let i = 0; i < visible.length; i++) next.push(visible[i].id)
		setRouteIds(key, next)
		const zoneName = selectedZoneKey.value === 'all' ? '本日全部' : zoneLabelOf(selectedZoneKey.value)
		aiPlanHint.value = '已选' + zoneName + '点位，可点 AI 规划'
	}

	const clearSpotsForActiveDay = () => {
		const key = activeDayKey.value
		if (key.length === 0) return
		// 仅清空当前分区可见点，其它分区已选保留
		if (selectedZoneKey.value === 'all') {
			setRouteIds(key, [] as string[])
			aiPlanHint.value = ''
			return
		}
		const visible = spotsForActiveDay.value
		const prev = getRouteIds(key)
		const next: string[] = []
		for (let i = 0; i < prev.length; i++) {
			let inVisible = false
			for (let j = 0; j < visible.length; j++) {
				if (visible[j].id === prev[i]) {
					inVisible = true
					break
				}
			}
			if (!inVisible) next.push(prev[i])
		}
		setRouteIds(key, next)
		aiPlanHint.value = ''
	}

	const dist2 = (a: SpotOption, b: SpotOption): number => {
		const dLat = a.latitude - b.latitude
		const dLng = a.longitude - b.longitude
		return dLat * dLat + dLng * dLng
	}

	const nearestOrderSpots = (seed: SpotOption[]): SpotOption[] => {
		if (seed.length === 0) return [] as SpotOption[]
		let startIdx = 0
		for (let i = 1; i < seed.length; i++) {
			if (seed[i].sortOrder < seed[startIdx].sortOrder) startIdx = i
		}
		// 再规划时换起点，避免每次同一条
		if (seed.length > 1 && aiPlanVariant.value > 0) {
			startIdx = (startIdx + aiPlanVariant.value) % seed.length
		}
		const used: boolean[] = []
		for (let i = 0; i < seed.length; i++) used.push(false)
		const ordered: SpotOption[] = []
		ordered.push(seed[startIdx])
		used[startIdx] = true
		while (ordered.length < seed.length) {
			const curS = ordered[ordered.length - 1]
			let best = -1
			let bestD = 0
			for (let i = 0; i < seed.length; i++) {
				if (used[i]) continue
				const d = dist2(curS, seed[i])
				if (best < 0 || d < bestD) {
					best = i
					bestD = d
				}
			}
			if (best < 0) break
			ordered.push(seed[best])
			used[best] = true
		}
		return ordered
	}

	const filterSpotsByZonePref = (pool: SpotOption[], zonePref: string, dayIndex: number, dayCount: number): SpotOption[] => {
		const out: SpotOption[] = []
		if (zonePref === 'mixed' && dayCount > 1) {
			const orderKeys: string[] = ['family', 'college', 'business']
			const primary = orderKeys[dayIndex % orderKeys.length]
			for (let i = 0; i < pool.length; i++) {
				if (pool[i].zoneKey === primary) out.push(pool[i])
			}
			if (out.length >= 2) return out
		}
		if (zonePref === 'family' || zonePref === 'college' || zonePref === 'business') {
			for (let i = 0; i < pool.length; i++) {
				if (pool[i].zoneKey === zonePref) out.push(pool[i])
			}
			if (out.length > 0) return out
		}
		for (let i = 0; i < pool.length; i++) out.push(pool[i])
		return out
	}

	const pickSpotsForDayWindow = (candidates: SpotOption[], openMin: number, closeMin: number, pace: string): string[] => {
		const windowMin = closeMin > openMin ? (closeMin - openMin) : 240
		let targetStay = Math.floor(windowMin * 0.72)
		if (pace === 'light') targetStay = Math.floor(windowMin * 0.48)
		if (pace === 'full') targetStay = Math.floor(windowMin * 0.88)
		if (targetStay < 40) targetStay = 40
		const ordered = nearestOrderSpots(candidates)
		const ids: string[] = []
		let used = 0
		const transfer = 12
		for (let i = 0; i < ordered.length; i++) {
			const stay = ordered[i].durationMin > 0 ? ordered[i].durationMin : 40
			const extra = ids.length > 0 ? transfer : 0
			if (ids.length > 0 && used + extra + stay > targetStay) {
				if (pace !== 'full' || used + extra + 25 > windowMin) break
			}
			if (used + extra + stay > windowMin && ids.length > 0) break
			ids.push(ordered[i].id)
			used = used + extra + stay
			if (pace === 'light' && ids.length >= 2) break
			if (pace === 'balanced' && ids.length >= 4) break
			if (pace === 'full' && ids.length >= 6) break
		}
		if (ids.length === 0 && ordered.length > 0) ids.push(ordered[0].id)
		return ids
	}








	const aiNextMsgId = (): string => {
		aiMsgSeq.value = aiMsgSeq.value + 1
		return 'ai-m-' + aiMsgSeq.value.toString()
	}

	const emptyAiMsg = (role: string, text: string, isPlan: boolean): AiChatMsg => {
		return {
			id: aiNextMsgId(),
			role: role,
			text: text,
			isPlan: isPlan,
			spots: [] as AiSpotCard[],
			drivers: [] as AiDriverCard[],
			days: [] as AiDayCard[],
			rentalId: '',
			rentalName: '',
			rentalHint: '',
			showRental: false,
			needDrivers: false,
			driverTip: '',
			showAudienceEntry: false
		}
	}

	const cloneAiMsg = (m: AiChatMsg): AiChatMsg => {
		const spots: AiSpotCard[] = []
		for (let i = 0; i < m.spots.length; i++) {
			const s = m.spots[i]
			spots.push({
				id: s.id, title: s.title, zoneLabel: s.zoneLabel, durationText: s.durationText,
				desc: s.desc, coverStyle: s.coverStyle, coverIcon: s.coverIcon,
				photoCaption: s.photoCaption, dayKey: s.dayKey
			})
		}
		const drivers: AiDriverCard[] = []
		for (let i = 0; i < m.drivers.length; i++) {
			const d = m.drivers[i]
			drivers.push({
				id: d.id, name: d.name, avatar: d.avatar, vehicleName: d.vehicleName,
				vehicleType: d.vehicleType, plateNo: d.plateNo, phone: d.phone, wechat: d.wechat,
				seats: d.seats, priceText: d.priceText, statusLabel: d.statusLabel, available: d.available,
				distanceText: d.distanceText, price: d.price
			})
		}
		const days: AiDayCard[] = []
		for (let i = 0; i < m.days.length; i++) {
			const d = m.days[i]
			days.push({ dayKey: d.dayKey, label: d.label, routeText: d.routeText, stopCount: d.stopCount })
		}
		return {
			id: m.id, role: m.role, text: m.text, isPlan: m.isPlan,
			spots: spots, drivers: drivers, days: days,
			rentalId: m.rentalId, rentalName: m.rentalName, rentalHint: m.rentalHint,
			showRental: m.showRental, needDrivers: m.needDrivers, driverTip: m.driverTip, showAudienceEntry: m.showAudienceEntry
		}
	}

	const pushAiMessage = (role: string, text: string, isPlan: boolean): string => {
		const list = aiMessages.value
		const next: AiChatMsg[] = []
		for (let i = 0; i < list.length; i++) next.push(cloneAiMsg(list[i]))
		const msg = emptyAiMsg(role, text, isPlan)
		next.push(msg)
		aiMessages.value = next
		aiScrollInto.value = ''
		setTimeout(() => {
			aiScrollInto.value = 'ai-msg-end'
		}, 30)
		return msg.id
	}

	const updateAiMessageById = (id: string, patcher: (m: AiChatMsg) => void) => {
		const list = aiMessages.value
		const next: AiChatMsg[] = []
		for (let i = 0; i < list.length; i++) {
			const c = cloneAiMsg(list[i])
			if (c.id === id) patcher(c)
			next.push(c)
		}
		aiMessages.value = next
		setTimeout(() => {
			aiScrollInto.value = 'ai-msg-end'
		}, 20)
	}

	const buildAiSpotCards = (dayKeys: string[], spotLists: any[]): AiSpotCard[] => {
		const out: AiSpotCard[] = []
		const seen: string[] = []
		for (let di = 0; di < dayKeys.length; di++) {
			const dk = dayKeys[di]
			const ids = spotLists[di]
			for (let j = 0; j < ids.length; j++) {
				const id = ids[j]
				let dup = false
				for (let s = 0; s < seen.length; s++) {
					if (seen[s] === id) { dup = true; break }
				}
				if (dup) continue
				seen.push(id)
				const spot = findSpot(id)
				if (spot == null) continue
				out.push({
					id: spot.id,
					title: spot.title,
					zoneLabel: spot.zoneLabel,
					durationText: spot.durationText,
					desc: spot.desc,
					coverStyle: spot.coverStyle,
					coverIcon: spot.coverIcon,
					photoCaption: spot.photoCaption,
					dayKey: dk
				})
				if (out.length >= 12) return out
			}
		}
		return out
	}

	const buildAiDayCards = (dayKeys: string[], spotLists: any[]): AiDayCard[] => {
		const out: AiDayCard[] = []
		for (let di = 0; di < dayKeys.length; di++) {
			const dk = dayKeys[di]
			const ids = spotLists[di]
			const names: string[] = []
			for (let j = 0; j < ids.length; j++) {
				const s = findSpot(ids[j])
				if (s != null) names.push(s.title)
			}
			let routeText = '（暂无点位）'
			if (names.length > 0) {
				routeText = names[0]
				for (let n = 1; n < names.length; n++) routeText = routeText + '、' + names[n]
			}
			out.push({
				dayKey: dk,
				label: dayShortLabel(dk) + ' · ' + dayOpenCloseText(dk),
				routeText: routeText,
				stopCount: ids.length
			})
		}
		return out
	}



	const enrichPlanMessage = (msgId: string, reply: string, dayKeys: string[], spotLists: string[][], rentalId: string, loadDrv: boolean) => {
		void loadDrv
		const spots = buildAiSpotCards(dayKeys, spotLists)
		const days = buildAiDayCards(dayKeys, spotLists)
		const people = participantCount.value
		const needCarHint = rentalId !== 'none' || aiPrefNeedCar.value === 'yes'
		updateAiMessageById(msgId, (m) => {
			m.text = reply
			m.isPlan = true
			m.spots = spots
			m.days = days
			m.rentalId = 'none'
			m.rentalName = needCarHint ? '建议叫车' : '可自行前往'
			m.rentalHint = needCarHint
				? ((people > 0 ? people.toString() + ' 人，' : '') + '提交预约后可用页面浮动叫车发单，司机接单后议价')
				: '不叫车也可自行前往；需要用车时点浮动叫车发单'
			m.showRental = true
			m.needDrivers = needCarHint
			m.driverTip = needCarHint ? '不在预约里选车型或司机，请用浮动叫车发单' : ''
			m.drivers = [] as AiDriverCard[]
		})
	}


	const openAiSpotDetail = (spotId: string) => {
		const s = findSpot(spotId)
		if (s == null) {
			uni.showToast({ title: '点位不存在', icon: 'none' })
			return
		}
		openSpotDetail(s)
	}

	const addAiSpotToActiveDay = (spotId: string) => {
		const key = activeDayKey.value
		if (key.length === 0) {
			uni.showToast({ title: '请先选择日期', icon: 'none' })
			return
		}
		const prev = getRouteIds(key)
		for (let i = 0; i < prev.length; i++) {
			if (prev[i] === spotId) {
				uni.showToast({ title: '本日已选择', icon: 'none' })
				return
			}
		}
		const next: string[] = []
		for (let i = 0; i < prev.length; i++) next.push(prev[i])
		next.push(spotId)
		setRouteIds(key, next)
		uni.showToast({ title: '已选择', icon: 'success' })
	}

	const applyAiOneDay = (dayKey: string) => {
		const flat = aiPendingSpotIdsByDay.value
		for (let i = 0; i < flat.length; i++) {
			const row = flat[i]
			const sep = row.indexOf('|||')
			if (sep < 0) continue
			const dk = row.substring(0, sep)
			if (dk !== dayKey) continue
			const idsPart = row.substring(sep + 3)
			const ids: string[] = []
			if (idsPart.length > 0) {
				let rest = idsPart
				while (rest.length > 0) {
					const c = rest.indexOf(',')
					if (c < 0) {
						if (rest.length > 0) ids.push(rest)
						break
					}
					const piece = rest.substring(0, c)
					if (piece.length > 0) ids.push(piece)
					rest = rest.substring(c + 1)
				}
			}
			setRouteIds(dk, ids)
			activeDayKey.value = dk
			uni.showToast({ title: '已写入该日点位', icon: 'success' })
			return
		}
		uni.showToast({ title: '未找到该日方案', icon: 'none' })
	}

	const focusAiDay = (dayKey: string) => {
		activeDayKey.value = dayKey
		uni.showToast({ title: '已切换到 ' + dayShortLabel(dayKey), icon: 'none' })
	}

	const goRentalCreateFromAi = () => {
		showAiChat.value = false
		goRentalCreateFromBooking()
	}

	const goRentalCreateFromBooking = () => {
		const pid = projectId.value
		let url = '/pages/appointment/rental-create'
		if (pid != null && pid.length > 0) {
			url = url + '?projectId=' + encodeURIComponent(pid)
		}
		uni.navigateTo({ url: url })
	}





	const parsePendingFlatToLists = (): any => {
		const flat = aiPendingSpotIdsByDay.value
		const dayKeys: string[] = []
		const spotLists: any[] = []
		for (let i = 0; i < flat.length; i++) {
			const row = flat[i]
			const sep = row.indexOf('|||')
			if (sep < 0) continue
			const dk = row.substring(0, sep)
			const idsPart = row.substring(sep + 3)
			const ids: string[] = []
			if (idsPart.length > 0) {
				let rest = idsPart
				while (rest.length > 0) {
					const c = rest.indexOf(',')
					if (c < 0) {
						if (rest.length > 0) ids.push(rest)
						break
					}
					const piece = rest.substring(0, c)
					if (piece.length > 0) ids.push(piece)
					rest = rest.substring(c + 1)
				}
			}
			dayKeys.push(dk)
			spotLists.push(ids)
		}
		return { dayKeys: dayKeys, spotLists: spotLists }
	}


	const clearAiPendingPlan = () => {
		aiHasPendingPlan.value = false
		aiPendingDayKeys.value = [] as string[]
		aiPendingSpotIdsByDay.value = [] as string[]
		aiPendingRentalId.value = 'none'
		aiPendingRentalName.value = '不租车'
		aiPendingSummary.value = ''
	}

	const storeAiPendingPlanFlat = (flatRows: string[], rentalId: string, summary: string) => {
		const keys: string[] = []
		for (let i = 0; i < flatRows.length; i++) {
			const row = flatRows[i]
			const sep = row.indexOf('|||')
			if (sep > 0) keys.push(row.substring(0, sep))
		}
		aiPendingDayKeys.value = keys
		aiPendingSpotIdsByDay.value = flatRows
		aiPendingRentalId.value = rentalId
		aiPendingRentalName.value = '不租车'
		aiPendingSummary.value = summary
		aiHasPendingPlan.value = true
	}

	const parsePrefsFromText = (raw: string) => {
		const t = raw
		if (t.indexOf('亲子') >= 0 || t.indexOf('家庭') >= 0 || t.indexOf('小孩') >= 0 || t.indexOf('儿童') >= 0 || t.indexOf('带娃') >= 0) {
			aiPrefZone.value = 'family'
			aiPrefKids.value = true
		}
		if (t.indexOf('高校') >= 0 || t.indexOf('大学') >= 0 || t.indexOf('学生') >= 0 || t.indexOf('职业') >= 0 || t.indexOf('实验室') >= 0) {
			aiPrefZone.value = 'college'
			aiPrefTeam.value = true
		}
		if (t.indexOf('商务') >= 0 || t.indexOf('企业') >= 0 || t.indexOf('接待') >= 0 || t.indexOf('展陈') >= 0 || t.indexOf('产线') >= 0 || t.indexOf('客户') >= 0) {
			aiPrefZone.value = 'business'
			aiPrefTeam.value = true
		}
		if (t.indexOf('都想') >= 0 || t.indexOf('混合') >= 0 || t.indexOf('搭配') >= 0 || t.indexOf('多种') >= 0 || t.indexOf('全部区域') >= 0) {
			aiPrefZone.value = 'mixed'
		}
		if (t.indexOf('轻松') >= 0 || t.indexOf('少点') >= 0 || t.indexOf('不要太赶') >= 0 || t.indexOf('悠闲') >= 0) {
			aiPrefPace.value = 'light'
		}
		if (t.indexOf('多排') >= 0 || t.indexOf('紧凑') >= 0 || t.indexOf('丰富') >= 0 || t.indexOf('尽量多') >= 0) {
			aiPrefPace.value = 'full'
		}
		if (t.indexOf('适中') >= 0 || t.indexOf('平衡') >= 0) {
			aiPrefPace.value = 'balanced'
		}
		if (t.indexOf('不租') >= 0 || t.indexOf('不用车') >= 0 || t.indexOf('自己去') >= 0 || t.indexOf('自行') >= 0 || t.indexOf('不需要租') >= 0) {
			aiPrefNeedCar.value = 'no'
		}
		if (t.indexOf('要租') >= 0 || t.indexOf('租车') >= 0 || t.indexOf('大巴') >= 0 || t.indexOf('中巴') >= 0 || t.indexOf('商务车') >= 0 || t.indexOf('需要车') >= 0 || t.indexOf('大一点的车') >= 0 || t.indexOf('人比较多') >= 0) {
			if (aiPrefNeedCar.value !== 'no') aiPrefNeedCar.value = 'yes'
		}
		if (t.indexOf('团队') >= 0 || t.indexOf('团建') >= 0 || t.indexOf('集体') >= 0) {
			aiPrefTeam.value = true
		}
		if (t.indexOf('改一版') >= 0 || t.indexOf('换一版') >= 0 || t.indexOf('再来') >= 0) {
			aiPlanVariant.value = aiPlanVariant.value + 1
		}
	}

	const wantsImmediatePlan = (raw: string): boolean => {
		if (raw.indexOf('直接') >= 0) return true
		if (raw.indexOf('规划') >= 0) return true
		if (raw.indexOf('方案') >= 0) return true
		if (raw.indexOf('安排') >= 0) return true
		if (raw.indexOf('推荐') >= 0) return true
		if (raw.indexOf('帮我') >= 0) return true
		if (raw.indexOf('出一份') >= 0) return true
		if (raw.indexOf('生成') >= 0) return true
		if (raw.indexOf('改一版') >= 0) return true
		if (raw.indexOf('亲子') >= 0 || raw.indexOf('高校') >= 0 || raw.indexOf('商务') >= 0) return true
		if (raw.indexOf('不租') >= 0 || raw.indexOf('要租') >= 0 || raw.indexOf('大巴') >= 0) return true
		return false
	}

	const buildMultiDayPlanText = (): string => {
		const keys = selectedDayKeys.value
		if (keys.length === 0) {
			return '你还没选研学日期。先在日历里点选开放日（可多选），再让我规划全部行程～'
		}
		const people = participantCount.value
		const zonePref = aiPrefZone.value
		const pace = aiPrefPace.value
		const needCar = aiPrefNeedCar.value
		const all = allSpots.value
		const dayFlatRows: string[] = []
		let totalStops = 0
		const lines: string[] = []
		const usedGlobal: string[] = []

		for (let di = 0; di < keys.length; di++) {
			const dk = keys[di]
			const slot = findDaySlot(dk)
			const openMin = slot != null ? slot.openMin : 9 * 60
			const closeMin = slot != null ? slot.closeMin : 17 * 60
			const pool = filterSpotsByZonePref(all, zonePref, di, keys.length)
			const fresh: SpotOption[] = []
			const reused: SpotOption[] = []
			for (let i = 0; i < pool.length; i++) {
				let seen = false
				for (let u = 0; u < usedGlobal.length; u++) {
					if (usedGlobal[u] === pool[i].id) {
						seen = true
						break
					}
				}
				if (seen) reused.push(pool[i])
				else fresh.push(pool[i])
			}
			let candidates = fresh.length > 0 ? fresh : pool
			if (candidates.length < 2 && reused.length > 0) {
				const merged: SpotOption[] = []
				for (let i = 0; i < fresh.length; i++) merged.push(fresh[i])
				for (let i = 0; i < reused.length; i++) merged.push(reused[i])
				candidates = merged
			}
			const ids = pickSpotsForDayWindow(candidates, openMin, closeMin, pace)
			for (let i = 0; i < ids.length; i++) {
				let exists = false
				for (let u = 0; u < usedGlobal.length; u++) {
					if (usedGlobal[u] === ids[i]) {
						exists = true
						break
					}
				}
				if (!exists) usedGlobal.push(ids[i])
			}
			let joined = ''
			for (let j = 0; j < ids.length; j++) {
				if (j > 0) joined = joined + ','
				joined = joined + ids[j]
			}
			dayFlatRows.push(dk + '|||' + joined)
			totalStops = totalStops + ids.length

			const nameParts: string[] = []
			for (let i = 0; i < ids.length; i++) {
				const s = findSpot(ids[i])
				if (s != null) nameParts.push(s.title)
			}
			const hours = dayOpenCloseText(dk)
			const label = dayShortLabel(dk)
			let routeLine = '（暂无合适点位）'
			if (nameParts.length > 0) {
				routeLine = nameParts[0]
				for (let ni = 1; ni < nameParts.length; ni++) {
					routeLine = routeLine + '、' + nameParts[ni]
				}
			}
			lines.push((di + 1).toString() + ') ' + label + '（' + hours + '）')
			lines.push('   ' + routeLine + ' · 共 ' + ids.length.toString() + ' 个点位')
		}

		const suggestCar = needCar === 'yes' || (needCar !== 'no' && (people >= 3 || aiPrefKids.value || aiPrefTeam.value))
		const rentalId = 'none'
		let zoneLabel = '综合'
		if (zonePref === 'family') zoneLabel = '家庭亲子'
		else if (zonePref === 'college') zoneLabel = '高校研学'
		else if (zonePref === 'business') zoneLabel = '企业商务'
		else if (zonePref === 'mixed') zoneLabel = '多日混搭'
		let paceLabel = '节奏适中'
		if (pace === 'light') paceLabel = '轻松少选'
		if (pace === 'full') paceLabel = '紧凑丰富'

		let peopleText = people > 0 ? (people.toString() + ' 位游客') : '未选游客'
		let carReason = ''
		if (needCar === 'no' || !suggestCar) carReason = '可不叫车，自行前往集合点；园区内可按导航自选前往已选点位。'
		else carReason = '建议叫车：提交预约后点页面浮动叫车发单，司机接单后议价（不在预约里选车型）。'

		let routeBlock = ''
		for (let li = 0; li < lines.length; li++) {
			if (li > 0) routeBlock = routeBlock + '\n'
			routeBlock = routeBlock + lines[li]
		}
		const summary =
			'已按「' + zoneLabel + ' · ' + paceLabel + '」为 ' + keys.length.toString() + ' 天行程做好规划，共 ' + totalStops.toString() + ' 个点位。\n' +
			'游客：' + peopleText + '\n' +
			'用车：' + carReason + '\n\n' +
			'每日推荐点位：\n' + routeBlock + '\n\n' +
			'点「应用点位方案」会写入每一天的已选点位；之后仍可手动微调。到场后可自选前往顺序。若要换风格，直接说「再偏亲子 / 紧凑一点 / 不要车」就行。需要用车请用浮动叫车发单。'

		aiPrefNeedCar.value = suggestCar ? (needCar === 'no' ? 'no' : 'yes') : (needCar === 'no' ? 'no' : aiPrefNeedCar.value)
		storeAiPendingPlanFlat(dayFlatRows, rentalId, summary)
		return summary
	}

	const openAiChat = () => {
		showAiChat.value = true
		if (aiMessages.value.length === 0) {
			const days = selectedDayKeys.value.length
			const people = participantCount.value
			let hello = '嗨，我是研学行程小助手。'
			if (days > 0) {
				hello = hello + '你已选 ' + days.toString() + ' 天'
				if (people > 0) hello = hello + '、' + people.toString() + ' 人'
				hello = hello + '。'
			} else {
				hello = hello + '先在日历选好开放日（可多选），再来找我更方便。'
			}
			hello = hello + '\n点下面「打开分层点位」可选企业配好的人群方案；也可以直接跟我说「少两个点 / 换成商务」。租车请用页面上的「叫车」。'
			pushAiMessage('bot', hello, false)
		}
		setTimeout(() => {
			aiScrollInto.value = 'ai-msg-end'
		}, 80)
	}

	const closeAiChat = () => {
		showAiChat.value = false
	}

	const runAiReplyPipeline = (userText: string) => {
		if (aiThinking.value) return
		const raw = userText
		if (raw.length === 0) return
		pushAiMessage('user', raw, false)
		parsePrefsFromText(raw)
		aiThinking.value = true

		const keys = selectedDayKeys.value
		if (keys.length === 0) {
			aiThinking.value = false
			pushAiMessage('bot', '还没选开放日。先关掉窗口，在日历点选日期（可多选），再回来找我出方案。', false)
			return
		}

		// 组装点位目录
		const all = allSpots.value
		const spots: StudyAiPlanSpotInput[] = []
		for (let si = 0; si < all.length; si++) {
			const s = all[si]
			spots.push({
				id: s.id,
				title: s.title,
				zoneKey: s.zoneKey,
				zoneLabel: s.zoneLabel,
				durationMin: s.durationMin,
				desc: s.desc
			})
		}

		// 历史（不含刚 push 的可以包含；发给服务端时用近几条）
		const hist: StudyAiPlanHistoryItem[] = []
		const msgs = aiMessages.value
		// 跳过欢迎语后的对话，最多 10 条，且不含最后一条 user（会作为 message）
		const end = msgs.length > 0 ? msgs.length - 1 : 0
		const start = end > 10 ? end - 10 : 0
		for (let hi = start; hi < end; hi++) {
			const m = msgs[hi]
			if (m.isPlan) continue
			const role = m.role === 'user' ? 'user' : 'assistant'
			hist.push({ role: role, content: m.text })
		}

		const prefs: any = {
			zonePref: aiPrefZone.value,
			pace: aiPrefPace.value,
			needCar: aiPrefNeedCar.value,
			kids: aiPrefKids.value,
			team: aiPrefTeam.value,
			templateId: aiActiveTemplateId.value
		}

		const pid = projectId.value
		fetchStudyAiPlan(pid, raw, keys, participantCount.value, spots, hist, prefs).then((res: StudyAiPlanResult) => {
			aiThinking.value = false
			if (res.zonePref != null && res.zonePref.length > 0) aiPrefZone.value = res.zonePref
			if (res.pace != null && res.pace.length > 0) aiPrefPace.value = res.pace
			if (res.needCar != null && res.needCar.length > 0) aiPrefNeedCar.value = res.needCar

			const wantDrivers = raw.indexOf('司机') >= 0 || raw.indexOf('报价') >= 0 || raw.indexOf('电话') >= 0 || raw.indexOf('微信') >= 0 || raw.indexOf('租车') >= 0 || raw.indexOf('用车') >= 0 || raw.indexOf('叫车') >= 0 || raw.indexOf('大巴') >= 0 || raw.indexOf('中巴') >= 0

			if (res.isPlan && res.days != null && res.days.length > 0) {
				const flat: string[] = []
				const dayKeysOut: string[] = []
				const spotLists: any[] = []
				for (let di = 0; di < res.days.length; di++) {
					const d = res.days[di]
					dayKeysOut.push(d.dayKey)
					const ids = d.spotIds
					const idCopy: string[] = []
					let joined = ''
					for (let j = 0; j < ids.length; j++) {
						if (j > 0) joined = joined + ','
						joined = joined + ids[j]
						idCopy.push(ids[j])
					}
					flat.push(d.dayKey + '|||' + joined)
					spotLists.push(idCopy)
				}
				aiPendingDayKeys.value = dayKeysOut
				aiPendingSpotIdsByDay.value = flat
				const ridAdv = res.rentalId != null && res.rentalId.length > 0 ? res.rentalId : 'none'
				aiPendingRentalId.value = 'none'
				aiPendingRentalName.value = '不写入预约'
				aiPendingSummary.value = res.reply
				aiHasPendingPlan.value = true
				const msgId = pushAiMessage('bot', res.reply, true)
				const hintRid = (res.needCar === 'yes' || (ridAdv !== 'none' && ridAdv.length > 0)) ? 'need' : 'none'
				enrichPlanMessage(msgId, res.reply, dayKeysOut, spotLists, hintRid, false)
			} else {
				let replyText = res.reply
				if (wantDrivers || raw.indexOf('叫车') >= 0) {
					replyText = replyText + '\n\n用车请点页面浮动叫车发单，司机接单后议价；不在预约里选车型或司机。'
				}
				const msgId = pushAiMessage('bot', replyText, false)
				if (wantDrivers || res.needCar === 'yes' || raw.indexOf('叫车') >= 0) {
					updateAiMessageById(msgId, (m) => {
						m.rentalId = 'none'
						m.rentalName = '建议叫车'
						m.rentalHint = '用浮动叫车发单，司机接单议价'
						m.showRental = true
						m.needDrivers = true
						m.driverTip = '去发租车需求，不要写入预约选车'
						m.drivers = [] as AiDriverCard[]
					})
				}
			}
		}).catch((err) => {
			// 失败回退本地规则引擎
			const msg = err != null && err.message != null ? err.message.toString() : ''
			// 本地仍可规划
			if (!wantsImmediatePlan(raw) && aiMessages.value.length <= 3) {
				aiThinking.value = false
				let zoneHint = '综合'
				if (aiPrefZone.value === 'family') zoneHint = '家庭亲子'
				else if (aiPrefZone.value === 'college') zoneHint = '高校研学'
				else if (aiPrefZone.value === 'business') zoneHint = '企业商务'
				else if (aiPrefZone.value === 'mixed') zoneHint = '多日混搭'
				let paceHint = '适中'
				if (aiPrefPace.value === 'light') paceHint = '轻松'
				if (aiPrefPace.value === 'full') paceHint = '紧凑'
				let carHint = '按人数推荐'
				if (aiPrefNeedCar.value === 'no') carHint = '不租'
				if (aiPrefNeedCar.value === 'yes') carHint = '需要'
				const tip = msg.length > 0 ? '（云端助手暂不可用，先用本地规划）\n' : ''
				pushAiMessage('bot', tip + '收到。当前理解：偏好「' + zoneHint + '」，节奏「' + paceHint + '」，用车「' + carHint + '」。\n可以说得更细，或直接回「给我出方案」。', false)
				return
			}
			const planText = buildMultiDayPlanText()
			aiThinking.value = false
			const tip = msg.length > 0 ? '（云端助手暂不可用，已用本地规划）\n' : ''
			const msgId = pushAiMessage('bot', tip + planText, true)
			const flat = aiPendingSpotIdsByDay.value
			const dk2: string[] = []
			const sl2: any[] = []
			for (let fi = 0; fi < flat.length; fi++) {
				const row = flat[fi]
				const sep = row.indexOf('|||')
				if (sep < 0) continue
				const dkey = row.substring(0, sep)
				const idsPart = row.substring(sep + 3)
				const idarr: string[] = []
				if (idsPart.length > 0) {
					let rest = idsPart
					while (rest.length > 0) {
						const c = rest.indexOf(',')
						if (c < 0) {
							if (rest.length > 0) idarr.push(rest)
							break
						}
						const piece = rest.substring(0, c)
						if (piece.length > 0) idarr.push(piece)
						rest = rest.substring(c + 1)
					}
				}
				dk2.push(dkey)
				sl2.push(idarr)
			}
			enrichPlanMessage(msgId, tip + planText, dk2, sl2, aiPendingRentalId.value, true)
		})
	}

	const sendAiInput = () => {
		if (aiThinking.value) return
		const t = aiInputText.value
		if (t == null) return
		const trimmed = t.trim()
		if (trimmed.length === 0) return
		aiInputText.value = ''
		runAiReplyPipeline(trimmed)
	}

	const sendAiQuick = (text: string) => {
		if (aiThinking.value) return
		runAiReplyPipeline(text)
	}

	const requestAiReplan = () => {
		if (aiThinking.value) return
		aiPlanVariant.value = aiPlanVariant.value + 1
		runAiReplyPipeline('再帮我改一版方案，可以换点位搭配')
	}

	const applyAudienceTemplate = (tpl: AudienceSpotTemplate) => {
		const keys = selectedDayKeys.value
		if (keys.length === 0) {
			pendingAudienceTplId.value = tpl.id
			uni.showToast({ title: '已记住这套点位，选好日期后自动写入', icon: 'none' })
			return
		}
		const valid: string[] = []
		const src = tpl.spotIds
		for (let i = 0; i < src.length; i++) {
			if (findSpot(src[i]) != null) valid.push(src[i])
		}
		if (valid.length === 0) {
			uni.showToast({ title: '该模板还没有可用点位', icon: 'none' })
			return
		}
		aiActiveTemplateId.value = tpl.id
		if (tpl.audience === 'family' || tpl.audience === 'college' || tpl.audience === 'business') {
			aiPrefZone.value = tpl.audience
		}
		if (tpl.pace === 'light' || tpl.pace === 'balanced' || tpl.pace === 'full') aiPrefPace.value = tpl.pace
		const flat: string[] = []
		for (let i = 0; i < keys.length; i++) {
			setRouteIds(keys[i], valid)
			let joined = ''
			for (let j = 0; j < valid.length; j++) {
				if (j > 0) joined = joined + ','
				joined = joined + valid[j]
			}
			flat.push(keys[i] + '|||' + joined)
		}
		storeAiPendingPlanFlat(flat, 'none', '已选用「' + tpl.name + '」')
aiPlanHint.value = '已选用「' + tpl.name + '」'
		uni.showToast({ title: '已选用 ' + tpl.name, icon: 'success' })
	}

	const applyAiPendingPlan = () => {
		if (!aiHasPendingPlan.value) {
			uni.showToast({ title: '暂无待应用方案', icon: 'none' })
			return
		}
		if (aiPlanning.value) return
		aiPlanning.value = true
		const flat = aiPendingSpotIdsByDay.value
		for (let i = 0; i < flat.length; i++) {
			const row = flat[i]
			const sep = row.indexOf('|||')
			if (sep < 0) continue
			const dk = row.substring(0, sep)
			const idsPart = row.substring(sep + 3)
			const ids: string[] = []
			if (idsPart.length > 0) {
				let rest = idsPart
				while (rest.length > 0) {
					const c = rest.indexOf(',')
					if (c < 0) {
						if (rest.length > 0) ids.push(rest)
						break
					}
					const piece = rest.substring(0, c)
					if (piece.length > 0) ids.push(piece)
					rest = rest.substring(c + 1)
				}
			}
			setRouteIds(dk, ids)
		}
		aiPendingRentalId.value = 'none'
		const keys = aiPendingDayKeys.value
		if (keys.length > 0) {
			activeDayKey.value = keys[0]
		}
		const stopCount = totalSelectedStops.value
		aiPlanHint.value = 'AI 已规划 ' + keys.length.toString() + ' 天 · ' + stopCount.toString() + ' 个点位'
		aiPlanning.value = false
		pushAiMessage('bot', '已写入各天点位。要用车就点页面「叫车」发单，司机接单后再议价。想改某一天，继续跟我说就行。', false)
		uni.showToast({ title: '已写入点位', icon: 'success' })
		setTimeout(() => {
			showAiChat.value = false
		}, 700)
	}

	/** 旧入口：打开对话规划（覆盖全部已选日期） */
	const runAiPlanForActiveDay = () => {
		openAiChat()
	}









	const goAddTraveler = () => {
		uni.navigateTo({ url: '/pages/mine/add-traveler' })
	}

	const loadTravelers = () => {
		fetchTravelers<Traveler>().then((list) => {
			travelers.value = list
			const next: string[] = []
			for (let i = 0; i < selectedTravelerIds.value.length; i++) {
				const id = selectedTravelerIds.value[i]
				for (let j = 0; j < list.length; j++) {
					if (list[j].id === id) { next.push(id); break }
				}
			}
			if (next.length === 0) {
				for (let j = 0; j < list.length; j++) {
					if (list[j].isSelf) { next.push(list[j].id); break }
				}
			}
			selectedTravelerIds.value = next
		}).catch((_e) => { travelers.value = [] })
	}

	const daysInMonthOf = (year: number, month: number): number => {
		return new Date(year, month, 0).getDate()
	}

	const makeOpenSlot = (year: number, month: number, day: number, spots: SpotOption[]): DaySlot => {
		const dt = new Date(year, month - 1, day)
		const openMin = 9 * 60
		const closeMin = 16 * 60 + 30
		const daySpotIds: string[] = []
		for (let k = 0; k < spots.length; k++) daySpotIds.push(spots[k].id)
		const key = dayKeyOf(year, month, day)
		const capacity = dayCapacityOf(key)
		const paused = isDayPaused(key)
		return {
			key: key,
			year: year,
			month: month,
			day: day,
			weekday: dt.getDay(),
			openMin: openMin,
			closeMin: closeMin,
			openLabel: formatClock(openMin),
			closeLabel: formatClock(closeMin),
			spotIds: daySpotIds,
			enrolled: 0,
			capacity: capacity,
			full: paused,
			paused: paused
		}
	}

	const ensureMonthSlots = (year: number, month: number, spots: SpotOption[]) => {
		const last = daysInMonthOf(year, month)
		const existing = daySlots.value
		const seen: string[] = []
		for (let i = 0; i < existing.length; i++) seen.push(existing[i].key)
		const next: DaySlot[] = []
		for (let i = 0; i < existing.length; i++) next.push(existing[i])
		for (let d = 1; d <= last; d++) {
			const key = dayKeyOf(year, month, d)
			let has = false
			for (let s = 0; s < seen.length; s++) {
				if (seen[s] === key) {
					has = true
					break
				}
			}
			if (has) continue
			next.push(makeOpenSlot(year, month, d, spots))
		}
		daySlots.value = next
	}

	/** 从当月起生成可预约日：仅当天及未来 */
	const buildDaySlots = (spots: SpotOption[]) => {
		const tk = todayKey()
		const parts = tk.split("-")
		const year = parseInt(parts[0])
		const month = parseInt(parts[1])
		daySlots.value = []
		for (let i = 0; i < 12; i++) {
			let y = year
			let m = month + i
			while (m > 12) {
				m = m - 12
				y++
			}
			ensureMonthSlots(y, m, spots)
		}
		viewYear.value = year
		viewMonth.value = month
		calendarTick.value++
	}

	const loadProject = (id: string) => {
		fetchStudyProjectDetail(id).then((p) => {
			project.value = p
			if (allSpots.value.length > 0) buildDaySlots(allSpots.value)
			else buildDaySlots([] as SpotOption[])
			calendarTick.value++
			applyPendingAudienceIfReady()
		}).catch((err) => {
			const msg = err != null && err.message != null ? err.message.toString() : '项目加载失败'
			uni.showToast({ title: msg, icon: 'none' })
		})

		fetchStudyProjectRoutePoints(id).then((res) => {
			const catalogSpots = parseStudyRouteSpots(res)
			allSpots.value = catalogSpots
			zoneFilters.value = buildRouteZoneFilters(catalogSpots, parseRouteZoneFilters(res != null ? res['zones'] : null))
			buildDaySlots(catalogSpots)
			applyPendingAudienceIfReady()
		}).catch((_e) => {
			allSpots.value = [] as SpotOption[]
			buildDaySlots([] as SpotOption[])
		})
	}

	const collectAllRoutePointIds = (): string[] => {
		const seen: string[] = []
		const keys = selectedDayKeys.value
		for (let i = 0; i < keys.length; i++) {
			const ids = getRouteIds(keys[i])
			for (let j = 0; j < ids.length; j++) {
				let exists = false
				for (let k = 0; k < seen.length; k++) {
					if (seen[k] === ids[j]) { exists = true; break }
				}
				if (!exists) seen.push(ids[j])
			}
		}
		return seen
	}

	const submitBooking = () => {
		const p = project.value
		if (p == null || isSubmitting.value) return
		if (selectedTravelerIds.value.length === 0) {
			uni.showToast({ title: '请至少选择一位游客', icon: 'none' })
			return
		}
		if (selectedDayKeys.value.length === 0) {
			uni.showToast({ title: '请至少选择一个研学日期', icon: 'none' })
			return
		}
		if (participantCount.value > remainingSeats.value) {
			uni.showToast({ title: '所选人数超过剩余名额', icon: 'none' })
			return
		}

		isSubmitting.value = true
		// 预约强制不带租车；用车走浮动叫车 / rental-create
		const rentalId = 'none'
		const rentalFee = 0
		const driverId = ''
		const routeIds = collectAllRoutePointIds()
		const tripDays: any[] = []
		const dayKeys = selectedDayKeys.value
		for (let di = 0; di < dayKeys.length; di++) {
			const dk = dayKeys[di]
			const ids = getRouteIds(dk)
			tripDays.push({ dayKey: dk, spotIds: ids })
		}
		const tripPlan = { dayKeys: dayKeys, days: tripDays }
		const extra = {
			tripPlan: tripPlan,
			pickupAddress: '',
			pickupLatitude: null,
			pickupLongitude: null,
			rentalDriverName: '',
			rentalDriverPhone: '',
			rentalDriverWechat: '',
			rentalVehicleName: '',
			rentalPlateNo: ''
		} as any
		createStudyBooking(p.id, selectedTravelerIds.value, rentalId, rentalFee, routeIds, driverId, extra).then((booking) => {
			isSubmitting.value = false
			if (isStudyBookingUnpaidStatus(booking.status)) {
				confirmPayBooking(booking)
			} else if (isStudyBookingPendingStatus(booking.status)) {
				syncStudyBookingsFromApi().then((_ids) => {}).catch((_e) => {})
				uni.showToast({ title: '订单已创建', icon: 'success' })
				setTimeout(() => {
					uni.redirectTo({ url: '/pages/appointment/booking-detail?id=' + booking.id })
				}, 400)
			} else {
				addProjectBooking(p.id)
				syncStudyBookingsFromApi().then((_ids) => {}).catch((_e) => {})
				uni.showToast({ title: '预约成功', icon: 'success' })
				// 进订单详情（用 booking.id；详情接口同时支持 groupId），避免返回项目页误显「结算」
				setTimeout(() => {
					uni.redirectTo({ url: '/pages/appointment/booking-detail?id=' + booking.id })
				}, 400)
			}
		}).catch((err) => {
			isSubmitting.value = false
			const msg = err != null && err.message != null ? err.message.toString() : '预约失败，请稍后重试'
			uni.showToast({ title: msg, icon: 'none' })
		})
	}

	const confirmPayBooking = (booking: StudyBookingRecord) => {
		if (!booking.isBooker) {
			uni.showToast({ title: '请联系预约发起人完成支付', icon: 'none' })
			return
		}
		uni.showModal({
			title: '确认支付',
			content: '当前为模拟支付。行程 ' + selectedDayKeys.value.length.toString() + ' 天，应付 ¥' + bookingTotalAmount.value,
			confirmText: '确认支付',
			cancelText: '稍后支付',
			success: (res) => {
				if (!res.confirm) {
					uni.showToast({ title: '可在我的订单-待支付继续', icon: 'none' })
					setTimeout(() => {
						uni.redirectTo({ url: '/pages/mine/my-orders?status=unpaid' })
					}, 400)
					return
				}
				payStudyBooking(booking.id).then((paid) => {
					addProjectBooking(paid.projectId)
					syncStudyBookingsFromApi().then((_ids) => {}).catch((_e) => {})
					uni.showToast({ title: '支付成功', icon: 'success' })
					setTimeout(() => { uni.navigateBack() }, 500)
				}).catch((err) => {
					const msg = err != null && err.message != null ? err.message.toString() : '支付失败'
					uni.showToast({ title: msg, icon: 'none' })
				})
			}
		})
	}

	onLoad((options: OnLoadOptions) => {
		const idParam = options['id']
		const id = idParam != null ? idParam.toString() : ''
		if (id.length === 0) {
			uni.showToast({ title: '缺少项目ID', icon: 'none' })
			return
		}
		projectId.value = id
		const tplParam = options['tpl']
		if (tplParam != null && tplParam.toString().length > 0) pendingAudienceTplId.value = tplParam.toString()
		// 开放档期在 9 月，日历默认落在 9 月
		viewYear.value = 2026
		viewMonth.value = 9
		loadProject(id)
		loadTravelers()
	})

	onShow(() => {
		if (projectId.value.length > 0) loadTravelers()
		// 从路径列表页回写选中站点
		try {
			const raw = uni.getStorageSync('mqlt_booking_route_pick')
			if (raw != null) {
				const s = raw.toString()
				if (s.length > 0) {
					uni.removeStorageSync('mqlt_booking_route_pick')
					const sep = s.indexOf('|||')
					if (sep > 0) {
						const dk = s.substring(0, sep)
						const idsPart = s.substring(sep + 3)
						const ids: string[] = []
						if (idsPart.length > 0) {
							let rest = idsPart
							while (rest.length > 0) {
								const c = rest.indexOf(',')
								if (c < 0) {
									if (rest.length > 0) ids.push(rest)
									break
								}
								const piece = rest.substring(0, c)
								if (piece.length > 0) ids.push(piece)
								rest = rest.substring(c + 1)
							}
						}
						setRouteIds(dk, ids)
						activeDayKey.value = dk
						aiPlanHint.value = '已从路径列表更新本日站点'
						uni.showToast({ title: '路线已更新', icon: 'success' })
					}
				}
			}
		} catch (_e) {}
		try {
			const rawTpl = uni.getStorageSync('mqlt_booking_audience_tpl')
			if (rawTpl != null) {
				const s = rawTpl.toString()
				if (s.length > 0) {
					uni.removeStorageSync('mqlt_booking_audience_tpl')
					pendingAudienceTplId.value = s
				}
			}
		} catch (_e2) {}
		applyPendingAudienceIfReady()
	})
</script>

<style>
	.page-wrapper { border-width: 0; border-color: #FFFFFF; flex: 1; background-color: #F5F7FB; }
	.header-section {
		background-color: #FFFFFF;
		border-width: 0;
		border-bottom-width: 1px;
		border-bottom-style: solid;
		border-bottom-color: #E5E7EB;
	}
	.status-bar { border-width: 0; border-color: #FFFFFF; width: 100%; background-color: #FFFFFF; }
	.nav-bar {
		background-color: #FFFFFF;
		border-width: 0;
		border-color: #FFFFFF;
		height: 44px;
		flex-direction: row;
		align-items: center;
		padding: 0 16px;
		position: relative;
	}
	.nav-back { flex-direction: row; align-items: center; z-index: 1; }
	.nav-back-icon { width: 18px; height: 18px; margin-right: 4px; }
	.nav-back-text { font-size: 16px; color: #1A1A1A; font-weight: 500; }
	.nav-title {
		position: absolute; left: 0; right: 0; text-align: center;
		font-size: 17px; font-weight: 700; color: #1A1A1A;
	}
	.project-banner { padding: 2px 16px 14px 16px; }
	.project-kicker {
		font-size: 10px; font-weight: 800; color: #1A73E8;
		letter-spacing: 1.4px; margin-bottom: 6px;
	}
	.project-title { font-size: 18px; font-weight: 800; color: #1A1A1A; margin-bottom: 4px; }
	.project-sub { font-size: 12px; color: #374151; }

	.main-scroll { flex: 1; height: 0; min-height: 0; width: 100%; background-color: #F5F7FB; }
	.scroll-inner { padding: 14px 16px 8px 16px; }

	.section-card {
		background-color: #FFFFFF;
		border-radius: 16px;
		padding: 16px;
		margin-bottom: 12px;
		overflow: hidden;
		position: relative;
	}
	.section-gold-edge {
		position: absolute;
		left: 0; right: 0; top: 0;
		height: 3px;
		background-color: #1A73E8;
	}
	.section-head { margin-bottom: 14px; padding-top: 2px; }
	.section-head-row { align-items: center; margin-bottom: 6px; }
	.section-kicker {
		flex: 1;
		font-size: 10px; font-weight: 800; color: #1A73E8;
		letter-spacing: 1.2px;
	}
	.section-title { font-size: 17px; font-weight: 800; color: #1A1A1A; margin-bottom: 4px; }
	.section-desc { font-size: 12px; color: #374151; line-height: 18px; }
	.section-link {
		padding: 4px 12px; border-radius: 12px; background-color: #1A73E8;
		flex-shrink: 0;
	}
	.section-link-text { font-size: 12px; font-weight: 800; color: #FFFFFF; }

	.traveler-row {
		flex-direction: row; align-items: center; padding: 12px; border-radius: 12px;
		background-color: #F5F7FB; border-width: 1px; border-style: solid;
		border-color: #E5E7EB; margin-bottom: 8px;
	}
	.traveler-row-on { background-color: #FFFFFF; border-color: #1A73E8; }
	.check-dot {
		width: 22px; height: 22px; border-radius: 11px; border-width: 1px; border-style: solid;
		border-color: #E5E7EB; align-items: center; justify-content: center;
		margin-right: 10px; background-color: #FFFFFF; flex-shrink: 0;
	}
	.check-dot-on { background-color: #1A73E8; border-color: #1A73E8; }
	.check-dot-icon { width: 12px; height: 12px; }
	.traveler-info { flex: 1; min-width: 0; }
	.traveler-name-row { align-items: center; margin-bottom: 2px; }
	.traveler-name { font-size: 15px; font-weight: 700; color: #1A1A1A; margin-right: 8px; }
	.self-tag { padding: 1px 6px; border-radius: 5px; background-color: #1A73E8; }
	.self-tag-text { font-size: 10px; color: #FFFFFF; font-weight: 800; }
	.traveler-phone { font-size: 12px; color: #374151; }

	.empty-block { align-items: center; padding: 20px 8px; }
	.empty-title { font-size: 14px; font-weight: 700; color: #1A1A1A; margin-bottom: 4px; }
	.empty-desc { font-size: 12px; color: #9CA3AF; text-align: center; margin-bottom: 12px; }
	.empty-btn { padding: 8px 16px; border-radius: 16px; background-color: #1A73E8; }
	.empty-btn-text { font-size: 13px; font-weight: 700; color: #FFFFFF; }

	/* 日历 */
	.cal-nav {
		align-items: center; justify-content: space-between; margin-bottom: 10px;
	}
	.page-wrapper .cal-nav-btn {
		width: 36px; height: 36px; border-radius: 18px; background-color: #E8EEF8;
		align-items: center; justify-content: center;
		border-width: 1px;
		border-style: solid;
		border-color: #C5D0E0;
}
	.cal-nav-btn-text { font-size: 22px; color: #1A1A1A; font-weight: 600; line-height: 24px; }
	.cal-month-title { font-size: 16px; font-weight: 800; color: #1A1A1A; }
	.cal-week-row { flex-direction: row; margin-bottom: 4px; }
	.cal-week-cell {
		width: 14.28%; text-align: center; font-size: 11px; color: #9CA3AF; font-weight: 600;
		padding: 4px 0;
	}
	.cal-grid {
		flex-direction: row; flex-wrap: wrap;
	}
	.cal-cell {
		width: 14.2%;
		height: 62px;
		padding: 3px 0 2px 0;
		align-items: center;
		justify-content: flex-start;
		border-radius: 8px;
		margin-bottom: 4px;
		overflow: hidden;
	}
	.cal-cell-muted { opacity: 0.28; }
	.cal-cell-closed { opacity: 0.45; }
	.cal-cell-full { opacity: 0.55; }
	.cal-cell-today {
		background-color: #FFFFFF;
	}
	.cal-cell-on {
		background-color: #1A73E8;
		opacity: 1;
	}
	.cal-day-num {
		font-size: 14px; font-weight: 700; color: #1A1A1A; margin-bottom: 1px;
	}
	.cal-day-num-on { color: #FFFFFF; }
	.cal-day-hours {
		font-size: 9px;
		color: #4B5563;
		text-align: center;
		lines: 1;
		line-height: 12px;
		width: 100%;
		overflow: hidden;
		text-overflow: ellipsis;
	}
	.cal-day-hours-off { color: #9CA3AF; }
	.cal-day-hours-full { color: #DC2626; font-weight: 700; }
	.cal-day-enroll {
		font-size: 9px;
		color: #6B7280;
		font-weight: 700;
		text-align: center;
		margin-top: 1px;
		lines: 1;
		width: 100%;
		overflow: hidden;
		text-overflow: ellipsis;
	}
	.cal-cell-on .cal-day-hours { color: #FFFFFF; }
	.cal-cell-on .cal-day-enroll { color: #FFFFFF; }
	.cal-cell-on .cal-day-hours-full { color: #FECACA; }
	.cal-hint {
		font-size: 12px; color: #9CA3AF; margin-top: 8px; line-height: 17px;
	}

	.selected-days-bar {
		align-items: center; margin-top: 12px; margin-bottom: 4px;
	}
	.selected-days-label {
		font-size: 12px; font-weight: 700; color: #1A1A1A; margin-right: 8px; flex-shrink: 0;
	}
	.selected-days-scroll { flex: 1; height: 34px; }
	.selected-days-inner { flex-direction: row; align-items: center; height: 34px; }
	.day-pill {
		padding: 6px 12px; border-radius: 14px; background-color: #E8EEF8;
		border-width: 1px; border-style: solid; border-color: #C5D0E0;
		margin-right: 6px; flex-shrink: 0;
	}
	.day-pill-on { background-color: #1A73E8; }
	.day-pill-text { font-size: 12px; font-weight: 700; color: #374151; }
	.day-pill-text-on { color: #FFFFFF; }

	.day-route-block {
		margin-top: 14px; padding-top: 14px;
		border-top-width: 0.5px; border-top-color: #E5E7EB;
	}
	.day-route-head { margin-bottom: 10px; }
	.day-route-title { font-size: 15px; font-weight: 800; color: #1A1A1A; margin-bottom: 2px; }
	.day-route-hours { font-size: 12px; color: #1A73E8; font-weight: 600; }

.day-route-title-row {
	align-items: center;
	margin-bottom: 2px;
}
.day-route-title-row .day-route-title {
	flex: 1;
	min-width: 0;
	margin-bottom: 0;
}
.card-more-link {
	margin-left: auto;
