	const onDetailSheetTouchMove = () => {}

	const sectionHasBody = (html: string): boolean => {
		return routeSectionHasBody(html)
	}
	const sectionIsHtml = (html: string): boolean => {
		return isHtmlContent(html)
	}
	const detailSpotSelected = computed((): boolean => {
		const spot = detailSpot.value
		if (spot == null) return false
		return isSpotSelectedOnActiveDay(spot.id)
	})

	const toggleDetailSpotSelect = () => {
