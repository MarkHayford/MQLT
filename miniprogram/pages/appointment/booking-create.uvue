		width: 100%;
		flex: 1;
		min-height: 240px;
	}
	.spot-detail-inner {
		padding: 0 16px 8px 16px;
		flex-direction: column;
	}
	.spot-detail-scroll-pad { height: 24px; }
	.spot-photo-card {
		height: 160px; border-radius: 16px; align-items: center; justify-content: center;
		margin-bottom: 16px; overflow: hidden;
	}
	.spot-photo-caption { font-size: 13px; font-weight: 700; color: #FFFFFF; }
	.spot-detail-section { margin-bottom: 16px; }
	.spot-detail-sec-title {
		font-size: 14px; font-weight: 800; color: #1A1A1A; margin-bottom: 8px;
	}
	.spot-detail-sec-body { font-size: 13px; color: #374151; line-height: 20px; }
	.spot-detail-rich { font-size: 13px; color: #374151; line-height: 22px; }
	.spot-bullet-row { align-items: flex-start; margin-bottom: 6px; }
	.spot-bullet-dot {
		width: 6px; height: 6px; border-radius: 3px; background-color: #1A73E8;
		margin-top: 7px; margin-right: 8px; flex-shrink: 0;
	}
	.spot-bullet-dot-blue { background-color: #1A73E8; }
