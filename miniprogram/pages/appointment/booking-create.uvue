	color: #1A73E8;
	font-weight: 500;
	flex-shrink: 0;
	padding-left: 10px;
}


	.zone-row {
		flex-direction: row;
		flex-wrap: wrap;
		margin-bottom: 10px;
	}
	.zone-chip {
		padding: 7px 12px;
		border-radius: 16px;
