.ai-driver-price-col { align-items: flex-end; flex-shrink: 0; margin-left: 6px; }
.ai-driver-price { font-size: 16px; font-weight: 800; color: #1A1A1A; }
.ai-driver-price-hint { font-size: 10px; color: #9CA3AF; margin-top: 2px; }
.ai-driver-contact {
	margin-top: 10px;
	align-items: center;
