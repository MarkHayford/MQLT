	const onRouteMarkerTap = (e: any) => {
		const detail = e != null ? e.detail : null
		if (detail == null) return
		const mid = Number(detail.markerId)
		const list = spotsForActiveDay.value
		if (mid < 1 || mid > list.length) return
		toggleSpotOnActiveDay(list[mid - 1].id)
	}

	const onRouteCalloutTap = (e: any) => {
		onRouteMarkerTap(e)
	}

	const closeSpotDetail = () => {
		showSpotDetail.value = false
	}

