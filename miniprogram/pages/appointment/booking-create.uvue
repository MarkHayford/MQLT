.ai-spot-title {
	font-size: 13px;
	font-weight: 800;
	color: #1A1A1A;
	padding: 8px 10px 2px 10px;
	lines: 1;
	overflow: hidden;
	text-overflow: ellipsis;
}
.ai-spot-meta {
	font-size: 11px;
	color: #9CA3AF;
	padding: 0 10px;
	font-weight: 600;
}
.ai-spot-desc {
	font-size: 11px;
	color: #374151;
	padding: 4px 10px 0 10px;
	lines: 2;
