}


	.spot-row {
		flex-direction: row; align-items: flex-start; padding: 12px; border-radius: 12px;
		background-color: #F5F7FB; border-width: 1px; border-style: solid;
		border-color: #E5E7EB; margin-bottom: 8px;
	}
	.spot-row-on { background-color: #E8F0FE; border-color: rgba(26, 115, 232, 0.28); }
	.spot-body { flex: 1; min-width: 0; }
	.spot-title-row { align-items: center; margin-bottom: 2px; }
	.spot-title { font-size: 14px; font-weight: 700; color: #1A1A1A; flex: 1; min-width: 0; }

	.spot-duration {
		font-size: 11px;
		color: #9CA3AF;
		margin-top: 4px;
		font-weight: 600;
	}
	.spot-detail-btn {
		padding: 8px 12px;
		border-radius: 14px;
		background-color: #FFFFFF;
		flex-shrink: 0;
		margin-left: 8px;
		align-self: center;
	}
	.spot-detail-btn-text {
		font-size: 12px;
		font-weight: 800;
		color: #1A1A1A;
	}


	.spot-detail-mask {
		position: fixed;
		left: 0; right: 0; top: 0; bottom: 0;
		background-color: rgba(0, 0, 0, 0.45);
		z-index: 920;
	}
	.spot-detail-sheet {
		position: fixed;
		left: 0; right: 0; bottom: 0;
		height: 78%;
		max-height: 78%;
		background-color: #FFFFFF;
		border-top-left-radius: 20px;
		border-top-right-radius: 20px;
		z-index: 921;
		padding-bottom: 0;
		overflow: hidden;
	}
	.spot-detail-handle {
		width: 36px; height: 4px; border-radius: 2px;
		background-color: #E5E7EB; align-self: center;
		margin-top: 10px; margin-bottom: 8px;
		flex-shrink: 0;
	}
	.spot-detail-top {
		align-items: flex-start;
		padding: 4px 16px 12px 16px;
		flex-shrink: 0;
	}
	.spot-detail-titles { flex: 1; min-width: 0; }
