		justify-content: center;
		flex-shrink: 0;
	}
	.ai-chat-aud-top-txt { font-size: 12px; font-weight: 800; color: #1A73E8; }
	.ai-entry {
		align-items: center;
		padding: 12px;
		border-radius: 14px;
		background-color: #1A73E8;
		margin-bottom: 10px;
	}
	.ai-entry-dot {
		width: 36px; height: 36px; border-radius: 18px;
		background-color: #1A73E8;
		align-items: center; justify-content: center;
		margin-right: 10px; flex-shrink: 0;
		overflow: hidden;
	}
	.ai-entry-icon { width: 26px; height: 26px; }
	.ai-entry-copy { flex: 1; min-width: 0; }
	.ai-entry-title { font-size: 15px; font-weight: 800; color: #FFFFFF; margin-bottom: 2px; }
	.ai-entry-sub { font-size: 11px; color: #FFFFFF; }
	.ai-entry-go { font-size: 12px; font-weight: 800; color: #FFFFFF; flex-shrink: 0; }
	.ai-row { align-items: center; margin-bottom: 10px; flex-wrap: wrap; }
	.ai-btn {
		height: 34px; padding: 0 14px; border-radius: 17px; background-color: #1A73E8;
		align-items: center; justify-content: center; margin-right: 8px; margin-bottom: 6px;
	}
	.ai-btn-text{ font-size: 13px; font-weight: 700; color: #FFFFFF; }
	.page-wrapper .ai-btn-ghost { background-color: #E8EEF8;
		border-width: 1px;
		border-style: solid;
		border-color: #C5D0E0;
}
	.ai-btn-ghost-text { font-size: 13px; font-weight: 700; color: #1A1A1A; }
	.ai-hint { font-size: 12px; color: #1A1A1A; margin-bottom: 10px; line-height: 17px; }

.ai-chat-mask {
	position: fixed;
	left: 0; right: 0; top: 0; bottom: 0;
	background-color: rgba(32, 33, 36, 0.42);
	z-index: 940;
}
.ai-chat-sheet {
	position: fixed;
	left: 0; right: 0; bottom: 0;
	height: 82%;
	max-height: 82%;
	background-color: #FFFFFF;
	border-top-left-radius: 20px;
	border-top-right-radius: 20px;
	z-index: 941;
	overflow: hidden;
}
.ai-chat-handle {
	width: 36px; height: 4px; border-radius: 2px;
	background-color: #1A73E8; align-self: center;
	margin-top: 10px; margin-bottom: 6px;
	flex-shrink: 0;
}
.ai-chat-top {
	align-items: center;
	padding: 6px 16px 12px 16px;
	background-color: #1A73E8;
	flex-shrink: 0;
}
.ai-chat-avatar {
	width: 40px; height: 40px; border-radius: 20px;
	background-color: #1A73E8;
	align-items: center; justify-content: center;
	flex-shrink: 0; margin-right: 10px;
}
.ai-chat-avatar-icon { width: 28px; height: 28px; }
.ai-chat-titles { flex: 1; min-width: 0; }
.ai-chat-kicker {
	font-size: 9px; font-weight: 800; color: #FFFFFF;
	letter-spacing: 1.2px; margin-bottom: 2px;
}
.ai-chat-title {
	font-size: 16px; font-weight: 800; color: #FFFFFF;
}
.ai-chat-close {
	padding: 6px 12px; border-radius: 14px; background-color: #FFFFFF;
	border-width: 0;
	flex-shrink: 0; margin-left: 8px;
}
.ai-chat-close-text { font-size: 12px; font-weight: 700; color: #1A1A1A; }
.ai-chat-scroll {
	width: 100%;
	flex: 1;
	height: 0;
	min-height: 0;
	background-color: #F5F7FB;
}
.ai-chat-inner {
	padding: 14px 14px 8px 14px;
	flex-direction: column;
}
.ai-chat-end-anchor { height: 8px; width: 100%; }
.ai-msg-row {
	margin-bottom: 12px;
	align-items: flex-end;
}
.ai-msg-row-bot {
	flex-direction: row;
	align-items: flex-start;
}
.ai-msg-row-user {
	flex-direction: row;
	justify-content: flex-end;
}
.ai-msg-bot-dot {
	width: 28px; height: 28px; border-radius: 14px;
	background-color: #1A73E8;
	align-items: center; justify-content: center;
	margin-right: 8px; flex-shrink: 0; margin-top: 2px;
}
.ai-msg-bot-icon { width: 18px; height: 18px; }
.ai-bubble {
	max-width: 78%;
	padding: 10px 12px;
	border-radius: 14px;
}
.ai-bubble-bot {
	background-color: #FFFFFF;
	border-width: 1px;
	border-style: solid;
	border-color: #E5E7EB;
	border-top-left-radius: 4px;
}
.ai-bubble-user {
	background-color: #1A73E8;
	border-top-right-radius: 4px;
}
.ai-bubble-plan {
	max-width: 88%;
	background-color: #FFFFFF;
	border-color: #E5E7EB;
}
.ai-bubble-text {
	font-size: 13px;
	color: #1A1A1A;
	line-height: 20px;
}
.ai-bubble-text-user {
	color: #FFFFFF;
}

.ai-block-label {
	font-size: 12px;
	font-weight: 800;
	color: #1A1A1A;
	margin-top: 12px;
	margin-bottom: 8px;
}
.ai-day-list { margin-top: 4px; }
.ai-day-card {
	padding: 10px 12px;
	border-radius: 12px;
	background-color: #F5F7FB;
	border-width: 1px;
	border-style: solid;
	border-color: #E5E7EB;
	margin-bottom: 8px;
}
.ai-day-head { align-items: center; margin-bottom: 4px; }
.ai-day-label { flex: 1; font-size: 13px; font-weight: 800; color: #1A1A1A; }
.ai-day-stops { font-size: 11px; font-weight: 700; color: #374151; }
.ai-day-route { font-size: 12px; color: #374151; line-height: 18px; }
.ai-day-ops { margin-top: 8px; align-items: center; }
.ai-mini-link {
	font-size: 12px;
	font-weight: 700;
	color: #1A73E8;
	margin-right: 14px;
}
.ai-spot-block { margin-top: 4px; }
.ai-spot-scroll { width: 100%; height: 210px; }
.ai-spot-scroll-inner {
	flex-direction: row;
	flex-wrap: nowrap;
	align-items: stretch;
	padding: 2px 0 6px 0;
	height: 204px;
}
.ai-spot-card {
	width: 148px;
	height: 196px;
	margin-right: 10px;
	border-radius: 14px;
	background-color: #FFFFFF;
	border-width: 1px;
	border-style: solid;
	border-color: #E5E7EB;
