	}
	.ai-aud-btn-txt { font-size: 14px; font-weight: 800; color: #FFFFFF; }
	.ai-aud-hint { font-size: 11px; color: #6B7280; margin-top: 6px; width: 220px; }
	.ai-chat-aud-top {
		padding: 0 10px;
		height: 28px;
		margin-right: 8px;
		border-radius: 8px;
		background-color: #E8EEF8;
