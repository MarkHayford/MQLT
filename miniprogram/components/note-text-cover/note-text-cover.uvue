		top: 0;
		bottom: 0;
		padding: 14px 16px 16px 16px;
		flex-direction: column;
		z-index: 2;
	}
	.sheet-sm {
		padding: 8px 8px 8px 8px;
		border-radius: 10px;
	}
	.sheet-lg {
		padding: 16px 18px 16px 18px;
		border-radius: 16px;
	}
	.sheet-card-sm {
		left: 7px;
		right: 10px;
		top: 6px;
		bottom: 11px;
	}
	.sheet-card-lg {
		left: 12px;
		right: 18px;
		top: 10px;
		bottom: 20px;
	}

	.chrome {
		width: 100%;
		align-items: center;
		flex-shrink: 0;
		z-index: 3;
	}
	.dots {
		align-items: center;
		height: 12px;
	}
	.dot {
		width: 3px;
		height: 3px;
		border-radius: 2px;
		background-color: #D2D2D2;
		margin-right: 3px;
	}

	.qmark {
		font-size: 52px;
		font-weight: 700;
		line-height: 48px;
		margin-top: 4px;
		margin-bottom: -6px;
		z-index: 3;
	}
	.qmark-sm {
		font-size: 28px;
		line-height: 26px;
		margin-top: 0;
		margin-bottom: -4px;
	}
	.qmark-lg {
		font-size: 64px;
		line-height: 58px;
	}

	.ruled {
		position: absolute;
		left: 12px;
		right: 12px;
		top: 36px;
		bottom: 18px;
		z-index: 0;
	}
	.ruled-line {
		height: 0;
		border-bottom-width: 1px;
		border-bottom-color: rgba(180, 160, 120, 0.28);
		margin-top: 22px;
	}
	.wax {
		position: absolute;
		top: 10px;
		right: 10px;
		width: 26px;
		height: 26px;
		border-radius: 13px;
		border-width: 1px;
		border-color: rgba(196, 92, 38, 0.45);
		align-items: center;
		justify-content: center;
		z-index: 3;
	}
	.wax-txt {
		font-size: 11px;
		font-weight: 800;
		color: #1A73E8;
	}

	.ttl-box {
		flex: 1;
		width: 100%;
		flex-direction: column;
		align-items: flex-start;
		justify-content: flex-start;
		padding-top: 10px;
		z-index: 3;
	}
	.ttl-box-mid {
		justify-content: center;
		padding-top: 0;
	}
	.hl {
		padding: 0 5px 2px 5px;
		border-radius: 3px;
		margin-bottom: 6px;
		max-width: 100%;
	}
	.hl-sm {
		padding: 0 3px 1px 3px;
		margin-bottom: 3px;
	}
	.ttl {
		font-size: 18px;
		font-weight: 800;
		line-height: 26px;
	}
	.ttl-mark {
		lines: 4;
	}
	.ttl-pre {
		width: 100%;
		lines: 2;
		overflow: hidden;
		text-overflow: ellipsis;
		margin-bottom: 4px;
	}
