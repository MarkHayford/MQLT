<template>
	<view :class="rootClass">
		<view v-if="isStack" :class="paperBackClass"></view>
		<view v-if="isStack" :class="paperMidClass"></view>
		<view :class="sheetClass">
			<view v-if="isStack" class="chrome uni-row">
				<view class="dots uni-row">
					<view class="dot"></view>
					<view class="dot"></view>
					<view class="dot"></view>
				</view>
			</view>
			<text v-if="isQuote" :class="quoteClass">“</text>
			<view v-if="tplId === 'lined'" class="ruled uni-column">
				<view class="ruled-line"></view>
				<view class="ruled-line"></view>
				<view class="ruled-line"></view>
				<view class="ruled-line"></view>
				<view class="ruled-line"></view>
				<view class="ruled-line"></view>
			</view>
			<view v-if="tplId === 'letter'" class="wax">
				<text class="wax-txt">研</text>
			</view>
			<view :class="ttlBoxClass">
				<text v-if="titlePrefix.length > 0" :class="preClass">{{ titlePrefix }}</text>
				<view v-if="titleHead.length > 0" :class="hlClass">
					<text :class="titleClass">{{ titleHead }}</text>
				</view>
				<text v-if="titleRest.length > 0" :class="restClass">{{ titleRest }}</text>
			</view>
			<view :class="footClass">
				<view :class="ruleClass"></view>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { computed } from 'vue'

	type CoverTitleParts = {
		prefix: string
		head: string
		rest: string
	}

	const props = defineProps({
		tpl: {
			type: String,
			default: 'sticky'
		},
		title: {
			type: String,
			default: ''
		},
		hl: {
			type: String,
			default: ''
		},
		autoHl: {
			type: Boolean,
			default: true
		},
		kicker: {
			type: String,
			default: ''
		},
		size: {
			type: String,
			default: 'feed'
		}
	})

	const tplId = computed((): string => {
		const id = props.tpl.trim()
		if (id === 'kraft') return 'dusk'
		if (id === 'sticky' || id === 'quote' || id === 'mint' || id === 'peach' || id === 'sky' || id === 'lined' || id === 'letter' || id === 'dusk' || id === 'forest') return id
		return 'sticky'
	})

	const isStack = computed((): boolean => {
		const id = tplId.value
		return id === 'sticky' || id === 'mint' || id === 'peach' || id === 'sky' || id === 'dusk'
	})

	const isQuote = computed((): boolean => {
		const id = tplId.value
		return id === 'quote' || id === 'forest'
	})

	const titleText = computed((): string => {
		const t = props.title.trim()
		if (t.length > 0) return t
		return '拟一个让人想点开的标题'
	})

	const splitCoverTitle = (title: string, hl: string): CoverTitleParts => {
		const parts: CoverTitleParts = {
			prefix: '',
			head: title,
			rest: ''
		}
		if (title.length === 0) return parts
		const mark = hl.trim()
		if (mark.length === 0) {
			if (props.autoHl == false) {
				parts.prefix = title
				parts.head = ''
				parts.rest = ''
				return parts
			}
			if (title.length <= 4) return parts
			parts.head = title.substring(0, 4)
			parts.rest = title.substring(4)
			return parts
		}
		const idx = title.indexOf(mark)
		if (idx >= 0) {
			parts.prefix = title.substring(0, idx)
			parts.head = mark
			parts.rest = title.substring(idx + mark.length)
			return parts
		}
		const n = mark.length < title.length ? mark.length : title.length
		parts.head = title.substring(0, n)
		parts.rest = title.substring(n)
		return parts
	}

	const titlePrefix = computed((): string => {
		return splitCoverTitle(titleText.value, props.hl).prefix
	})

	const titleHead = computed((): string => {
		return splitCoverTitle(titleText.value, props.hl).head
	})

	const titleRest = computed((): string => {
		return splitCoverTitle(titleText.value, props.hl).rest
	})

	const sz = computed((): string => {
		if (props.size === 'pick') return 'sm'
		if (props.size === 'hero') return 'lg'
		return 'md'
	})

	const rootClass = computed((): string => {
		let cls = 'tpl-cover tpl-' + tplId.value
		if (sz.value === 'sm') cls = cls + ' tpl-cover-sm'
		else if (sz.value === 'lg') cls = cls + ' tpl-cover-lg'
		return cls
	})

	const sheetClass = computed((): string => {
		let cls = isQuote.value ? 'sheet-flat' : 'sheet-card'
		if (sz.value === 'sm') cls = cls + (isQuote.value ? ' sheet-sm' : ' sheet-sm sheet-card-sm')
		else if (sz.value === 'lg') cls = cls + (isQuote.value ? ' sheet-lg' : ' sheet-lg sheet-card-lg')
		return cls
	})

	const paperBackClass = computed((): string => {
		let cls = 'paper-b'
		if (sz.value === 'sm') cls = cls + ' paper-b-sm'
		else if (sz.value === 'lg') cls = cls + ' paper-b-lg'
		return cls
	})

	const paperMidClass = computed((): string => {
		let cls = 'paper-m'
		if (sz.value === 'sm') cls = cls + ' paper-m-sm'
		else if (sz.value === 'lg') cls = cls + ' paper-m-lg'
		return cls
	})

	const quoteClass = computed((): string => {
		let cls = 'qmark qmark-' + tplId.value
		if (sz.value === 'sm') cls = cls + ' qmark-sm'
		else if (sz.value === 'lg') cls = cls + ' qmark-lg'
		return cls
	})

	const ttlBoxClass = computed((): string => {
		return isQuote.value ? 'ttl-box ttl-box-mid' : 'ttl-box'
	})

	const hlClass = computed((): string => {
		let cls = 'hl hl-' + tplId.value
		if (sz.value === 'sm') cls = cls + ' hl-sm'
		return cls
	})

	const titleClass = computed((): string => {
		let cls = 'ttl ttl-mark ttl-head-' + tplId.value
		if (sz.value === 'sm') cls = cls + ' ttl-sm'
		else if (sz.value === 'lg') cls = cls + ' ttl-lg'
		return cls
	})

	const preClass = computed((): string => {
		let cls = 'ttl ttl-pre ttl-' + tplId.value
		if (sz.value === 'sm') cls = cls + ' ttl-sm'
		else if (sz.value === 'lg') cls = cls + ' ttl-lg'
		return cls
	})

	const restClass = computed((): string => {
		let cls = 'ttl ttl-rest ttl-' + tplId.value
		if (sz.value === 'sm') cls = cls + ' ttl-sm'
		else if (sz.value === 'lg') cls = cls + ' ttl-lg'
		return cls
	})

	const footClass = computed((): string => {
		return isQuote.value ? 'foot foot-end uni-row' : 'foot uni-row'
	})

	const ruleClass = computed((): string => {
		let cls = 'rule rule-' + tplId.value
		if (isQuote.value) cls = cls + ' rule-dash'
		if (sz.value === 'sm') cls = cls + ' rule-sm'
		return cls
	})
</script>

<style>
	.tpl-cover {
		width: 100%;
		height: 200px;
		position: relative;
		overflow: hidden;
	}
	.tpl-cover-sm {
		width: 112px;
		height: 148px;
		border-radius: 10px;
	}
	.tpl-cover-lg {
		width: 100%;
		height: 248px;
		border-radius: 16px;
	}

	.paper-b {
		position: absolute;
		left: 18px;
		right: 8px;
		top: 18px;
		bottom: 8px;
		border-radius: 14px;
		background-color: rgba(255, 255, 255, 0.42);
		z-index: 0;
	}
