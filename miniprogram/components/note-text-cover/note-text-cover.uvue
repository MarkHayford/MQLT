		font-size: 12px;
		line-height: 17px;
	}
	.ttl-lg {
		font-size: 24px;
		line-height: 34px;
	}
	.ttl-rest {
		width: 100%;
		lines: 3;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	.foot {
		width: 100%;
		align-items: center;
		flex-shrink: 0;
		padding-top: 8px;
		z-index: 3;
	}
	.foot-end { justify-content: flex-end; }
	.rule {
		width: 42px;
		height: 2px;
		border-radius: 1px;
	}
	.rule-dash {
		width: 18px;
		height: 3px;
	}
	.rule-sm {
		width: 22px;
		height: 2px;
	}

	.tpl-sticky { background-color: #F2C45A; }
	.tpl-quote { background-color: #E6E1F5; }
	.tpl-mint { background-color: #8FCFB8; }
	.tpl-peach { background-color: #F3B7A6; }
	.tpl-sky { background-color: #A8C8EA; }
	.tpl-lined { background-color: #D8E3D4; }
	.tpl-letter { background-color: #E2C9A0; }
	.tpl-dusk { background-color: #E0894A; }
	.tpl-forest { background-color: #1A73E8; }

	.qmark-quote { color: #D0C8E8; }
	.qmark-forest { color: rgba(26, 115, 232, 0.35); }

	.hl-sticky { background-color: #93C5FD; }
	.hl-quote { background-color: #E8D56A; }
	.hl-mint { background-color: #F0E08A; }
	.hl-peach { background-color: #C8EBD8; }
	.hl-sky { background-color: #F8D3C0; }
	.hl-lined { background-color: #F0D56A; }
	.hl-letter { background-color: #1A73E8; }
	.hl-dusk { background-color: #FFE7B0; }
	.hl-forest { background-color: #1A73E8; }

	.ttl-head-sticky { color: #1A1A1A; }
	.ttl-head-quote { color: #1A1A1A; }
	.ttl-head-mint { color: #1A1A1A; }
	.ttl-head-peach { color: #1A1A1A; }
	.ttl-head-sky { color: #1A1A1A; }
	.ttl-head-lined { color: #1A1A1A; }
	.ttl-head-letter { color: #1A1A1A; }
	.ttl-head-dusk { color: #1A1A1A; }
	.ttl-head-forest { color: #1A1A1A; }

	.ttl-sticky { color: #1A1A1A; }
	.ttl-quote { color: #1A1A1A; }
	.ttl-mint { color: #1A1A1A; }
	.ttl-peach { color: #1A1A1A; }
	.ttl-sky { color: #1A1A1A; }
	.ttl-lined { color: #1A1A1A; }
	.ttl-letter { color: #1A1A1A; }
	.ttl-dusk { color: #1A1A1A; }
	.ttl-forest { color: #FFFFFF; }

	.rule-sticky { background-color: #E8D7A4; }
	.rule-quote { background-color: #C9C0E0; }
	.rule-mint { background-color: #C5E0D4; }
	.rule-peach { background-color: #F0D0C6; }
	.rule-sky { background-color: #C5D6EA; }
	.rule-lined { background-color: #D4C4A0; }
	.rule-letter { background-color: #1A73E8; }
	.rule-dusk { background-color: #F0C9A0; }
	.rule-forest { background-color: #1A73E8; }
</style>
