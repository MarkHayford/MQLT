<template>
	<view class="scape" :class="toneClass" :style="scapeStyle">
		<image class="scape-liquid" :src="liquidSrc" mode="aspectFill"></image>
		<view class="scape-veil" :class="veilClass"></view>
	</view>
</template>

<script setup lang="uts">
	import { computed } from 'vue'

	const props = defineProps({
		tone: {
			type: String,
			default: 'hero'
		},
		bottomInset: {
			type: Number,
			default: 0
		}
	})
	const scapeStyle = computed((): string => {
		if (props.bottomInset > 0) return 'bottom:' + props.bottomInset + 'px;'
		return ''
	})

	const liquidSrc = computed((): string => {
		if (props.tone === 'mine') return '/static/scape-liquid-mine.png'
		if (props.tone === 'study') return '/static/scape-liquid-study.png'
		return '/static/scape-liquid-hero.png'
	})

	const toneClass = computed((): string => {
		if (props.tone === 'paper') return 'scape-paper'
		if (props.tone === 'field') return 'scape-field'
		if (props.tone === 'crest') return 'scape-crest'
		if (props.tone === 'mine') return 'scape-mine'
		if (props.tone === 'study') return 'scape-study'
		return 'scape-hero'
	})

	const liquidClass = computed((): string => {
		if (props.tone === 'paper') return 'scape-liquid-paper'
		if (props.tone === 'mine') return 'scape-liquid-mine'
		if (props.tone === 'study') return 'scape-liquid-study'
		if (props.tone === 'crest') return 'scape-liquid-crest'
		if (props.tone === 'field') return 'scape-liquid-field'
		return 'scape-liquid-hero'
	})

	const veilClass = computed((): string => {
		if (props.tone === 'paper') return 'scape-veil-off'
		if (props.tone === 'field') return 'scape-veil-field'
		if (props.tone === 'crest') return 'scape-veil-crest'
		if (props.tone === 'mine') return 'scape-veil-mine'
		if (props.tone === 'study') return 'scape-veil-study'
		return 'scape-veil-on'
	})
</script>

<style>
	.scape {
		position: absolute;
		left: 0;
		right: 0;
		top: 0;
		bottom: 0;
		overflow: hidden;
		pointer-events: none;
		z-index: 0;
	}
	.scape-liquid {
		position: absolute;
		top: 0;
		right: 0;
		bottom: 0;
		left: 0;
		width: 100%;
		height: 100%;
	}
	/* Clean liquid: white / #F5F7FB base + very soft blue glow — no muddy gray-blue slabs */
	.scape-liquid-hero {
		background:
			radial-gradient(ellipse at 8% -5%, rgba(26, 115, 232, 0.12) 0%, transparent 52%),
			radial-gradient(ellipse at 92% 18%, rgba(26, 115, 232, 0.08) 0%, transparent 48%),
			radial-gradient(ellipse at 50% 100%, rgba(255, 255, 255, 0.9) 0%, transparent 55%),
			linear-gradient(165deg, #FFFFFF 0%, #F5F7FB 48%, #EEF2F8 100%);
	}
	.scape-liquid-paper {
		background:
			radial-gradient(ellipse at 18% 8%, rgba(26, 115, 232, 0.07) 0%, transparent 50%),
			linear-gradient(160deg, #FFFFFF 0%, #F5F7FB 60%, #F0F3F9 100%);
	}
	.scape-liquid-crest {
		background:
			radial-gradient(ellipse at 12% 0%, rgba(26, 115, 232, 0.10) 0%, transparent 55%),
			radial-gradient(ellipse at 88% 35%, rgba(255, 255, 255, 0.85) 0%, transparent 50%),
			linear-gradient(180deg, #F5F7FB 0%, #FFFFFF 70%, rgba(245, 247, 251, 0) 100%);
	}
	.scape-liquid-mine {
		background:
			radial-gradient(ellipse at 82% 0%, rgba(26, 115, 232, 0.10) 0%, transparent 50%),
			radial-gradient(ellipse at 12% 85%, rgba(26, 115, 232, 0.06) 0%, transparent 55%),
			linear-gradient(160deg, #FFFFFF 0%, #F5F7FB 50%, #EEF2F8 100%);
	}
	.scape-liquid-study {
		background:
			radial-gradient(ellipse at 6% 0%, rgba(26, 115, 232, 0.12) 0%, transparent 52%),
			radial-gradient(ellipse at 100% 18%, rgba(255, 255, 255, 0.8) 0%, transparent 45%),
			linear-gradient(150deg, #FFFFFF 0%, #F5F7FB 45%, #EEF2F8 100%);
	}
	.scape-liquid-field {
		background:
			radial-gradient(ellipse at 50% 0%, rgba(26, 115, 232, 0.08) 0%, transparent 50%),
			linear-gradient(160deg, #FFFFFF 0%, #F5F7FB 100%);
	}
	.scape-hero {
		top: 0;
		bottom: 0;
		opacity: 1;
	}
	.scape-paper {
		left: 0;
		right: 0;
		top: 0;
		bottom: 0;
		opacity: 1;
	}
	.scape-field {
		top: 0;
		bottom: 0;
		opacity: 1;
	}
	.scape-crest {
		top: 0;
		height: 320px;
		opacity: 1;
	}
	.scape-mine {
		top: 0;
		bottom: 0;
		opacity: 1;
	}
	.scape-study {
		top: 0;
		bottom: 0;
		opacity: 1;
	}
	.scape-veil {
		position: absolute;
		top: 0;
		right: 0;
		bottom: 0;
		left: 0;
		background-image: linear-gradient(180deg, rgba(255, 255, 255, 0.15) 0%, rgba(245, 247, 251, 0.35) 100%);
	}
	.scape-veil-on {
		opacity: 0.4;
	}
	.scape-veil-off {
		opacity: 0;
	}
	.scape-veil-field {
		opacity: 0.25;
		background-image: linear-gradient(180deg, rgba(26, 115, 232, 0.04) 0%, rgba(245, 247, 251, 0.2) 100%);
	}
	.scape-veil-crest {
		opacity: 0.55;
		background-image: linear-gradient(180deg, rgba(255, 255, 255, 0.2) 0%, rgba(245, 247, 251, 0.9) 100%);
	}
	.scape-veil-mine {
		opacity: 0.3;
		background-image: linear-gradient(180deg, rgba(26, 115, 232, 0.04) 0%, rgba(245, 247, 251, 0.25) 100%);
	}
	.scape-veil-study {
		opacity: 0.28;
		background-image: linear-gradient(180deg, rgba(26, 115, 232, 0.05) 0%, rgba(245, 247, 251, 0.22) 100%);
	}
</style>
