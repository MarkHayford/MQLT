import { API_BASE_URL } from './api-config.uts'
import { ApiEndpoints } from './api-endpoints.uts'

export function resolveAvatarUrl(value: any): string {
	const raw = value != null ? value.toString().trim() : ''
	if (raw.length === 0) return ''
	if (raw.indexOf('http://') === 0 || raw.indexOf('https://') === 0 || raw.indexOf('wxfile://') === 0 || raw.indexOf('file://') === 0) return raw
	if (raw.charAt(0) === '/') {
		const avatarEndpoint = ApiEndpoints.userAvatar
		const marker = '/user/avatar'
		const markerIndex = avatarEndpoint.indexOf(marker)
		const apiPrefix = markerIndex > 0 ? avatarEndpoint.substring(0, markerIndex) : ''
		if (apiPrefix.length > 0 && raw.indexOf(apiPrefix + '/') !== 0) {
			return API_BASE_URL + apiPrefix + raw
		}
		return API_BASE_URL + raw
	}
	return API_BASE_URL + '/' + raw
}

export function resolveAvatarImageUrl(value: any, version: any = ''): string {
	const url = resolveAvatarUrl(value)
	if (url.length === 0) return ''
	if (url.indexOf('wxfile://') === 0 || url.indexOf('file://') === 0) return url
	const versionText = version != null ? version.toString() : ''
	if (versionText.length === 0) return url
	return url + (url.indexOf('?') >= 0 ? '&' : '?') + 'v=' + encodeURIComponent(versionText)
}
