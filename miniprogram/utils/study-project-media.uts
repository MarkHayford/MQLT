import { API_BASE_URL } from './api-config.uts'
import { ApiEndpoints } from './api-endpoints.uts'

function resolveStudyProjectMediaUrl(value: string): string {
	if (value.indexOf('http://') === 0 || value.indexOf('https://') === 0 || value.indexOf('wxfile://') === 0 || value.indexOf('file://') === 0) return value
	if (value.charAt(0) === '/') {
		const projectsEndpoint = ApiEndpoints.studyProjects
		const marker = '/study/projects'
		const markerIndex = projectsEndpoint.indexOf(marker)
		const apiPrefix = markerIndex > 0 ? projectsEndpoint.substring(0, markerIndex) : ''
		if (apiPrefix.length > 0 && value.indexOf(apiPrefix + '/') !== 0) {
			return API_BASE_URL + apiPrefix + value
		}
		return API_BASE_URL + value
	}
	return API_BASE_URL + '/' + value
}

export function resolveStudyProjectMediaBackground(value: any): string {
	const raw = value != null ? value.toString().trim() : ''
	if (raw.length === 0) return ''
	if (raw.indexOf('linear-gradient(') === 0 || raw.indexOf('radial-gradient(') === 0 || raw.indexOf('url(') === 0) return raw
	return 'url(' + resolveStudyProjectMediaUrl(raw) + ')'
}
