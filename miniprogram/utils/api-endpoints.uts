export function endpointWithId(endpoint: string, id: string): string {
	return endpoint.replace('{id}', id)
}

export function studyProjectDocumentEndpoint(projectId: string, docIndex: string): string {
	return ApiEndpoints.studyProjectDocumentDetail.replace('{id}', projectId).replace('{docIndex}', docIndex)
}

export function puzzlePieceEndpoint(projectId: string, pieceId: string): string {
	return ApiEndpoints.puzzlePieceDetail.replace('{projectId}', projectId).replace('{pieceId}', pieceId)
}

export function puzzleProjectBackpackEndpoint(projectId: string): string {
	return ApiEndpoints.puzzleProjectBackpack.replace('{projectId}', projectId)
}

export function studyExploreSessionEndpoint(projectId: string): string {
	return endpointWithId(ApiEndpoints.studyExploreSession, projectId)
}

export function studyRoutePointCheckInEndpoint(projectId: string, routePointId: string): string {
	return endpointWithId(ApiEndpoints.studyRoutePointCheckIn, projectId).replace('{routePointId}', routePointId)
}

export function studyRoutePointKnowledgeTaskEndpoint(projectId: string, routePointId: string): string {
	return endpointWithId(ApiEndpoints.studyRoutePointKnowledgeTask, projectId).replace('{routePointId}', routePointId)
}

export function studyRoutePointKnowledgeCompleteEndpoint(projectId: string, routePointId: string): string {
	return endpointWithId(ApiEndpoints.studyRoutePointKnowledgeComplete, projectId).replace('{routePointId}', routePointId)
}

export function studyRoutePointStationStepCompleteEndpoint(projectId: string, routePointId: string, stepId: string): string {
	return endpointWithId(ApiEndpoints.studyRoutePointStationStepComplete, projectId).replace('{routePointId}', routePointId).replace('{stepId}', stepId)
}

export function studyRoutePointStationStepGamePlayEndpoint(projectId: string, routePointId: string, stepId: string): string {
	return endpointWithId(ApiEndpoints.studyRoutePointStationStepGamePlay, projectId).replace('{routePointId}', routePointId).replace('{stepId}', stepId)
}

