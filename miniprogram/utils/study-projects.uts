}

export type StudyAiPlanHistoryItem = {
	role: string
	content: string
}

/** 服务端代理 DeepSeek（deepseek-flash）做多日行程规划 */
export function fetchStudyAiPlan(
	projectId: string,
	message: string,
	dayKeys: string[],
	people: number,
	spots: StudyAiPlanSpotInput[],
	history: StudyAiPlanHistoryItem[],
	prefs: any
): Promise<StudyAiPlanResult> {
	return requestApi<StudyAiPlanResult>({
		method: 'POST',
		url: ApiEndpoints.studyAiPlan,
		data: {
			projectId: projectId,
			message: message,
			dayKeys: dayKeys,
			people: people,
			spots: spots,
			history: history,
			prefs: prefs
		},
		requireAuth: true,
		timeoutMs: 60000
	})
}

export function createStudyBooking(projectId: string, travelerIds: string[] = [], rentalOptionId: string = '', rentalFee: number = 0, routePointIds: string[] = [], rentalDriverId: string = '', extra: any = null): Promise<StudyBookingRecord> {
	// 显式字段，避免编译后丢 tripPlan / 租车元数据
	const payload: any = {
		projectId: projectId,
		travelerIds: travelerIds,
		rentalOptionId: rentalOptionId.length > 0 ? rentalOptionId : 'none',
		vehicleType: rentalOptionId.length > 0 ? rentalOptionId : 'none',
		rentalFee: rentalFee,
		rentalDriverId: rentalDriverId,
		routePointIds: routePointIds
	}
	if (extra != null) {
		if (extra.tripPlan != null) payload.tripPlan = extra.tripPlan
		if (extra.pickupAddress != null) payload.pickupAddress = extra.pickupAddress
		if (extra.pickupLatitude != null) {
			payload.pickupLatitude = extra.pickupLatitude
			payload.pickupLat = extra.pickupLatitude
		}
		if (extra.pickupLongitude != null) {
			payload.pickupLongitude = extra.pickupLongitude
			payload.pickupLng = extra.pickupLongitude
		}
		if (extra.rentalDriverName != null) {
			payload.rentalDriverName = extra.rentalDriverName
			payload.driverName = extra.rentalDriverName
		}
		if (extra.rentalDriverPhone != null) {
			payload.rentalDriverPhone = extra.rentalDriverPhone
			payload.driverPhone = extra.rentalDriverPhone
		}
		if (extra.rentalDriverWechat != null) {
			payload.rentalDriverWechat = extra.rentalDriverWechat
			payload.driverWechat = extra.rentalDriverWechat
		}
		if (extra.rentalVehicleName != null) {
			payload.rentalVehicleName = extra.rentalVehicleName
			payload.vehicleName = extra.rentalVehicleName
		}
		if (extra.rentalPlateNo != null) {
			payload.rentalPlateNo = extra.rentalPlateNo
			payload.plateNo = extra.rentalPlateNo
		}
	}
	// 无 tripPlan 时用 routePointIds 兜底成单日行程，后端也能识别
	if (payload.tripPlan == null && routePointIds.length > 0) {
		payload.tripPlan = {
			dayKeys: ['day1'],
			days: [{ dayKey: 'day1', spotIds: routePointIds }]
		}
	}
	return postApi<StudyBookingRecord>(ApiEndpoints.studyBookings, payload, true)
}

