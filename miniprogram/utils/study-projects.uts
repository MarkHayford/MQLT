/** 查询当前可约司机：人数区间车型 + 定位所在城市 */
export function fetchRentalDrivers(params: any): Promise<RentalDriversResult> {
	const vehicleType = params != null && params['vehicleType'] != null ? params['vehicleType'].toString() : 'van7'
	const pickupLat = params != null && params['pickupLat'] != null ? Number(params['pickupLat']) : 0
	const pickupLng = params != null && params['pickupLng'] != null ? Number(params['pickupLng']) : 0
	const projectId = params != null && params['projectId'] != null ? params['projectId'].toString() : ''
	const date = params != null && params['date'] != null ? params['date'].toString() : ''
	const city = params != null && params['city'] != null ? params['city'].toString() : ''
	let url = ApiEndpoints.studyRentalDrivers + '?vehicleType=' + encodeURIComponent(vehicleType)
	if (pickupLat != 0 && pickupLng != 0) {
		url = url + '&pickupLat=' + encodeURIComponent(pickupLat.toFixed(6)) + '&pickupLng=' + encodeURIComponent(pickupLng.toFixed(6))
	}
	if (projectId.length > 0) url = url + '&projectId=' + encodeURIComponent(projectId)
	if (date.length > 0) url = url + '&date=' + encodeURIComponent(date)
	if (city.length > 0) url = url + '&city=' + encodeURIComponent(city)
	return getApi<RentalDriversResult>(url, true)
}



