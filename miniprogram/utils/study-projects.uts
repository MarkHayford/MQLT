export function fetchProjectSchedule(id: string, from: string = "", to: string = ""): Promise<any> {
	const parts: string[] = []
	if (from.length > 0) parts.push("from=" + encodeURIComponent(from))
	if (to.length > 0) parts.push("to=" + encodeURIComponent(to))
	const q = parts.length > 0 ? ("?" + parts.join("&")) : ""
	return getApi<any>("/study/projects/" + encodeURIComponent(id) + "/schedule" + q, false)
}
