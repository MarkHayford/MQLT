export function fetchStudyExploreSession(projectId: string, lat: number = 0, lng: number = 0, activePointId: string = '', bookingId: string = ''): Promise<any> {
	let url = studyExploreSessionEndpoint(projectId) + '?'
	if (lat != 0) url += 'lat=' + encodeURIComponent('' + lat) + '&'
	if (lng != 0) url += 'lng=' + encodeURIComponent('' + lng) + '&'
	if (activePointId.length > 0) url += 'activePointId=' + encodeURIComponent(activePointId) + '&'
	if (bookingId.length > 0) url += 'bookingId=' + encodeURIComponent(bookingId) + '&'
	return getApi<any>(url, true)
}

