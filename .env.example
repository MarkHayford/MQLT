NODE_ENV=production
HOST=0.0.0.0
PORT=3000
API_PREFIX=/v1
PUBLIC_API_PREFIX=/api/v1
TZ=UTC

POSTGRES_USER=mqlt
POSTGRES_DB=mqlt
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=postgres
PG_PORT=5432

REDIS_HOST=redis
REDIS_PORT=6379

MQLT_RUN_MIGRATIONS=1
MQLT_RUN_SQL_OVERLAY=1

CORS_ORIGINS=http://127.0.0.1:8080,http://localhost:5173
CDN_BASE_URL=http://127.0.0.1:8080
MEDIA_BASE_URL=http://127.0.0.1:8080

JWT_SECRET=change-me
JWT_EXPIRES_IN=7d
ADMIN_TOKEN=change-me

WECHAT_APP_ID=
WECHAT_APP_SECRET=
AMAP_WEB_SERVICE_KEY=

DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_API_KEY=

S3_ENDPOINT=https://s3.example.com
S3_REGION=ap-northeast-1
S3_BUCKET=your-bucket
S3_FORCE_PATH_STYLE=true
S3_KEY_PREFIX=public/mqlt
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
UPLOAD_PRESIGN_EXPIRES=900
